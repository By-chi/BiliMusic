[gd_scene format=3 uid="uid://dvyo51okdc5gl"]

[sub_resource type="GDScript" id="GDScript_kfv4f"]
script/source = "extends Control

@export var polygon_2d: Polygon2D
@export var polygon_2d2: Polygon2D
@export var texture_rect: TextureRect
@export var lyric_label: Label

@export var smoothness: int = 8
@export var scroll_speed: float = 10.0
@export var scroll_speed2: float = 14.0
@export var amplitude_smooth_factor: float = 15.0
@export var wave_bands: int = 32

@export var default_color1: Color = Color.BLACK
@export var default_color2: Color = Color.LIGHT_SLATE_GRAY
@export var wave_amplitude_scale: float = 1.0
@export var wave_base_offset: float = 0.8
@export var wave_alpha: float = 1.0
@export var mirror_second_wave: bool = false
@export var shake_sensitivity: float = 0.001
@export var shake_max_pixels: float = 30.0

@export var lyric_font_size: int = 36
@export var lyric_offset: Vector2 = Vector2.ZERO
@export var show_lyric_on_pause: bool = false

@export var lyric_float_amplitude: Vector2 = Vector2(18, 4)
@export var lyric_float_rotation_deg: float = 2.0
@export var lyric_float_cycle_duration: float = 6.0

var bottomMenu: Panel

var _smoothed_amplitudes: PackedFloat32Array
var _start_time: int
var is_ECO_mode := false

var _lyric_times: Array[float] = []
var _lyric_texts: Array[String] = []
var _lyric_index: int = -1
var _last_lyric_data = null

var _lyric_float_tween: Tween
var _lyric_float_offset: Vector2 = Vector2.ZERO
var _lyric_float_rotation: float = 0.0

var _lyric_enter_tween: Tween
var _lyric_enter_animating: bool = false


func _ready() -> void:
	_smoothed_amplitudes.resize(wave_bands)
	_smoothed_amplitudes.fill(0.0)
	_start_time = Time.get_ticks_usec()

	if lyric_label:
		lyric_label.add_theme_font_size_override(\"font_size\", lyric_font_size)
		lyric_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		lyric_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		lyric_label.visible = false

	_setup_lyric_float_animation()

	# 监听切歌信号：彻底清除残留
	Player.song_changed.connect(func(_video_info: Dictionary):
		_last_lyric_data = null
		_lyric_times.clear()
		_lyric_texts.clear()
		_lyric_index = -1
		if lyric_label:
			lyric_label.text = \"\"          # 清空文本，杜绝残留
			lyric_label.visible = false
		update()
	)


func _setup_lyric_float_animation() -> void:
	if not lyric_label:
		return
	_lyric_float_tween = create_tween()
	_lyric_float_tween.set_loops()
	_lyric_float_tween.tween_method(
		_update_lyric_float_offset,
		0.0, TAU,
		lyric_float_cycle_duration
	).set_trans(Tween.TRANS_LINEAR)
	_lyric_float_tween.play()


func _update_lyric_float_offset(angle: float) -> void:
	_lyric_float_offset = Vector2(
		sin(angle) * lyric_float_amplitude.x,
		sin(angle * 1.3) * lyric_float_amplitude.y
	)
	_lyric_float_rotation = sin(angle * 0.7) * deg_to_rad(lyric_float_rotation_deg)


func update() -> void:
	if is_ECO_mode or not Player.sonance:
		return

	var video_info := Player.get_current_video_info()
	if video_info.is_empty():
		return

	if bottomMenu and bottomMenu.cover:
		_set_texture(\"\", bottomMenu.cover)

	if video_info.get(\"is_network\", true):
		BilibiliIc.fetch_cover(video_info.link, _set_texture, 1600, 1000)
	elif FileAccess.file_exists(video_info.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video_info.link.get_basename() + \".jpg\")
		_set_texture(\"\", ImageTexture.create_from_image(image))
	else:
		GdScriptFunc.generate_label_texture(
			Color.WHITE,
			video_info.get(\"title\", tr(\"本地文件\")),
			func(tex: Texture2D): _set_texture(\"\", tex),
			null, 10, Color.BLACK, Vector2i(70, 70)
		)

	_load_lyrics(video_info)


func _set_texture(_bvid: String, tex: Texture2D) -> void:
	if texture_rect:
		texture_rect.texture = tex
	_apply_theme_colors()


func Start() -> void:
	if not lyric_label or _lyric_enter_animating:
		return

	_lyric_enter_animating = true
	lyric_label.modulate.a = 0.0
	lyric_label.scale = Vector2.ZERO
	lyric_label.visible = true

	_lyric_float_offset = Vector2.ZERO
	_lyric_float_rotation = 0.0

	_lyric_enter_tween = create_tween()
	_lyric_enter_tween.set_parallel(true)
	_lyric_enter_tween.tween_property(lyric_label, \"modulate:a\", 1.0, 0.3) \\
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	_lyric_enter_tween.tween_property(lyric_label, \"scale\", Vector2.ONE, 0.4) \\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	_lyric_enter_tween.finished.connect(_on_lyric_enter_finished, CONNECT_ONE_SHOT)


func _on_lyric_enter_finished() -> void:
	_lyric_enter_animating = false
	_lyric_enter_tween = null


func _apply_theme_colors() -> void:
	if not texture_rect or not texture_rect.texture:
		polygon_2d.color = default_color1
		polygon_2d2.color = default_color2
	else:
		var img := texture_rect.texture.get_image()
		if img:
			var colors: Array[Color] = CSharpFunc.ExtractThemeColors(img, 2, true, 0.15)
			if colors.size() >= 2:
				polygon_2d.color = colors[0]
				polygon_2d2.color = colors[1]
			else:
				polygon_2d.color = default_color1
				polygon_2d2.color = default_color2
		else:
			polygon_2d.color = default_color1
			polygon_2d2.color = default_color2

	_update_lyric_color()


func _update_lyric_color() -> void:
	if not lyric_label:
		return
	var c := polygon_2d.color
	var luminance := 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
	var gray := Color.WHITE if luminance < 0.5 else Color.BLACK
	gray.a = 1.0
	lyric_label.add_theme_color_override(\"font_color\", gray)


func _process(delta: float) -> void:
	if not Player.sonance:
		if not is_ECO_mode:
			set_ECO_mode(true)
		return
	else:
		if is_ECO_mode:
			set_ECO_mode(false)

	if is_ECO_mode:
		return

	var max_height: float = max(size.x * 2.0, 10.0)
	var raw: PackedFloat32Array = AudioSpectrumCalculator.Update(delta, true, max_height)
	var heights: PackedFloat32Array
	if wave_bands == AudioSpectrumCalculator.lineCount:
		heights = raw
	else:
		heights = _resample_array(raw, wave_bands)

	if heights.size() > 0:
		heights[0] = 0.0
		heights[heights.size() - 1] = 0.0

	for i in heights.size():
		heights[i] *= wave_amplitude_scale

	var alpha := 1.0 - exp(-delta * amplitude_smooth_factor)
	for i in heights.size():
		_smoothed_amplitudes[i] = lerpf(_smoothed_amplitudes[i], heights[i], alpha)

	var shake := clampf(_get_overall_volume() * shake_sensitivity * 0.01, 0.0, shake_max_pixels)
	var base_y := size.y * wave_base_offset - shake
	var t := (Time.get_ticks_usec() - _start_time) / 1_000_000.0

	var offset2 := t * scroll_speed2
	if mirror_second_wave:
		offset2 = -offset2

	polygon_2d.polygon = _generate_wave(_smoothed_amplitudes, t * scroll_speed, base_y)
	polygon_2d2.polygon = _generate_wave(_smoothed_amplitudes, offset2, base_y)

	polygon_2d.color.a = wave_alpha
	polygon_2d2.color.a = wave_alpha

	if lyric_label and Player.sonance:
		_update_lyric()


func set_ECO_mode(value: bool) -> void:
	if is_ECO_mode == value:
		return

	is_ECO_mode = value

	if value:
		_enter_eco_mode()
	else:
		_exit_eco_mode()


func _enter_eco_mode() -> void:
	_pause_all_tweens()
	# 暂停时不再隐藏歌词


func _exit_eco_mode() -> void:
	_resume_all_tweens()


func _pause_all_tweens() -> void:
	if _lyric_float_tween and _lyric_float_tween.is_valid() and _lyric_float_tween.is_running():
		_lyric_float_tween.pause()
	if _lyric_enter_tween and _lyric_enter_tween.is_valid() and _lyric_enter_tween.is_running():
		_lyric_enter_tween.pause()


func _resume_all_tweens() -> void:
	if _lyric_float_tween and _lyric_float_tween.is_valid():
		if not _lyric_float_tween.is_running():
			_lyric_float_tween.play()
	if _lyric_enter_tween and _lyric_enter_tween.is_valid():
		if not _lyric_enter_tween.is_running():
			_lyric_enter_tween.play()


func _get_overall_volume() -> float:
	var e = AudioSpectrumCalculator.Update(0.0, true, 1000.0)
	if e == null or e.size() == 0:
		return 0.0
	return e[0] * AudioSpectrumCalculator.spectrumScale


func _resample_array(src: PackedFloat32Array, target: int) -> PackedFloat32Array:
	if src.size() == target:
		return src
	var res := PackedFloat32Array()
	res.resize(target)
	for i in target:
		var fi := float(i) / float(target - 1) * float(src.size() - 1)
		var i0 := int(fi)
		var i1 := mini(i0 + 1, src.size() - 1)
		var frac := fi - float(i0)
		res[i] = lerpf(src[i0], src[i1], frac)
	return res


func _generate_wave(amps: PackedFloat32Array, offset: float, base_y: float) -> PackedVector2Array:
	var n := amps.size()
	if n < 2:
		return PackedVector2Array()
	var step_x := size.x / float(n - 1)
	var smooth_count := (n - 1) * smoothness + 1
	var smooth_step := size.x / float(smooth_count - 1)
	var top := PackedVector2Array()
	for j in smooth_count:
		var x := j * smooth_step
		var px := fmod(x + offset, size.x)
		if px < 0: px += size.x
		var i := int(px / step_x)
		if i >= n - 1: i = n - 2
		var t := (px - i * step_x) / step_x
		var y0 := _cycle_amp(amps, i - 1)
		var y1 := _cycle_amp(amps, i)
		var y2 := _cycle_amp(amps, i + 1)
		var y3 := _cycle_amp(amps, i + 2)
		top.append(Vector2(x, base_y - _catmull(y0, y1, y2, y3, t)))
	var poly := PackedVector2Array()
	for p in top:
		poly.append(Vector2(p.x, size.y + 3))
	for i in range(top.size() - 1, -1, -1):
		poly.append(top[i])
	return poly


func _cycle_amp(a: PackedFloat32Array, idx: int) -> float:
	var p := a.size() - 1
	var m := idx % p
	if m < 0: m += p
	return a[m]


func _catmull(y0: float, y1: float, y2: float, y3: float, t: float) -> float:
	var t2 := t * t
	var t3 := t2 * t
	return 0.5 * (2.0*y1 + (-y0 + y2)*t + (2.0*y0 - 5.0*y1 + 4.0*y2 - y3)*t2 + (-y0 + 3.0*y1 - 3.0*y2 + y3)*t3)


func _load_lyrics(video_info: Dictionary) -> void:
	var subtitles = video_info.get(\"subtitles\", null)
	if subtitles != null and not (subtitles is Array and subtitles.is_empty()) and not (subtitles is String and subtitles.strip_edges() == \"\"):
		_last_lyric_data = subtitles
		var new_times: Array[float] = []
		var new_texts: Array[String] = []
		_parse_subtitle_data(subtitles, new_times, new_texts)
		_apply_lyrics(new_times, new_texts)
		return

	if video_info.get(\"is_network\", true) and GdScriptFunc.get_data(\"Options\", \"Automatically_obtain_subtitles\", false):
		var requested_bvid = video_info.get(\"BV\", video_info.get(\"link\"))
		BilibiliIc.fetch_subtitle_auto(requested_bvid, func(subtitle_data: Dictionary):
			var current_info := Player.get_current_video_info()
			if current_info.is_empty() or current_info.get(\"BV\", current_info.get(\"link\")) != requested_bvid:
				return
			if subtitle_data.is_empty() or (not subtitle_data.has(\"body\") and not subtitle_data.has(\"path\")):
				_lyric_times.clear()
				_lyric_texts.clear()
				if lyric_label:
					lyric_label.text = \"\"
					lyric_label.visible = false
			else:
				var new_times: Array[float] = []
				var new_texts: Array[String] = []
				if subtitle_data.has(\"path\"):
					var file := FileAccess.open(subtitle_data[\"path\"], FileAccess.READ)
					if file:
						var lrc_text := file.get_as_text()
						file.close()
						_parse_lrc(lrc_text, new_times, new_texts)
				else:
					var body = subtitle_data[\"body\"]
					if body is Array:
						for entry in body:
							new_times.append(entry.get(\"from\", 0.0))
							new_texts.append(entry.get(\"content\", \"\"))
				_apply_lyrics(new_times, new_texts)
		)
	else:
		_lyric_times.clear()
		_lyric_texts.clear()
		if lyric_label:
			lyric_label.text = \"\"
			lyric_label.visible = false
		_last_lyric_data = null


func _parse_subtitle_data(subtitles, out_times: Array, out_texts: Array) -> void:
	if subtitles is String:
		var file := FileAccess.open(subtitles, FileAccess.READ)
		if file:
			var lrc_text := file.get_as_text()
			file.close()
			_parse_lrc(lrc_text, out_times, out_texts)
		else:
			_parse_lrc(subtitles, out_times, out_texts)
	elif subtitles is Dictionary:
		var path = subtitles.get(\"path\", \"\")
		if path != \"\":
			var file := FileAccess.open(path, FileAccess.READ)
			if file:
				var lrc_text := file.get_as_text()
				file.close()
				_parse_lrc(lrc_text, out_times, out_texts)
		else:
			var body = subtitles.get(\"body\", [])
			if body is Array:
				for entry in body:
					out_times.append(entry.get(\"from\", 0.0))
					out_texts.append(entry.get(\"content\", \"\"))
	elif subtitles is Array:
		for entry in subtitles:
			out_times.append(entry.get(\"from\", 0.0))
			out_texts.append(entry.get(\"content\", \"\"))


func _apply_lyrics(times: Array, texts: Array) -> void:
	if texts.is_empty():
		if lyric_label:
			lyric_label.text = \"\"
			lyric_label.visible = false
		_lyric_times.clear()
		_lyric_texts.clear()
		return
	_lyric_times = times
	_lyric_texts = texts
	_lyric_index = -1
	if lyric_label:
		lyric_label.visible = true


func _parse_lrc(lrc_text: String, out_times: Array, out_texts: Array) -> void:
	var lines = lrc_text.split(\"\\n\")
	var regex = RegEx.new()
	regex.compile(\"\\\\[(\\\\d{1,3}):(\\\\d{2})(?:\\\\.(\\\\d{2,3}))?\\\\]\")
	for line in lines:
		line = line.strip_edges()
		if line.is_empty(): continue
		var matches = regex.search_all(line)
		if matches.is_empty(): continue
		var times: Array[float] = []
		for match in matches:
			var mins = match.get_string(1).to_int()
			var secs = match.get_string(2).to_int()
			var ms_str = match.get_string(3)
			var ms = 0.0
			if ms_str != \"\":
				ms = ms_str.to_float() / pow(10, ms_str.length())
			times.append(mins * 60.0 + secs + ms)
		var last_end = matches[-1].get_end()
		var content = line.substr(last_end).strip_edges()
		if content.begins_with(\"♪\") and content.ends_with(\"♪\"):
			content = content.substr(1, content.length() - 2)
		content = content.strip_edges()
		if content == \"音乐\" or content == \"music\": content = \"\"
		if content != \"\": content = _capitalize_line(content)
		for t in times:
			out_times.append(t)
			out_texts.append(content)
	if out_times.size() > 0:
		var sorted = []
		for i in out_times.size():
			sorted.append({\"t\": out_times[i], \"c\": out_texts[i]})
		sorted.sort_custom(func(a, b): return a.t < b.t)
		out_times.clear()
		out_texts.clear()
		for e in sorted:
			out_times.append(e.t)
			out_texts.append(e.c)


func _capitalize_line(text: String) -> String:
	if text.is_empty(): return text
	var words = text.split(\" \")
	for i in words.size():
		if words[i] == \"i\": words[i] = \"I\"
	var result = \" \".join(words)
	if result.length() > 0:
		result = result[0].to_upper() + result.substr(1)
	return result


func _update_lyric() -> void:
	if not lyric_label or _lyric_times.is_empty():
		# 没有歌词时彻底清空
		if lyric_label:
			lyric_label.text = \"\"
			lyric_label.visible = false
		return

	var pos = Player.get_current_time_sec()
	var idx = -1
	for i in _lyric_times.size():
		if _lyric_times[i] <= pos:
			idx = i
		else:
			break
	if idx != _lyric_index:
		_lyric_index = idx
		if idx >= 0 and idx < _lyric_texts.size():
			lyric_label.text = _lyric_texts[idx]
			lyric_label.visible = true
		else:
			lyric_label.text = \"\"
			lyric_label.visible = false
	if lyric_label.visible:
		lyric_label.offset_transform_position = _lyric_float_offset
		lyric_label.offset_transform_rotation = _lyric_float_rotation
"

