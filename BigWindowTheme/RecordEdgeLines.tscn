[sub_resource type="GDScript" id="GDScript_snpjp"]
script/source = "extends Control

@export var coverTextureRect: TextureRect
@export var coverNode: Panel
@export var edgeNode: Panel
@export var musicNameLabel: Label
@export var coverTextureRectRotateSpeed := 0.2
@export var BackgroundFlow: ColorRect
@export var Subtitle: Control
@export var Background: TextureRect
@export var extra_spacing: float = 30.0
@export var OnecShowLyricLineCount: int = 7
@export var FocusLyricLinePosition: int = 3
@export var LyricTime: Array[float] = []
@export var Lyric: Array[String] = []
@export var index: int = 0
@export var LyricOffset: float = 0
@export var LyricPositionXOffset: float = 0.0
@export var LineSpacing: float = 100
@export var LyricRotationDegree: float = 0.3
@export var highlight_font_scale: float = 1.4
@export var normal_font_size: int = 40
@export var music_name_cycle_duration: float = 6
@export var music_name_freq_x: float = 1
@export var music_name_freq_y: float = 2
@export var music_name_freq_rot: float = 1

var bottomMenu: Panel
var subject_color := Color.WHITE

# 固定大小的标签池，数量 = OnecShowLyricLineCount + 4
var _label_pool: Array[Label] = []
# 记录每个标签当前绑定的行号，-1表示空闲
var _label_line_map: Dictionary = {} # Label -> int

var _is_animating: bool = false
var _enter_tween: Tween
var _saved_index: int = 0

var tween_music_name: Tween
var _music_name_initial_pos: Vector2

var line_nodes: Array[MeshInstance2D]

func _ready() -> void:
	_music_name_initial_pos = musicNameLabel.position
	tween_music_name = musicNameLabel.create_tween()
	tween_music_name.set_loops()
	tween_music_name.tween_method(music_name_update_offset, 0.0, TAU, music_name_cycle_duration) \\
		.set_trans(Tween.TRANS_LINEAR)

	Player.seeked.connect(set_stream_position)
	Player.song_changed.connect(func(_video_info: Dictionary):
		# 切歌时立即清理旧歌词，避免残留
		Subtitle.hide()
		LyricTime.clear()
		Lyric.clear()
		index = 0
		last_highlight_index = -1
		# 重新触发字幕加载
		update()
		# 最后设置进度
		set_stream_position(0.01)
	)

	generate_lines()
	update()

func generate_lines() -> void:
	line_nodes.clear()
	var o := edgeNode.size / 2
	var line_count: int = AudioSpectrumCalculator.lineCount
	for i in line_count:
		var a := TAU * (i / float(line_count))
		var pos := o + o.x * Vector2(cos(a), sin(a))
		var line := MeshInstance2D.new()
		line.mesh = CapsuleMesh.new()
		line.mesh.radius = 4
		line.rotation = a + PI / 2
		line.position = pos
		line.show_behind_parent = true
		edgeNode.add_child(line)
		line_nodes.append(line)

func music_name_update_offset(angle: float) -> void:
	musicNameLabel.position = _music_name_initial_pos + Vector2(
		sin(angle * music_name_freq_x) * 18.0,
		sin(angle * music_name_freq_y) * 4.0
	)
	musicNameLabel.rotation = sin(angle * music_name_freq_rot) * deg_to_rad(2.0)

func _process(delta: float) -> void:
	var max_height := edgeNode.size.x * 2.0
	var heights: PackedFloat32Array = AudioSpectrumCalculator.Update(delta, Player.sonance, max_height)
	for i in heights.size():
		line_nodes[i].mesh.height = heights[i]

	if Player.sonance:
		coverNode.rotation += delta * coverTextureRectRotateSpeed
		edgeNode.rotation = coverNode.rotation
		if not tween_music_name.is_running():
			tween_music_name.play()
	else:
		if tween_music_name.is_running():
			tween_music_name.pause()

	if Subtitle.visible:
		_refresh_lyrics()


func update() -> void:
	Subtitle.hide()
	var video_info := Player.get_current_video_info()
	if video_info.is_empty():
		return
	if video_info.get(\"is_network\", true):
		BilibiliIc.fetch_cover(video_info.link, set_cover, 1600, 1000)
	elif FileAccess.file_exists(video_info.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video_info.link.get_basename() + \".jpg\")
		_set_cover(ImageTexture.create_from_image(image))
	else:
		GdScriptFunc.generate_label_texture(Color.WHITE, video_info.get(\"title\", tr(\"本地文件\")), _set_cover, null, 10, Color.BLACK, Vector2i(70, 70))

	if video_info.has(\"subtitles\"):
		var subtitles = video_info[\"subtitles\"]
		if subtitles == null or subtitles.is_empty():
			Subtitle.hide()
		else:
			Subtitle.show()
			if subtitles is String:
				var file := FileAccess.open(subtitles, FileAccess.READ)
				if file:
					var lrc_text := file.get_as_text()
					file.close()
					init_lyrics_from_data(lrc_text)
				elif subtitles.strip_edges() != \"\":
					init_lyrics_from_data(subtitles)
				else:
					Subtitle.hide()
			elif subtitles is Dictionary:
				var file := FileAccess.open(subtitles[\"path\"], FileAccess.READ)
				if file:
					var lrc_text := file.get_as_text()
					file.close()
					init_lyrics_from_data(lrc_text)
				else:
					Subtitle.hide()
			else:
				Subtitle.hide()
	elif video_info.get(\"is_network\", true) && GdScriptFunc.get_data(\"Options\", \"Automatically_obtain_subtitles\", false):
		var requested_bvid = video_info.get(\"BV\", video_info.get(\"link\"))
		BilibiliIc.fetch_subtitle_auto(requested_bvid, func(subtitle_data: Dictionary):
			var current_info := Player.get_current_video_info()
			if current_info.is_empty() or current_info.get(\"BV\", current_info.get(\"link\")) != requested_bvid:
				return
			if subtitle_data.is_empty() || (!subtitle_data.has(\"body\") && !subtitle_data.has(\"path\")):
				Subtitle.hide()
				print(\"字幕数据为空或格式无效\")
			else:
				Subtitle.show()
				if subtitle_data.has(\"path\"):
					var file := FileAccess.open(subtitle_data[\"path\"], FileAccess.READ)
					if file:
						var lrc_text := file.get_as_text()
						file.close()
						init_lyrics_from_data(lrc_text)
					else:
						Subtitle.hide()
				else:
					init_lyrics_from_data(subtitle_data[\"body\"])
		)
	else:
		Subtitle.hide()

	if bottomMenu and bottomMenu.cover:
		coverTextureRect.texture = bottomMenu.cover
	if not coverTextureRect.texture:
		musicNameLabel.text = CSharpFunc.ExtractSongName(video_info.get(\"title\", tr(\"未知\")))
		return

	var color: Color = CSharpFunc.ExtractThemeColors(coverTextureRect.texture.get_image(), 1, true, 0.15)[0]
	if color.get_luminance() < 0.75:
		musicNameLabel.modulate = color.blend(Color(1, 1, 1, 0.9))
	else:
		musicNameLabel.modulate = color
	musicNameLabel.text = CSharpFunc.ExtractSongName(video_info.get(\"title\", tr(\"未知\")))

var _blur_task_id := 0

func set_cover(_bvid: String, texture: Texture2D) -> void:
	_blur_task_id += 1
	var current_task_id := _blur_task_id
	coverTextureRect.texture = texture
	var img: ImageTexture = texture.duplicate_deep()
	Background.texture = img
	BackgroundFlow.material.set_shader_parameter(\"blur_texture\", img)
	await get_tree().process_frame
	for i in 100:
		if _blur_task_id != current_task_id:
			return
		img = await GdScriptFunc.create_frosted_texture_async(img, 16)
		await get_tree().process_frame
		if _blur_task_id != current_task_id:
			return
		Background.texture = img
		BackgroundFlow.material.set_shader_parameter(\"blur_texture\", img)
		await get_tree().process_frame

func _set_cover(texture: Texture2D) -> void:
	set_cover(\"\", texture)

func _parse_lrc(lrc_text: String) -> void:
	Lyric.clear()
	LyricTime.clear()
	index = 0

	var lines := lrc_text.split(\"\\n\")
	for line in lines:
		line = line.strip_edges()
		if line.is_empty():
			continue
		var regex := RegEx.new()
		regex.compile(\"\\\\[(\\\\d{1,3}):(\\\\d{2})(?:\\\\.(\\\\d{2,3}))?\\\\]\")
		var matches := regex.search_all(line)
		if matches.is_empty():
			continue

		var times := []
		for match in matches:
			var mins := match.get_string(1).to_int()
			var secs := match.get_string(2).to_int()
			var ms_str := match.get_string(3)
			var ms := 0.0
			if not ms_str.is_empty():
				ms = ms_str.to_float() / (10 ** ms_str.length())
			var total_secs := mins * 60.0 + secs + ms
			times.append(total_secs)

		var last_tag_end := matches[-1].get_end()
		var content := line.substr(last_tag_end).strip_edges()

		if content.begins_with(\"♪\") and content.ends_with(\"♪\"):
			content = content.substr(1, content.length() - 2)
		content = content.strip_edges()
		if content == \"音乐\" or content == \"music\":
			content = \"\"
		else:
			content = capitalize_line(content)

		for time in times:
			LyricTime.append(time)
			Lyric.append(content)

	if LyricTime.size() > 0:
		var sorted_data := []
		for i in range(LyricTime.size()):
			sorted_data.append({\"time\": LyricTime[i], \"text\": Lyric[i]})
		sorted_data.sort_custom(func(a, b): return a[\"time\"] < b[\"time\"])
		LyricTime.clear()
		Lyric.clear()
		for entry in sorted_data:
			LyricTime.append(entry[\"time\"])
			Lyric.append(entry[\"text\"])

var last_highlight_index: int = -1
var _last_subtitle_data: Variant = null

func init_lyrics_from_data(data: Variant) -> void:
	if typeof(data) == typeof(_last_subtitle_data) and data == _last_subtitle_data:
		return
	if data is Array:
		_last_subtitle_data = data.duplicate(true)
	elif data is String:
		_last_subtitle_data = data
	else:
		return

	var new_times: Array[float] = []
	var new_texts: Array[String] = []

	if data is String:
		_parse_lrc(data)
		new_times = LyricTime.duplicate()
		new_texts = Lyric.duplicate()
	else:
		for entry in data:
			var time: float = entry.get(\"from\", 0.0)
			var content: String = entry.get(\"content\", \"\")
			if content.begins_with(\"♪\") and content.ends_with(\"♪\"):
				content = content.substr(1, content.length() - 2)
			content = content.strip_edges()
			if content == \"音乐\" or content == \"music\":
				content = \"\"
			else:
				content = capitalize_line(content)
			new_times.append(time)
			new_texts.append(content)

	if new_texts.is_empty():
		return

	# 清除旧的标签池（立即从父节点移除，杜绝残留帧）
	for lbl in _label_pool:
		if is_instance_valid(lbl):
			lbl.get_parent().remove_child(lbl)
			lbl.queue_free()
	_label_pool.clear()
	_label_line_map.clear()

	LyricTime = new_times
	Lyric = new_texts
	index = 0
	last_highlight_index = -1

	# 创建固定大小的标签池（数量 = OnecShowLyricLineCount + 4）
	var pool_size := OnecShowLyricLineCount + 4
	var hide_y := float(OnecShowLyricLineCount + 1) * LineSpacing + 2 * extra_spacing
	for i in pool_size:
		var lbl := Label.new()
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		lbl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		lbl.size.x = Subtitle.size.x
		lbl.position = Vector2(LyricPositionXOffset, hide_y)
		lbl.add_theme_font_size_override(\"font_size\", normal_font_size)
		lbl.add_theme_color_override(\"font_color\", Color.WHITE)
		lbl.add_theme_color_override(\"font_outline_color\", Color.WHITE)
		lbl.add_theme_constant_override(\"line_spacing\", -20)
		lbl.add_theme_constant_override(\"outline_size\", 3)
		lbl.set_anchors_and_offsets_preset(
			Control.PRESET_TOP_WIDE,
			Control.PRESET_MODE_KEEP_SIZE
		)
		Subtitle.add_child(lbl)
		_label_pool.append(lbl)
		_label_line_map[lbl] = -1

	Start()

func _get_current_window_start() -> int:
	return index - FocusLyricLinePosition

# 为指定行分配一个空闲标签，或复用最远的标签
func _assign_label_to_line(line_idx: int) -> Label:
	# 先检查是否已有标签分配给了这一行
	for lbl in _label_pool:
		if _label_line_map[lbl] == line_idx:
			return lbl

	# 寻找空闲标签（行号为-1）
	for lbl in _label_pool:
		if _label_line_map[lbl] == -1:
			_label_line_map[lbl] = line_idx
			lbl.text = Lyric[line_idx] if Lyric[line_idx].strip_edges() != \"\" else \" \"
			lbl.visible = false
			return lbl

	# 所有标签都在使用，找出距离当前窗口最远的标签，释放它
	var window_start := _get_current_window_start()
	var max_dist := -1
	var lbl_to_reuse: Label = null
	for lbl in _label_pool:
		var assigned_line :int= _label_line_map[lbl]
		if assigned_line < 0 or assigned_line >= Lyric.size():
			continue
		var dist :int= abs(assigned_line - window_start)
		if dist > max_dist:
			max_dist = dist
			lbl_to_reuse = lbl
	if lbl_to_reuse:
		_label_line_map[lbl_to_reuse] = line_idx
		lbl_to_reuse.text = Lyric[line_idx] if Lyric[line_idx].strip_edges() != \"\" else \" \"
		lbl_to_reuse.visible = false
		return lbl_to_reuse

	# 保底返回最后一个标签（理论上不会执行）
	return _label_pool[0]

func _refresh_lyrics() -> void:
	if _is_animating:
		return

	var pos := Player.get_current_time_sec()
	while index < LyricTime.size() and pos + LyricOffset > LyricTime[index]:
		index += 1

	var new_hl := index - 1
	# 高亮切换
	if new_hl != last_highlight_index:
		# 取消旧高亮
		if last_highlight_index >= 0:
			for lbl in _label_pool:
				if _label_line_map[lbl] == last_highlight_index and lbl.visible:
					lbl.modulate = Color.DIM_GRAY
					lbl.offset_transform_scale = Vector2.ONE
		# 设置新高亮
		if new_hl >= 0:
			for lbl in _label_pool:
				if _label_line_map[lbl] == new_hl and lbl.visible:
					lbl.modulate = subject_color
					lbl.offset_transform_scale = Vector2.ONE * highlight_font_scale
		last_highlight_index = new_hl

	var window_start: int = _get_current_window_start()
	var hl_rel: int = FocusLyricLinePosition - 1
	var hide_y: float = float(OnecShowLyricLineCount + 1) * LineSpacing + 2 * extra_spacing
	const SETTLE_THRESHOLD := 0.5

	# 为当前窗口的每一行分配标签
	var needed_lines: Array = []
	for rel_i in range(-2, OnecShowLyricLineCount + 2):
		var line_idx := window_start + rel_i
		if line_idx >= 0 and line_idx < Lyric.size():
			needed_lines.append(line_idx)

	for line_idx in needed_lines:
		_assign_label_to_line(line_idx)

	# 处理所有标签：根据其绑定的行号计算位置和可见性
	for lbl in _label_pool:
		var line_idx: int = _label_line_map[lbl]
		if line_idx < 0 or line_idx >= Lyric.size():
			lbl.visible = false
			continue

		var rel_i: int = line_idx - window_start
		if rel_i < 0 or rel_i >= OnecShowLyricLineCount:
			if lbl.visible:
				lbl.visible = false
				lbl.position = Vector2(LyricPositionXOffset, hide_y)
			continue

		# 更新文本（空行用空格）
		var desired_text: String = Lyric[line_idx]
		if desired_text.strip_edges() == \"\":
			desired_text = \" \"
		if lbl.text != desired_text:
			lbl.text = desired_text

		# 计算目标Y坐标
		var target_y: float = float(rel_i + 1) * LineSpacing
		if rel_i > hl_rel:
			target_y += 2 * extra_spacing
		elif rel_i == hl_rel:
			target_y += extra_spacing

		if not lbl.visible:
			lbl.position = Vector2(LyricPositionXOffset, target_y)
			lbl.visible = true
		else:
			if abs(lbl.position.y - target_y) > SETTLE_THRESHOLD:
				var new_y: float = lerpf(lbl.position.y, target_y, 0.15 + absi(rel_i - FocusLyricLinePosition + 1) / 20.0)
				lbl.position = Vector2(lbl.position.x, new_y)

		lbl.modulate = subject_color if rel_i == hl_rel else Color.DIM_GRAY
		lbl.rotation = (lbl.position.y - float(FocusLyricLinePosition) * LineSpacing) / get_window().size.y * LyricRotationDegree

func Start() -> void:
	if not Subtitle.visible:
		return

	if _enter_tween and _enter_tween.is_valid():
		_enter_tween.kill()
		_enter_tween = null

	for lbl in _label_pool:
		lbl.modulate.a = 0.0
		lbl.scale = Vector2.ZERO

	_saved_index = index
	index = 0
	last_highlight_index = -1
	_is_animating = false
	_refresh_lyrics()

	_is_animating = true
	if tween_music_name and tween_music_name.is_running():
		tween_music_name.pause()

	_enter_tween = create_tween()
	_enter_tween.set_parallel(true)

	for i in _label_pool.size():
		var lbl = _label_pool[i]
		var delay = i * 0.05
		_enter_tween.tween_property(lbl, \"modulate:a\", 1.0, 0.3) \\
			.set_delay(delay).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		_enter_tween.tween_property(lbl, \"scale\", Vector2.ONE, 0.3) \\
			.set_delay(delay).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	if coverNode:
		_enter_tween.tween_property(coverNode, \"scale\", Vector2.ONE, 0.5) \\
			.from(Vector2.ZERO).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	if musicNameLabel:
		var initial_pos = musicNameLabel.position
		_enter_tween.tween_property(musicNameLabel, \"position:y\", initial_pos.y, 0.4) \\
			.from(initial_pos.y - 100).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		_enter_tween.tween_property(musicNameLabel, \"modulate:a\", 1.0, 0.3) \\
			.from(0.0)

	_enter_tween.finished.connect(_on_enter_animation_finished, CONNECT_ONE_SHOT)

func _on_enter_animation_finished() -> void:
	_is_animating = false
	_enter_tween = null

	if Player.sonance and tween_music_name and not tween_music_name.is_running():
		tween_music_name.play()

	var duration := Player.get_duration()
	if duration > 0:
		set_stream_position(Player.get_current_time_sec() / duration)
	else:
		_refresh_lyrics()

func set_stream_position(value: float) -> void:
	# 歌词数组为空时直接返回，避免无数据刷新
	if LyricTime.size() == 0 or Lyric.size() == 0:
		return
	index = find_index_greater_than(LyricTime, value * Player.get_duration())
	if Subtitle.visible:
		_refresh_lyrics()

func capitalize_line(text: String) -> String:
	if text.is_empty():
		return text
	var words := text.split(\" \")
	for i in words.size():
		if words[i] == \"i\":
			words[i] = \"I\"
	var result := \" \".join(words)
	if result.length() > 0:
		result = result[0].to_upper() + result.substr(1)
	return result

func find_index_greater_than(array: Array[float], target: float) -> int:
	var left := 0
	var right := array.size() - 1
	while left <= right:
		var mid := left + (right - left) / 2
		if array[mid] <= target:
			left = mid + 1
		else:
			right = mid - 1
	return left

var is_ECO_mode := false
func set_ECO_mode(value: bool) -> void:
	if is_ECO_mode == value:
		return
	if value:
		print(\"进入 ECO 模式\")
		is_ECO_mode = true
		if tween_music_name and tween_music_name.is_running():
			tween_music_name.pause()
		set_process(false)
		set_process_input(false)
		RenderingServer.viewport_set_active(get_viewport().get_viewport_rid(), false)
	else:
		print(\"退出 ECO 模式\")
		is_ECO_mode = false
		RenderingServer.viewport_set_active(get_viewport().get_viewport_rid(), true)
		set_process(true)
		set_process_input(true)

		if Player.sonance and tween_music_name and not tween_music_name.is_running():
			tween_music_name.play()

		if Subtitle.visible:
			var duration := Player.get_duration()
			if duration > 0:
				set_stream_position(Player.get_current_time_sec() / duration)
			else:
				_refresh_lyrics()
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_u3t73"]
shader = ExtResource("1_3b7vf")
shader_parameter/flow_speed = 0.15
shader_parameter/flow_strength = 1.0
shader_parameter/flow_scale = 5.0
shader_parameter/darken_gradient = 0.5
shader_parameter/chromatic_aberration = 0.006
shader_parameter/vignette_strength = 0.35
shader_parameter/tint_color = Color(1, 1, 1, 1)
shader_parameter/brightness = 1.0
shader_parameter/edge_glow_strength = 0.15
shader_parameter/glow_speed = 0.4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_3b7vf"]
bg_color = Color(0, 0, 0, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6466144, 0.64661443, 0.6466144, 1)
corner_radius_top_left = 260
