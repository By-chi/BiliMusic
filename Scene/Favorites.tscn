[sub_resource type="GDScript" id="GDScript_1siev"]
script/source = "extends Control

@export var thumbnails_scroll_container: ScrollContainer
@export var grid_container: GridContainer
@export var list_scroll_container: ScrollContainer
@export var list_container: VBoxContainer

@export var back_button: Button
@export var ok_button: Button
@export var remove_button: Button
@export var download_button: Button
@export var cut_button: Button
@export var copy_button: Button
@export var paste_button: Button
@export var add_button: Button
@export var view_mode_button: Button
@export var list_view: Texture2D
@export var thumbnails_view: Texture2D

const VideoCardScene = preload(\"res://Scene/VideoCard.tscn\")
const VideoTransverseCardScene = preload(\"res://Scene/VideoTransverseCard.tscn\")
const DeckScene = preload(\"res://Scene/Deck.tscn\")
const ListDeckScene = preload(\"res://Scene/ListDeck.tscn\")

var _is_showing_favorites: bool = true
var _current_fav_dir: String = \"\"
var _last_showing_favorites: bool = true

var selected_items: Array[Node] = []

var _download_queue: Array = []
var _is_downloading: bool = false

var _last_clicked_node: Node = null
var _last_click_time: int = 0
const DOUBLE_CLICK_THRESHOLD: int = 400

var _clipboard_type: String = \"\"
var _clipboard_data: Array = []

var is_select_mode: bool = false

signal favorites_selected(selected_favs: Array[String])

var list_view_mode: bool = true:
	set(value):
		if value != list_view_mode:
			list_view_mode = value
			if list_view_mode:
				view_mode_button.icon = thumbnails_view
			else:
				view_mode_button.icon = list_view
			GdScriptFunc.set_data(\"FavoritesPage\",\"IsListViewMode\",list_view_mode,true)
			update_view()

func _ready() -> void:
	if ok_button and ok_button.text.is_empty():
		ok_button.text = tr(\"确定\")
	_apply_container_visibility()
	call_deferred(\"_on_thumbnails_scroll_resized\")
	update()
	_update_buttons_state()
	list_view_mode=GdScriptFunc.get_data(\"FavoritesPage\",\"IsListViewMode\",true)
func _apply_container_visibility() -> void:
	if list_view_mode:
		thumbnails_scroll_container.hide()
		list_scroll_container.show()
	else:
		_on_thumbnails_scroll_resized()
		thumbnails_scroll_container.show()
		list_scroll_container.hide()

func set_select_mode(enable: bool) -> void:
	is_select_mode = enable
	_update_buttons_state()

func _update_buttons_state() -> void:
	var has_selection: bool = not selected_items.is_empty()
	var clipboard_valid: bool = not _clipboard_type.is_empty() and not _clipboard_data.is_empty()

	_set_button_disabled(add_button, not _is_showing_favorites)

	var download_enabled: bool = false
	if not _is_showing_favorites and has_selection:
		for node in selected_items:
			if \"link\" in node and node.video_info.get(\"is_network\", true):
				download_enabled = true
				break
	_set_button_disabled(download_button, not download_enabled)

	_set_button_disabled(paste_button, not clipboard_valid)
	_set_button_disabled(remove_button, not has_selection)
	_set_button_disabled(cut_button, not has_selection)
	_set_button_disabled(copy_button, not has_selection)

	if ok_button:
		if is_select_mode and _is_showing_favorites:
			ok_button.visible = true
			var has_folder: bool = false
			for node in selected_items:
				if \"directory_name\" in node:
					has_folder = true
					break
			_set_button_disabled(ok_button, not has_folder)
		else:
			ok_button.visible = false

func _set_button_disabled(button: Button, disabled: bool) -> void:
	if button == null:
		return
	button.disabled = disabled

func update() -> void:
	if _is_showing_favorites != _last_showing_favorites:
		_rebuild_current_view()
		_last_showing_favorites = _is_showing_favorites
	else:
		if _is_showing_favorites:
			_lazy_update_decks()
		else:
			if not _current_fav_dir.is_empty():
				_lazy_update_video_cards()
	_update_buttons_state()

func _rebuild_current_view() -> void:
	_clear_active_container()
	_apply_container_visibility()
	if _is_showing_favorites:
		_load_all_decks()
	else:
		if not _current_fav_dir.is_empty():
			_load_all_video_cards()

func _clear_active_container() -> void:
	if list_view_mode:
		for child in list_container.get_children():
			child.queue_free()
	else:
		for child in grid_container.get_children():
			child.queue_free()
	selected_items.clear()

func _lazy_update_decks() -> void:
	_apply_container_visibility()
	var new_decks: Array = GdScriptFunc.get_keys(\"Favorites\")
	if new_decks == null:
		new_decks = []

	var container = list_container if list_view_mode else grid_container
	var existing: Dictionary = {}
	for child in container.get_children():
		if (child is Button or child.has_method(\"refresh_covers\")) and \"directory_name\" in child:
			existing[child.directory_name] = child

	for dir_name in new_decks:
		if existing.has(dir_name):
			var deck = existing[dir_name]
			deck.videos = GdScriptFunc.get_data(\"Favorites\", dir_name)
			if deck.has_method(\"refresh_covers\"):
				deck.refresh_covers()
		else:
			var deck = _create_deck_node(dir_name)
			container.add_child(deck)
			GdScriptFunc.apply_theme_and_styles_to_node(deck)

	for dir_name in existing.keys():
		if not new_decks.has(dir_name):
			existing[dir_name].queue_free()

func _create_deck_node(dir_name: String) -> Node:
	if list_view_mode:
		var deck = ListDeckScene.instantiate()
		deck.directory_name = dir_name
		deck.videos = GdScriptFunc.get_data(\"Favorites\", dir_name,[])
		deck.pressed.connect(_on_deck_pressed.bind(deck))
		deck.gui_input.connect(_on_child_gui_input.bind(deck))
		return deck
	else:
		var deck = DeckScene.instantiate()
		deck.directory_name = dir_name
		deck.videos = GdScriptFunc.get_data(\"Favorites\", dir_name)
		deck.pressed.connect(_on_deck_pressed.bind(deck))
		deck.gui_input.connect(_on_child_gui_input.bind(deck))
		return deck

func _lazy_update_video_cards() -> void:
	_apply_container_visibility()
	var new_videos: Array = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])

	var container = list_container if list_view_mode else grid_container
	var existing: Dictionary = {}
	for child in container.get_children():
		if child.get(\"link\") != null:
			var expected_type = \"video_transverse\" if list_view_mode else \"video_thumb\"
			if child.get_meta(\"card_type\", \"\") == expected_type:
				existing[child.link] = child
			else:
				child.queue_free()

	for video_data in new_videos:
		var link = video_data[\"link\"]
		if existing.has(link):
			var card = existing[link]
			card.video_info = video_data
			card.title = video_data.get(\"title\", \"\")
			card.author = video_data.get(\"author\", \"\")
			card.description = video_data.get(\"description\", \"\")
			card.block_play = true
			var old_is_network = card.video_info.get(\"is_network\", true)
			var new_is_network = video_data.get(\"is_network\", true)
			if old_is_network != new_is_network:
				card.reset()
				if new_is_network:
					BilibiliApi.fetch_cover(card.link, set_cover.bind(card), 70 if list_view_mode else 583, 70 if list_view_mode else 364)
				elif FileAccess.file_exists(card.link.get_basename() + \".jpg\"):
					var image = Image.load_from_file(card.link.get_basename() + \".jpg\")
					_set_cover(ImageTexture.create_from_image(image), card)
				else:
					_load_local_cover(card)
				if not list_view_mode:
					card.custom_minimum_size = Vector2(582.4, 364.0)
		else:
			var card = _create_video_card_node(video_data)
			container.add_child(card)
			GdScriptFunc.apply_theme_and_styles_to_node(card)

	for link in existing.keys():
		var still_exists = false
		for v in new_videos:
			if v[\"link\"] == link:
				still_exists = true
				break
		if not still_exists:
			existing[link].queue_free()

func _create_video_card_node(video_data: Dictionary) -> Node:
	var video_card: Control
	if list_view_mode:
		video_card = VideoTransverseCardScene.instantiate()
		video_card.set_share_visible(false)
		video_card.set_duration_visible(false)
		video_card.set_play_visible(false)
		video_card.set_meta(\"card_type\", \"video_transverse\")
	else:
		video_card = VideoCardScene.instantiate()
		video_card.set_meta(\"card_type\", \"video_thumb\")

	video_card.video_info = video_data
	video_card.title = video_data.get(\"title\", \"\")
	video_card.author = video_data.get(\"author\", \"\")
	video_card.description = video_data.get(\"description\", \"\")
	video_card.link = video_data.get(\"link\", \"\")
	video_card.set(\"list_name\", _current_fav_dir)
	video_card.pressed.connect(_on_video_card_pressed.bind(video_card))
	video_card.gui_input.connect(_on_child_gui_input.bind(video_card))
	video_card.block_play = true
	video_card.reset()

	if video_data.get(\"is_network\", true):
		BilibiliApi.fetch_cover(video_card.link, set_cover.bind(video_card), 70 if list_view_mode else 583, 70 if list_view_mode else 364)
	elif FileAccess.file_exists(video_card.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video_card.link.get_basename() + \".jpg\")
		_set_cover(ImageTexture.create_from_image(image), video_card)
	else:
		_load_local_cover(video_card)

	if list_view_mode:
		video_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	else:
		video_card.custom_minimum_size = Vector2(582.4, 364.0)
	return video_card

func _load_local_cover(video_card: Control) -> void:
	var audio_path = video_card.link
	var dir = audio_path.get_base_dir()
	var base_name = audio_path.get_file().get_basename()
	var cover_path = dir.path_join(base_name + \".jpg\")
	var img = Image.new()
	if FileAccess.file_exists(cover_path) and img.load(cover_path) == OK:
		video_card.cover = ImageTexture.create_from_image(img)
	else:
		GdScriptFunc.generate_label_texture(Color.WHITE, video_card.title, _set_cover.bind(video_card), null, 50)

func _load_all_decks() -> void:
	var dir_names = GdScriptFunc.get_keys(\"Favorites\")
	if dir_names.is_empty():
		return
	var container = list_container if list_view_mode else grid_container
	for dir_name in dir_names:
		var deck = _create_deck_node(dir_name)
		container.add_child(deck)
		GdScriptFunc.apply_theme_and_styles_to_node(deck)

func _load_all_video_cards() -> void:
	var videos: Array = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])
	var container = list_container if list_view_mode else grid_container
	for v in videos:
		var video_card = _create_video_card_node(v)
		container.add_child(video_card)
		GdScriptFunc.apply_theme_and_styles_to_node(video_card)

func _set_cover(texture: Texture2D, video_card: Control) -> void:
	set_cover(\"\", texture, video_card)

func set_cover(_bvid: String, texture: Texture2D, video_card) -> void:
	if is_instance_valid(video_card):
		video_card.cover = texture

func _handle_node_click(node: Node) -> void:
	var now = Time.get_ticks_msec()
	if _last_clicked_node == node and (now - _last_click_time) < DOUBLE_CLICK_THRESHOLD:
		_double_click_node(node)
		_last_clicked_node = null
		_last_click_time = 0
	else:
		_select_node(node, Input.is_key_pressed(KEY_CTRL))
		_last_clicked_node = node
		_last_click_time = now

func _select_node(node: Node, ctrl_pressed: bool) -> void:
	if ctrl_pressed:
		var idx = selected_items.find(node)
		if idx != -1:
			selected_items.remove_at(idx)
		else:
			selected_items.append(node)
	else:
		selected_items.clear()
		selected_items.append(node)
	_update_selection_visual()

func _double_click_node(node: Node) -> void:
	if \"directory_name\" in node:
		_current_fav_dir = node.directory_name
		_is_showing_favorites = false
		back_button.show()
		update()
	else:
		node.play_card()

func _update_selection_visual() -> void:
	var container = list_container if list_view_mode else grid_container
	for child in container.get_children():
		if \"directory_name\" in child:
			child.self_modulate = Color(0.753, 0.949, 1.0) if selected_items.has(child) else Color.WHITE
		else:
			if selected_items.has(child):
				if child.get(\"title_label\"):
					child.title_label.add_theme_color_override(\"font_color\", Color(0.0, 0.352, 0.47, 1.0))
				else:
					child.self_modulate = Color(0.753, 0.949, 1.0)
			else:
				if child.get(\"title_label\"):
					child.title_label.add_theme_color_override(\"font_color\", Color.BLACK)
				else:
					child.self_modulate = Color.WHITE
	_update_buttons_state()

func _on_deck_pressed(deck: Node) -> void:
	_handle_node_click(deck)

func _on_video_card_pressed(video_card: Control) -> void:
	_handle_node_click(video_card)

func _on_child_gui_input(event: InputEvent, node: Node) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
		_show_context_menu_for_node(node)

func _show_context_menu_for_node(node: Node) -> void:
	if not selected_items.has(node):
		_select_node(node, false)

	var menu_data: Array[Dictionary] = []
	menu_data.append({\"label\": tr(\"全选\"), \"action\": func(d): _select_all(), \"enabled\": true})
	menu_data.append({\"label\": tr(\"取消全选\"), \"action\": func(d): _deselect_all(), \"enabled\": not selected_items.is_empty()})
	menu_data.append({\"type\": \"separator\"})

	var has_selection = not selected_items.is_empty()
	var clipboard_valid = not _clipboard_type.is_empty() and not _clipboard_data.is_empty()

	menu_data.append({\"label\": tr(\"剪切\"), \"action\": func(d): _on_cut_pressed(), \"enabled\": has_selection})
	menu_data.append({\"label\": tr(\"复制\"), \"action\": func(d): _on_copy_pressed(), \"enabled\": has_selection})
	menu_data.append({\"label\": tr(\"粘贴\"), \"action\": func(d): _on_paste_pressed(), \"enabled\": clipboard_valid})
	menu_data.append({\"type\": \"separator\"})
	menu_data.append({\"label\": tr(\"删除\"), \"action\": func(d): _delete_selected_items(), \"enabled\": has_selection})

	if not _is_showing_favorites:
		var has_network = false
		for item in selected_items:
			if \"link\" in item and item.video_info.get(\"is_network\", true):
				has_network = true
				break
		menu_data.append({\"label\": tr(\"下载\"), \"action\": func(d): _download_selected_cards(), \"enabled\": has_network})
	if \"link\" in node and not _is_showing_favorites:
		menu_data.append({\"type\": \"separator\"})
		menu_data.append({\"label\": tr(\"属性\"), \"action\": func(d): _on_properties_pressed(node), \"enabled\": true})

	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu_data)

func _on_properties_pressed(node: Node) -> void:
	GdScriptFunc.open_metadata_manager_window(_current_fav_dir, node.link)

func _select_all() -> void:
	selected_items.clear()
	var container = list_container if list_view_mode else grid_container
	for child in container.get_children():
		selected_items.append(child)
	_update_selection_visual()

func _deselect_all() -> void:
	selected_items.clear()
	_update_selection_visual()

func _download_video(video_card: Control, on_finished: Callable = Callable()) -> void:
	var video_info: Dictionary = video_card.get(\"video_info\")
	if video_info.is_empty():
		GdScriptFunc.set_progress_bar_value(100, \"\", tr(\"下载失败：无视频信息\"))
		if on_finished.is_valid(): on_finished.call()
		return

	if video_info.get(\"is_network\", true) == false:
		GdScriptFunc.set_progress_bar_value(100, \"\", tr(\"本地文件，无需下载\"))
		if on_finished.is_valid(): on_finished.call()
		return

	var bvid: String = video_info.get(\"link\", \"\")
	if bvid.is_empty():
		GdScriptFunc.set_progress_bar_value(100, \"\", tr(\"下载失败：无效链接\"))
		if on_finished.is_valid(): on_finished.call()
		return

	GdScriptFunc.set_progress_bar_value(10, tr(\"下载\"), tr(\"正在获取视频信息...\"))
	BilibiliApi.fetch_video_info(bvid, func(full_info: Dictionary):
		if full_info.is_empty():
			push_error(\"获取视频信息失败: \" + bvid)
			GdScriptFunc.set_progress_bar_value(100, \"\", tr(\"获取视频信息失败\"))
			if on_finished.is_valid(): on_finished.call()
			return

		var title = full_info.get(\"title\", bvid)
		var author = full_info.get(\"author\", \"\")
		var description = full_info.get(\"desc\", \"\")

		GdScriptFunc.set_progress_bar_value(20, title, tr(\"信息获取成功，开始下载音频...\"))
		_download_audio_async(bvid, func(audio_result: Dictionary):
			if audio_result.is_empty():
				push_error(\"下载音频失败: \" + bvid)
				GdScriptFunc.set_progress_bar_value(100, title, tr(\"音频下载失败\"))
				if on_finished.is_valid(): on_finished.call()
				return

			var audio_path: String = audio_result[\"local_path\"]
			GdScriptFunc.set_progress_bar_value(50, title, tr(\"音频下载完成，正在下载封面...\"))
			var lrc_path: String = audio_path.get_basename() + \".lrc\"

			var fav_list: Array = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])
			var updated := false
			for item in fav_list:
				if item[\"link\"] == bvid:
					item[\"link\"] = audio_path
					item[\"is_network\"] = false
					item[\"title\"] = title
					item[\"author\"] = author
					item[\"description\"] = description
					item[\"BV\"] = bvid
					item.erase(\"subtitles\")
					updated = true
					break

			if not updated:
				push_error(\"未在收藏夹中找到对应条目: \" + bvid)
				GdScriptFunc.set_progress_bar_value(100, title, tr(\"更新收藏夹失败\"))
				if on_finished.is_valid(): on_finished.call()
				return

			BilibiliApi.fetch_cover(bvid, func(bvid_param, cover_texture: Texture2D):
				var cover_loaded = false
				if cover_texture:
					var img = cover_texture.get_image()
					if img:
						var dir = audio_path.get_base_dir()
						var base_name = audio_path.get_file().get_basename()
						var cover_path = dir.path_join(base_name + \".jpg\")
						var err = img.save_jpg(cover_path)
						if err == OK:
							cover_loaded = true
							if is_instance_valid(video_card):
								video_card.video_info = {
									\"link\": audio_path,
									\"is_network\": false,
									\"title\": title,
									\"author\": author,
									\"description\": description,
									\"BV\": bvid
								}
								video_card.link = audio_path
								video_card.title = title
								video_card.author = author
								video_card.description = description
								video_card.reset()
								video_card.block_play = true
								var loaded_img = Image.new()
								if loaded_img.load(cover_path) == OK:
									video_card.cover = ImageTexture.create_from_image(loaded_img)
								else:
									GdScriptFunc.generate_label_texture(Color.WHITE, title, _set_cover.bind(video_card), null, 50)
								if not list_view_mode:
									video_card.custom_minimum_size = Vector2(582.4, 364.0)

				if not cover_loaded:
					if is_instance_valid(video_card):
						video_card.video_info = {
							\"link\": audio_path,
							\"is_network\": false,
							\"title\": title,
							\"author\": author,
							\"description\": description,
							\"BV\": bvid
						}
						video_card.link = audio_path
						video_card.title = title
						video_card.author = author
						video_card.description = description
						video_card.reset()
						video_card.block_play = true
						GdScriptFunc.generate_label_texture(Color.WHITE, title, _set_cover.bind(video_card), null, 50)
						if not list_view_mode:
							video_card.custom_minimum_size = Vector2(582.4, 364.0)

				GdScriptFunc.set_progress_bar_value(70, title, tr(\"封面处理完成\"))

				if GdScriptFunc.get_data(\"Options\", \"SubtitleTextCorrection\", false):
					GdScriptFunc.set_progress_bar_value(80, title, tr(\"正在下载字幕...\"))
					BilibiliApi.fetch_subtitle_auto(bvid, func(subtitle_data: Dictionary):
						if not subtitle_data.is_empty():
							for item in fav_list:
								if item[\"link\"] == audio_path:
									item[\"subtitles\"] = {\"path\": lrc_path}
									break
							if is_instance_valid(video_card):
								video_card.video_info[\"subtitles\"] = {\"path\": lrc_path}
							GdScriptFunc.set_data(\"Favorites\", _current_fav_dir, fav_list)

						GdScriptFunc.set_progress_bar_value(100, title, tr(\"下载完成\"))
						if on_finished.is_valid(): on_finished.call()
						update.call_deferred()
					, lrc_path)
				else:
					GdScriptFunc.set_progress_bar_value(100, title, tr(\"下载完成\"))
					GdScriptFunc.set_data(\"Favorites\", _current_fav_dir, fav_list)
					if on_finished.is_valid(): on_finished.call()
					update.call_deferred()
			, 1280, 720)
		)
	)

const TARGET_DIR := \"user://local_music/\"

func _download_audio_async(bvid: String, callback: Callable) -> void:
	var thread := Thread.new()
	var result := {
		\"success\": false,
		\"local_path\": \"\",
		\"hash\": \"\"
	}

	thread.start(func():
		var info_dict = DownloadAudio.GetAudioInfoByBvSync(bvid)
		if info_dict == null or info_dict.get(\"audioUrl\", \"\").is_empty():
			return result

		var audio_url = info_dict[\"audioUrl\"]
		var referer = info_dict[\"referer\"]

		var temp_path = DownloadAudio.DownloadAudioSync(audio_url, referer)
		if temp_path == \"\" or temp_path.is_empty() or not FileAccess.file_exists(temp_path):
			return result
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(TARGET_DIR))

		var src := FileAccess.open(temp_path, FileAccess.READ)
		if src == null:
			return result

		var ctx := HashingContext.new()
		ctx.start(HashingContext.HASH_SHA256)
		while src.get_position() < src.get_length():
			ctx.update(src.get_buffer(4096))
		var file_hash := ctx.finish().hex_encode()
		src.close()

		var ext = temp_path.get_extension()
		var dst_filename = file_hash + \".\" + ext if not ext.is_empty() else file_hash
		var dst_path := TARGET_DIR.path_join(dst_filename)

		if not FileAccess.file_exists(dst_path):
			var err := DirAccess.copy_absolute(temp_path, dst_path)
			if err != OK:
				DirAccess.remove_absolute(temp_path)
				return result

		DirAccess.remove_absolute(temp_path)

		result[\"success\"] = true
		result[\"local_path\"] = dst_path
		result[\"hash\"] = file_hash
		return result
	)

	var check_timer := Timer.new()
	check_timer.wait_time = 0.05
	check_timer.one_shot = false
	add_child(check_timer)
	check_timer.timeout.connect(func():
		if not thread.is_alive():
			var res = thread.wait_to_finish()
			check_timer.queue_free()
			callback.call(res)
	)
	check_timer.start()

func _process_download_queue() -> void:
	if _is_downloading:
		return
	if _download_queue.is_empty():
		return

	var card = _download_queue.pop_front()
	_is_downloading = true
	_download_video(card, func():
		_is_downloading = false
		_process_download_queue()
	)

func _delete_selected_items() -> void:
	var to_delete = selected_items.duplicate()
	selected_items.clear()
	for node in to_delete:
		if not is_instance_valid(node):
			continue
		if \"directory_name\" in node:
			var dir_name = node.directory_name
			GdScriptFunc.remove_key(\"Favorites\", dir_name)
			node.queue_free()
		elif \"link\" in node:
			var link = node.link
			_remove_video_from_current_fav(link)
			node.queue_free()
	_update_selection_visual()
	update()

func _remove_video_from_current_fav(link: String) -> void:
	if _current_fav_dir.is_empty():
		return
	var videos: Array = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])
	var new_videos = []
	for v in videos:
		if v[\"link\"] != link:
			new_videos.append(v)
	GdScriptFunc.set_data(\"Favorites\", _current_fav_dir, new_videos)

func _download_selected_cards() -> void:
	var cards_to_download = []
	for node in selected_items:
		if \"link\" in node and node.video_info.get(\"is_network\", true):
			cards_to_download.append(node)

	if cards_to_download.is_empty():
		return

	_download_queue = cards_to_download
	_process_download_queue()

func _on_add_pressed() -> void:
	if not _is_showing_favorites:
		return

	var deck = _create_deck_node(\"\")
	deck.text_node.call_deferred(\"grab_focus\") if deck.has_method(\"grab_focus\") else null
	var container = list_container if list_view_mode else grid_container
	container.add_child(deck)
	scroll_to_bottom(thumbnails_scroll_container if not list_view_mode else list_scroll_container)
	GdScriptFunc.apply_theme_and_styles_to_node(deck)
	_update_buttons_state()

func _on_back_pressed() -> void:
	back_button.hide()
	_is_showing_favorites = true
	update()

func _on_remove_pressed() -> void:
	_delete_selected_items()

func _on_download_pressed() -> void:
	_download_selected_cards()
	_update_buttons_state()

func scroll_to_bottom(scroll: ScrollContainer) -> void:
	if not scroll: return
	var v_scrollbar = scroll.get_v_scroll_bar()
	if v_scrollbar:
		scroll.scroll_vertical = int(v_scrollbar.max_value)
		v_scrollbar.queue_redraw()
		scroll.queue_redraw()

func _on_thumbnails_scroll_resized() -> void:
	if not thumbnails_scroll_container or list_view_mode:
		return
	grid_container.columns = max(1, int(thumbnails_scroll_container.size.x / 600))

func _on_ok_pressed() -> void:
	var selected_favs: Array[String] = []
	for node in selected_items:
		if \"directory_name\" in node:
			selected_favs.append(node.directory_name)

	favorites_selected.emit(selected_favs)

	if get_parent():
		get_parent().queue_free()

func _on_cut_pressed() -> void:
	if selected_items.is_empty():
		return
	_clipboard_type = \"cut\"
	_clipboard_data.clear()
	for node in selected_items:
		var data = _serialize_node(node)
		if not data.is_empty():
			_clipboard_data.append(data)
	_update_buttons_state()

func _on_copy_pressed() -> void:
	if selected_items.is_empty():
		return
	_clipboard_type = \"copy\"
	_clipboard_data.clear()
	for node in selected_items:
		var data = _serialize_node(node)
		if not data.is_empty():
			_clipboard_data.append(data)
	_update_buttons_state()

func _on_paste_pressed() -> void:
	if _clipboard_type.is_empty() or _clipboard_data.is_empty():
		return

	var any_pasted = false
	for data in _clipboard_data:
		var type = data.get(\"type\", \"\")
		if type == \"folder\":
			if _is_showing_favorites:
				if _paste_folder(data):
					any_pasted = true
			else:
				if _paste_folder_contents_to_current(data):
					any_pasted = true
		elif type == \"file\":
			if _is_showing_favorites:
				if _paste_file_to_new_folder(data):
					any_pasted = true
			else:
				if _paste_file(data):
					any_pasted = true

	if _clipboard_type == \"cut\" and any_pasted:
		_execute_cut_delete()
		_clipboard_type = \"\"
		_clipboard_data.clear()

	update()
	_update_buttons_state()

func _serialize_node(node: Node) -> Dictionary:
	if \"directory_name\" in node:
		var videos = GdScriptFunc.get_data(\"Favorites\", node.directory_name, [])
		return {
			\"type\": \"folder\",
			\"name\": node.directory_name,
			\"videos\": videos.duplicate(true)
		}
	elif \"link\" in node:
		return {
			\"type\": \"file\",
			\"data\": node.video_info.duplicate(true) if \"video_info\" in node else {},
			\"source_dir\": _current_fav_dir
		}
	return {}

func _paste_folder(data: Dictionary) -> bool:
	var original_name = data[\"name\"]
	var new_name = _generate_unique_folder_name(original_name)
	var videos_copy = data[\"videos\"].duplicate(true)
	GdScriptFunc.set_data(\"Favorites\", new_name, videos_copy)
	return true

func _paste_file(data: Dictionary) -> bool:
	var file_data = data[\"data\"].duplicate(true)
	if file_data.is_empty():
		return false
	var fav_list = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])
	for item in fav_list:
		if item.get(\"link\") == file_data.get(\"link\"):
			return false
	fav_list.append(file_data)
	GdScriptFunc.set_data(\"Favorites\", _current_fav_dir, fav_list)
	return true

func _paste_file_to_new_folder(data: Dictionary) -> bool:
	var file_data = data[\"data\"].duplicate(true)
	if file_data.is_empty():
		return false
	var folder_name = file_data.get(\"title\", tr(\"未命名\"))
	folder_name = _generate_unique_folder_name(folder_name)
	var video_list = [file_data]
	GdScriptFunc.set_data(\"Favorites\", folder_name, video_list)
	return true

func _paste_folder_contents_to_current(data: Dictionary) -> bool:
	if _current_fav_dir.is_empty():
		return false
	var videos = data.get(\"videos\", [])
	if videos.is_empty():
		return false
	var fav_list = GdScriptFunc.get_data(\"Favorites\", _current_fav_dir, [])
	var added_any = false
	for video in videos:
		var already_exists = false
		for item in fav_list:
			if item.get(\"link\") == video.get(\"link\"):
				already_exists = true
				break
		if not already_exists:
			fav_list.append(video.duplicate(true))
			added_any = true
	if added_any:
		GdScriptFunc.set_data(\"Favorites\", _current_fav_dir, fav_list)
	return added_any

func _generate_unique_folder_name(base: String) -> String:
	var keys = GdScriptFunc.get_keys(\"Favorites\")
	if keys == null: keys = []
	var new_name = base
	var counter = 1
	while keys.has(new_name):
		new_name = base + tr(\" - 副本\") + ((\" (\" + str(counter) + \")\") if counter > 1 else \"\")
		counter += 1
	return new_name

func _execute_cut_delete() -> void:
	for data in _clipboard_data:
		if data.get(\"type\") == \"folder\":
			var _name = data[\"name\"]
			GdScriptFunc.remove_key(\"Favorites\", _name)
		elif data.get(\"type\") == \"file\":
			var file_data = data[\"data\"]
			var link = file_data.get(\"link\", \"\")
			var source_dir = data.get(\"source_dir\", \"\")
			if not link.is_empty() and not source_dir.is_empty():
				var fav_list = GdScriptFunc.get_data(\"Favorites\", source_dir, [])
				var new_list = []
				for item in fav_list:
					if item.get(\"link\") != link:
						new_list.append(item)
				GdScriptFunc.set_data(\"Favorites\", source_dir, new_list)

func update_view() -> void:
	_rebuild_current_view()

func _on_view_mode_pressed() -> void:
	list_view_mode = !list_view_mode
"

