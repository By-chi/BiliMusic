[sub_resource type="GDScript" id="GDScript_jchgq"]
script/source = "extends BaseVideoCard

@export var play_label: Label
@export var share_button: Button
@export var duration_label: Label

var keywords:=\"\":
	set(value):
		keywords = value
		_after_text_changed()
func _after_text_changed() -> void:
	if keywords != \"\" and title_label != null and author_label != null:
		GdScriptFunc.apply_highlight(title_label, keywords, title)
		GdScriptFunc.apply_highlight(author_label, keywords, author)
var video_info:Dictionary={}
var play: int = 0:
	set(value):
		play = value
		play_label.text = \"▶ \" + GdScriptFunc.format_number(play)

var duration: String = \"--:--\":
	set(value):
		duration = value
		duration_label.text = GdScriptFunc.format_time_string(duration)

# 鼠标悬停动画
func _on_mouse_entered() -> void:
	if _hover_tween and _hover_tween.is_running(): _hover_tween.kill()
	_hover_tween = color_rect.create_tween()
	_hover_tween.tween_property(color_rect, \"modulate\", Color.WHITE, 0.2)

func _on_mouse_exited() -> void:
	if _hover_tween and _hover_tween.is_running(): _hover_tween.kill()
	_hover_tween = color_rect.create_tween()
	_hover_tween.tween_property(color_rect, \"modulate\", Color.TRANSPARENT, 0.25).set_trans(Tween.TRANS_CUBIC)
func reset()->void:
	super.reset()
	_update_share_button()
func _update_share_button()->void:
	for fav_key in GdScriptFunc.get_keys(\"Favorites\"):
		var arr = GdScriptFunc.get_data(\"Favorites\", fav_key, [])
		for item in arr:
			if item[\"link\"] == link:
				share_button.set_pressed_no_signal(true)
				share_button.modulate=Color(3.095, 0.0, 0.0)
				shared=true
				return
	share_button.modulate=Color.WHITE
	shared=false
	share_button.set_pressed_no_signal(false)

var shared:=false
func _on_share_pressed() -> void:
	if !shared:
		var directorys: Array = await GdScriptFunc.open_select_favorites_window()
		if directorys.is_empty():
			_update_share_button()
			return
		for directory_name in directorys:
			var list: Array = GdScriptFunc.get_data(\"Favorites\", directory_name, [])
			var repeated := false
			for i in list:
				if link == i[\"link\"]:
					repeated = true
					break
			if repeated: continue

			# 构建新条目，增加 BV 字段
			var new_item := {
				\"link\": link,
				\"title\": title,
				\"author\": author,
				\"description\": description,
				\"is_network\": true,
				\"BV\": video_info.get(\"BV\", link)   # 若 video_info 已有 BV 则用，否则用 link（BV号）
			}
			list.append(new_item)
			GdScriptFunc.set_data(\"Favorites\", directory_name, list)
		GdScriptFunc.flush()
		_update_share_button()
	else:
		GdScriptFunc.cancel_collection(link)
		_update_share_button()
"

