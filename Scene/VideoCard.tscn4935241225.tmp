[sub_resource type="GDScript" id="GDScript_vdm7u"]
script/source = "extends BaseVideoCard
func _update_pivot() -> void:
	pivot_offset = size / 2

func _on_mouse_entered() -> void:
	_update_pivot()
	if _hover_tween and _hover_tween.is_running(): _hover_tween.kill()
	
	_hover_tween = create_tween().set_parallel()
	_hover_tween.tween_property(self, \"scale\", Vector2(1.05, 1.05), 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	_hover_tween.tween_property(color_rect, \"modulate\", Color.WHITE, 0.25)

func _on_mouse_exited() -> void:
	if _hover_tween and _hover_tween.is_running(): _hover_tween.kill()
	
	_hover_tween = create_tween().set_parallel()
	_hover_tween.tween_property(self, \"scale\", Vector2.ONE, 0.2).set_trans(Tween.TRANS_EXPO)
	_hover_tween.tween_property(color_rect, \"modulate\", Color.TRANSPARENT, 0.2)
"

