[sub_resource type="GDScript" id="GDScript_q7gkv"]
script/source = "extends Control

@export var rsults_list: VBoxContainer
@export var page_edit: LineEdit
@export var label: Label
@export var sub_label: Label
@export var SortModeButton: OptionButton
@export var loading: Control
@export var error: TextureRect
@export var obstacle: ColorRect

var current_execution_number := 0
var current_count := 0
var current_page := 1
var current_keyword := \"\"
var active_tweens: Array[Tween] = [] # 用于管理卡片生成的动画，方便中途取消

# 注意：obstacle 需要在编辑器里把 color 的 alpha 设为类似 (0,0,0,0.5)，不要完全不透明
var page_number := 1:
	set(value):
		if page_number != value and value > 0:
			page_edit.text = str(value)
			page_number = value
			update_page(current_keyword)

# ---------------- 动画工具函数 ----------------
func fade_in(node: Control, duration: float = 0.2) -> Tween:
	node.show()
	node.modulate.a = 0.0
	var tw = create_tween()
	tw.tween_property(node, \"modulate:a\", 1.0, duration)
	return tw

func fade_out(node: Control, duration: float = 0.15) -> Tween:
	if not node.visible: return null
	var tw = create_tween()
	tw.tween_property(node, \"modulate:a\", 0.0, duration)
	tw.tween_callback(node.hide)
	return tw

func _kill_active_tweens() -> void:
	for tw in active_tweens:
		if tw and tw.is_running():
			tw.kill()
	active_tweens.clear()

# ---------------- 核心逻辑 ----------------
func clear_page() -> void:
	_kill_active_tweens()
	# 让现有的卡片淡出并清理
	for child in rsults_list.get_children():
		fade_out(child, 0.1)
	await get_tree().create_timer(0.12).timeout # 等淡出完毕再清理内存
	for i in rsults_list.get_child_count():
		rsults_list.get_child(i).queue_free()
		
	label.text = \"搜索\"
	sub_label.text = \"请搜索\"
	fade_out(loading, 0.1)

func update_page(keyword: String) -> void:
	current_execution_number = randi()
	_kill_active_tweens() # 关键：打断上一次未完成的卡片动画
	
	fade_out(error, 0.1)
	fade_in(obstacle, 0.15)
	
	# 瞬间隐藏旧卡片（让位给新数据）
	for child in rsults_list.get_children():
		child.modulate.a = 0.0
		child.hide()
		
	current_keyword = keyword
	if keyword == \"\":
		clear_page()
		return
		
	label.text = \"搜索\\\"\" + keyword + \"\\\"\"
	sub_label.text = \"搜索中\"
	fade_in(loading, 0.2)
	
	BilibiliIc.search_bilibili(update_callback.bind(current_execution_number), keyword, 30, SortModeButton.selected, page_number)

func update_callback(videos: Array, execution_number := 0) -> void:
	_kill_active_tweens() # 确保没有残留动画
	current_count = videos.size()
	
	fade_out(loading, 0.2)
	fade_out(obstacle, 0.2)
	
	if current_count == 0:
		fade_in(error, 0.3)
		error.texture = preload(\"res://UI/Icon/nodat.png\")
		sub_label.text = \"未找任何歌曲\"
		return
	if videos[0].is_empty():
		fade_in(error, 0.3)
		error.texture = preload(\"res://UI/Icon/neterror.png\")
		sub_label.text = \"网络错误\"
		return
		
	sub_label.text = \"已找到\" + str(current_count) + \"首歌曲\"
	
	# 预计算总时间，方便后续清理多余的卡片
	var total_needed = current_count 
	
	for i in current_count:
		# 再次检查是否被新的搜索请求取消
		if execution_number != current_execution_number:
			return
		
		var video_transverse_card: BaseVideoCard
		if rsults_list.get_child_count() <= i:
			video_transverse_card = preload(\"res://Scene/VideoTransverseCard.tscn\").instantiate()
			rsults_list.add_child(video_transverse_card)
		else:
			video_transverse_card = rsults_list.get_child(i)
		var video: Dictionary = videos[i]
		video_transverse_card.title = video.title
		video_transverse_card.author = video.author
		video_transverse_card.keywords = current_keyword
		video_transverse_card.play = int(video.play)
		video_transverse_card.description = video.description
		video_transverse_card.link = video.bvid
		video_transverse_card.reset()
		
		if video.has(\"duration\"):
			video_transverse_card.duration = video.duration
		if video.has(\"cover_url\"):
			BilibiliIc._download_cover(video.cover_url, video.bvid,70,70,set_cover.bind(video_transverse_card))
		else:
			BilibiliIc.fetch_cover(video.bvid, set_cover.bind(video_transverse_card),70,70)
		
		# --- 卡片入场 Tween 动画 ---
		# 初始化状态：透明且微小
		video_transverse_card.modulate.a = 0.0
		video_transverse_card.scale = Vector2(0.9, 0.9)
		video_transverse_card.show()
		
		var tw = create_tween()
		active_tweens.append(tw)
		
		# 先延迟（形成依次出场效果）
		tw.tween_interval(i * 0.04) 
		# 开启并行，同时执行透明度和缩放
		tw.set_parallel(true)
		tw.tween_property(video_transverse_card, \"modulate:a\", 1.0, 0.25)
		# 使用 TRANS_BACK 让卡片有轻微的\"弹跳\"过冲感，更生动
		tw.tween_property(video_transverse_card, \"scale\", Vector2.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		
	# 清理多余的旧卡片（如果上一页有30个，这一页只有10个，移除后20个）
	while rsults_list.get_child_count() > total_needed:
		var extra_card = rsults_list.get_child(-1)
		fade_out(extra_card, 0.1)
		# 给一点时间淡出后再移除
		await get_tree().create_timer(0.12).timeout
		if extra_card.is_inside_tree():
			rsults_list.remove_child(extra_card)
			extra_card.queue_free()

func set_cover(_bvid: String, texture: Texture2D, video_card: Control) -> void:
	if is_instance_valid(video_card): # 防止卡片已被销毁
		video_card.cover = texture

# ---------------- 信号回调 ----------------
func _on_sort_mode_item_selected(_index: int) -> void:
	update_page(current_keyword)

func _on_last_pressed() -> void:
	if page_number > 1:
		page_number -= 1

func _on_next_pressed() -> void:
	page_number += 1

func _on_page_text_submitted(new_text: String) -> void:
	var num = new_text.to_int()
	if num > 0:
		page_number = num
	else:
		page_edit.text = str(page_number) # 输入非法字符时恢复原数字
"

