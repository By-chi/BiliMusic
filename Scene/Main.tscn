[sub_resource type="GDScript" id="GDScript_aan6j"]
script/source = "extends Panel
@export var page_buttons:Array[Button]
@export var current_page:Control
@export var current_page_name:String
@export var bottom_menu:Panel
@export var ui_sound:AudioStreamPlayer
@export var icon:TextureRect
func play(card:BaseVideoCard)->void:
	Player.play_by_video_info(card.video_info)
	var i:=0
	while card.cover == null&&i!=1000:
		await get_tree().process_frame
		i+=1
	match State.play_ui_mode:
		0:
			bottom_menu.show()
			if bottom_menu.play_window!=null:
				bottom_menu.play_window.hide()
			bottom_menu.play_button.button_pressed=true
			bottom_menu.title=card.title
			bottom_menu.progress_bar.value=0
			bottom_menu.author=card.author
			bottom_menu.cover=card.cover
			bottom_menu.list_name=card.list_name
		1:
			bottom_menu.hide()
			bottom_menu.play_window.show()
			bottom_menu.play_window.update(card.list_name,card.cover,card.video_info)
func _ready() -> void:
	get_window().size_changed.connect(func():
		GdScriptFunc.set_data(\"Window\",\"Size\",get_window().size)
		
	)
	get_window().close_requested.connect(func():
		GdScriptFunc.set_data(\"Window\",\"Position\",get_window().position,true)
		if GdScriptFunc.get_data(\"Options\",\"Close_to_tray\",false):
			pass
		else:
			get_tree().quit()
	)
	get_window().min_size=Vector2i(1285,262)
	for button in page_buttons:
		button.connect(\"pressed\",change_page.bind(button.name))
	get_window().size=GdScriptFunc.get_data(\"Window\",\"Size\",Vector2i(1600,1000))
	if GdScriptFunc.get_data(\"Options\",\"RememberWindow\",true):
		var pos:Vector2i=GdScriptFunc.get_data(\"Window\",\"Position\",Vector2i(-114514,-114514))
		if pos!=Vector2i(-114514,-114514):
			get_window().position=pos
	
func change_page(page_name:String)->void:
	if page_name==current_page_name:
		return
	current_page.hide()
	current_page=get_node(page_name)
	current_page.show()
	current_page_name=page_name


func _on_search_text_submitted(new_text: String) -> void:
	get_node(\"Results\").update_page(new_text)
	change_page(\"Results\")
"

