[sub_resource type="GDScript" id="GDScript_q7gkv"]
script/source = "extends Control

@export var rsults_list: VBoxContainer
@export var rsults_scroll: ScrollContainer
@export var page_edit: LineEdit
@export var sub_label: Label
@export var SortModeButton: OptionButton
@export var TidsButton: OptionButton
@export var loading: Control
@export var error: TextureRect
@export var obstacle: Panel
@export var search_bar: LineEdit

var current_execution_number := 0
var current_count := 0
var current_page := 1
var current_keyword := \"\"
var active_tweens: Array[Tween] = []

var page_number := 1:
	set(value):
		if page_number != value and value > 0:
			page_edit.text = str(value)
			page_number = value
			update_page(current_keyword)

func fade_in(node: Control, duration: float = 0.2) -> Tween:
	node.show()
	node.modulate.a = 0.0
	var tw = create_tween()
	tw.tween_property(node, \"modulate:a\", 1.0, duration)
	return tw

func fade_out(node: Control, duration: float = 0.15) -> Tween:
	if not node.visible: return null
	var tw = create_tween()
	tw.tween_property(node, \"modulate:a\", 0.0, duration)
	tw.tween_callback(node.hide)
	return tw

func _kill_active_tweens() -> void:
	for tw in active_tweens:
		if tw and tw.is_running():
			tw.kill()
	active_tweens.clear()

func clear_page() -> void:
	_kill_active_tweens()
	for child in rsults_list.get_children():
		fade_out(child, 0.1)
	await get_tree().create_timer(0.12).timeout
	for i in rsults_list.get_child_count():
		rsults_list.get_child(i).queue_free()
	sub_label.text = tr(\"请搜索\")
	fade_out(loading, 0.1)
func show_search_bar()->void:
	var tween:=search_bar.create_tween()
	tween.set_parallel()
	tween.tween_property(search_bar,\"offset_transform_scale:x\",1.0,0.3).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(rsults_scroll,\"offset_transform_position:y\",0.0,0.3).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(rsults_scroll,\"size:y\",673.0,0.3).set_trans(Tween.TRANS_CUBIC)
	
func hide_search_bar()->void:
	var tween:=search_bar.create_tween()
	tween.set_parallel()
	tween.tween_property(search_bar,\"offset_transform_scale:x\",0,0.3).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(rsults_scroll,\"offset_transform_position:y\",-60.0,0.3).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(rsults_scroll,\"size:y\",733.0,0.3).set_trans(Tween.TRANS_CUBIC)
func update_page(keyword: String) -> void:
	current_execution_number = randi()
	_kill_active_tweens()
	fade_out(error, 0.1)
	fade_in(obstacle, 0.15)
	for child in rsults_list.get_children():
		child.modulate.a = 0.0
		child.hide()
	current_keyword = keyword
	if keyword == \"\":
		clear_page()
		return
	sub_label.text = tr(\"搜索中\")
	fade_in(loading, 0.2)

	if keyword.begins_with(\"UID:\"):
		var mid = keyword.substr(4)
		BilibiliApi.fetch_user_videos(mid, update_callback.bind(current_execution_number), page_number, 30, SortModeButton.selected)
	elif keyword.begins_with(\"UP主:\"):
		var after = keyword.substr(4)
		var colon_idx = after.find(\":\")
		if colon_idx != -1:
			var mid = after.substr(0, colon_idx)
			var username = after.substr(colon_idx + 1)
			BilibiliApi.fetch_user_videos_medialist(mid, username, update_callback.bind(current_execution_number), page_number, 20)
		else:
			BilibiliApi.fetch_user_videos(after, update_callback.bind(current_execution_number), page_number, 30, SortModeButton.selected)
	else:
		BilibiliApi.search_bilibili(update_callback.bind(current_execution_number), keyword, 30, SortModeButton.selected, page_number, \"\", TidsButton.selected)

func update_callback(videos, execution_number := 0) -> void:
	_kill_active_tweens()
	var video_list = []
	if typeof(videos) == TYPE_DICTIONARY and videos.has(\"list\"):
		video_list = videos.list
	elif videos is Array:
		video_list = videos
	else:
		push_error(\"update_callback: 未知数据结构 \", videos)
		video_list = []
	current_count = video_list.size()
	fade_out(loading, 0.2)
	fade_out(obstacle, 0.2)
	if current_count == 0:
		fade_in(error, 0.3)
		error.texture = preload(\"res://UI/Icon/nodat.png\")
		sub_label.text = tr(\"未找任何歌曲\")
		return
	if typeof(video_list) == TYPE_ARRAY and video_list.size() > 0 and typeof(video_list[0]) == TYPE_DICTIONARY and video_list[0].is_empty():
		fade_in(error, 0.3)
		error.texture = preload(\"res://UI/Icon/neterror.png\")
		sub_label.text = tr(\"网络错误\")
		return
	sub_label.text = tr(\"已找到\") + str(current_count) + tr(\"首歌曲\")
	var total_needed = current_count
	for i in current_count:
		if execution_number != current_execution_number: return
		var video_transverse_card: BaseVideoCard
		if rsults_list.get_child_count() <= i:
			video_transverse_card = preload(\"res://Scene/VideoTransverseCard.tscn\").instantiate()
			rsults_list.add_child(video_transverse_card)
		else:
			video_transverse_card = rsults_list.get_child(i)
		var video: Dictionary = video_list[i]
		video_transverse_card.video_info = video
		video_transverse_card.title = video.get(\"title\", \"\")
		video_transverse_card.author = video.get(\"author\", \"\")
		video_transverse_card.keywords = current_keyword
		video_transverse_card.play = int(video.get(\"play\", 0))
		video_transverse_card.description = video.get(\"description\", \"\")
		video_transverse_card.link = video.get(\"bvid\", video.get(\"link\", video.get(\"BV\", \"\")))
		video_transverse_card.reset()
		if video.has(\"duration\"): video_transverse_card.duration = video.duration
		if video.get(\"is_network\", true):
			BilibiliApi.fetch_cover(video_transverse_card.link, set_cover.bind(video_transverse_card), 70, 70)
		elif FileAccess.file_exists(video_transverse_card.link.get_basename() + \".jpg\"):
			var image = Image.load_from_file(video_transverse_card.link.get_basename() + \".jpg\")
			_set_cover(ImageTexture.create_from_image(image), video_transverse_card)
		else:
			GdScriptFunc.generate_label_texture(Color.WHITE, video.get(\"title\", tr(\"本地文件\")), _set_cover.bind(video_transverse_card), null, 10, Color.BLACK, Vector2i(70, 70))
		video_transverse_card.modulate.a = 0.0
		video_transverse_card.scale = Vector2(0.9, 0.9)
		video_transverse_card.show()
		var tw = create_tween()
		active_tweens.append(tw)
		tw.tween_interval(i * 0.04)
		tw.set_parallel(true)
		tw.tween_property(video_transverse_card, \"modulate:a\", 1.0, 0.25)
		tw.tween_property(video_transverse_card, \"scale\", Vector2.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	GdScriptFunc.apply_theme_and_styles_to_node(rsults_list)
	while rsults_list.get_child_count() > total_needed:
		var extra_card = rsults_list.get_child(-1)
		fade_out(extra_card, 0.1)
		await get_tree().create_timer(0.12).timeout
		if extra_card.is_inside_tree():
			rsults_list.remove_child(extra_card)
			extra_card.queue_free()

func _set_cover(texture: Texture2D, video_card: Control) -> void:
	set_cover(\"\", texture, video_card)

func set_cover(_bvid: String, texture: Texture2D, video_card: Control) -> void:
	if is_instance_valid(video_card): video_card.cover = texture

func _on_sort_mode_item_selected(_index: int) -> void: update_page(current_keyword)
func _on_last_pressed() -> void: if page_number > 1: page_number -= 1
func _on_next_pressed() -> void: page_number += 1
func _on_page_text_submitted(new_text: String) -> void:
	var num = new_text.to_int()
	if num > 0: page_number = num
	else: page_edit.text = str(page_number)
func _on_tids_item_selected(_index: int) -> void: update_page(current_keyword)


func _on_search_text_submitted(new_text: String) -> void:
	State.main.search_bar.text=new_text
	update_page(new_text)


func _on_visibility_changed() -> void:
	if visible:
		_on_v_box_container_item_rect_changed()
	else:
		hide_search_bar()
		State.main.show_search_bar()
		on_show=false
var on_show:=false
func _on_v_box_container_item_rect_changed() -> void:
	if rsults_list.position.y>-80&&!on_show:
		State.main.hide_search_bar()
		show_search_bar()
		on_show=true
	elif rsults_list.position.y<=-80&&on_show:
		hide_search_bar()
		State.main.show_search_bar()
		on_show=false
"

