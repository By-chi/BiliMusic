[sub_resource type="GDScript" id="GDScript_6a8me"]
script/source = "extends Panel

@export var cover_node:TextureRect
@export var title_label: Label
@export var author_label: Label
@export var play_button: Button
@export var progress_bar: HSlider
var cover: Texture2D:
	set(value):
		if value == null: return
		cover = value
		cover_node.show()
		cover_node.texture = value
		#cover_node.modulate.a = 0.0
		#var tween := cover_node.create_tween()
		#tween.tween_property(cover_node, \"modulate:a\", 1.0, 1)
var title: String = \"\":
	set(value):
		title = value
		title_label.text = value
var author: String = \"\":
	set(value):
		author = value
		author_label.text = value


func _on_progress_drag_ended(value_changed: bool) -> void:
	if !value_changed: return
	play_button.button_pressed=true
	Player.seek_percentage(progress_bar.value/100.)
	progress_lock=false
func _physics_process(_delta: float) -> void:
	if !progress_lock&&visible:
		progress_bar.value=Player.get_current_percentage()*100.
var progress_lock:=false
func _on_progress_drag_started() -> void:
	progress_lock=true


func _on_play_toggled(toggled_on: bool) -> void:
	if toggled_on:
		play_button.icon=preload(\"res://UI/Icon/pause.svg\")
		Player.resume()
		
	else:
		play_button.icon=preload(\"res://UI/Icon/play.svg\")
		Player.pause()
"

