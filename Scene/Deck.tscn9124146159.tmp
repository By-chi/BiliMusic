[sub_resource type="GDScript" id="GDScript_leq5y"]
script/source = "extends Control

const ANGLES:=[-5,0,6,13.5]
@export var cards:Array[TextureRect]
@export var text_node:LineEdit
@export var target_bottom_y: float = 258.0 

var videos:Array
var directory_name:=\"\":
	set(value):
		directory_name=value
		text_node.text=directory_name

var lift_distance: float = 58.0
var hovered_index := -1 
var is_ready := false 

# 懒更新：记录每个卡片当前对应的视频链接
var _card_links: Array[String] = [\"\", \"\", \"\", \"\"]

func _ready() -> void:
	# 播放初始入场动画（不再使用缓存的 base_y_array，而是实时计算）
	var intro_tween = create_tween()
	for i in cards.size():
		var target_y = target_bottom_y - cards[i].size.y
		intro_tween.tween_property(cards[i], \"position:y\", target_y, 0.1)
		
	# 入场动画播放完毕后，才开启防抽搐的状态机
	intro_tween.finished.connect(func(): is_ready = true)
	
	# 初始加载封面（使用懒更新逻辑）
	_update_covers()

# 懒更新封面：仅当链接变化时才重新拉取
func _update_covers() -> void:
	for i in min(videos.size(), cards.size()):
		var new_link = videos[i][\"link\"]
		if _card_links[i] != new_link:
			_card_links[i] = new_link
			BilibiliIc.fetch_cover(new_link, set_cover.bind(i),cards[i].size)
	# 如果视频数量少于卡片数量，将多余的卡片链接置空（可选，不清除纹理）
	for i in range(videos.size(), cards.size()):
		_card_links[i] = \"\"

# 外部调用：当 videos 被修改后，调用此方法刷新封面
func refresh_covers() -> void:
	if not is_inside_tree():
		return
	_update_covers()

func set_cover(_bvid:String, texture:Texture2D,id:int)->void:
	if id < cards.size() and is_instance_valid(cards[id]):
		cards[id].texture=texture

func _process(delta: float) -> void:
	if not is_ready:
		return
	if not hovering:
		return  # 已经复位，无需再做任何事
	
	# 以下只有 hovering == true 时执行
	var local_mouse = get_local_mouse_position()
	var new_hovered_index := -1
	if local_mouse.x > 136.5 and local_mouse.x < 411.74:
		var region_width = 275.24 / float(cards.size())
		var idx = int(floor((local_mouse.x - 136.5) / region_width))
		new_hovered_index = clamp(idx, 0, cards.size() - 1)
	
	if new_hovered_index != hovered_index:
		hovered_index = new_hovered_index
	
	var lerp_speed = 15.0
	for i in cards.size():
		var current_base_y = target_bottom_y - cards[i].size.y
		var target_y = current_base_y
		if i == hovered_index:
			target_y -= lift_distance
		cards[i].position.y = lerpf(cards[i].position.y, target_y, lerp_speed * delta)
		
		var target_alpha = 1.0
		if hovered_index != -1 and i < hovered_index:
			target_alpha = 0.1 / (hovered_index + 1)
		cards[i].modulate.a = lerpf(cards[i].modulate.a, target_alpha, lerp_speed * delta)
var hovering:=false
func _on_mouse_entered() -> void:
	var tween:=create_tween()
	tween.tween_method(func(value):
		for i in ANGLES.size():
			cards[i].rotation_degrees=ANGLES[i]*value
		text_node.modulate.a=1-value
	,0.,1.,0.3).set_trans(Tween.TRANS_CUBIC)
	hovering=true
func _on_mouse_exited() -> void:
	# 原有的旋转/文字动画
	var tween := create_tween()
	tween.tween_method(func(value):
		for i in ANGLES.size():
			cards[i].rotation_degrees = ANGLES[i] * value
		text_node.modulate.a = 1 - value
	, 1.0, 0.0, 0.3).set_trans(Tween.TRANS_CUBIC)
	
	# 复位卡片位置和透明度（可选平滑过渡）
	for i in cards.size():
		var base_y = target_bottom_y - cards[i].size.y
		var target_pos = Vector2(cards[i].position.x, base_y)
		var target_alpha = 1.0
		# 使用另一个 tween 让复位也平滑（不会与上面的 tween 冲突）
		var reset_tween = create_tween()
		reset_tween.tween_property(cards[i], \"position\", target_pos, 0.2)
		reset_tween.parallel().tween_property(cards[i], \"modulate:a\", target_alpha, 0.2)
	
	hovering = false
	hovered_index = -1  # 关键：重置悬停索引
func _on_name_text_submitted(new_text: String) -> void:
	if GdScriptFunc.set_key(\"Favorites\",directory_name,new_text):
		directory_name=new_text #此处setter有重复操作,但无影响
		text_node.release_focus()
	else:
		text_node.text=directory_name
"

