script/source = "extends Window

@export var bottom_menu: Control
@export var drag_strip:Sprite2D
@export var drag_bar:Button
@export var card: Panel
var performance_node: Node

var mouse_in_top := false
var click_position := Vector2(-1, -1)   # 全局鼠标坐标
var drag_position := Vector2(-1, -1)    # 窗口全局位置
var mouse_press := false
var move_to_position := Vector2(-1, -1)
var move_sleep := false


func _ready() -> void:
	var path: String = GdScriptFunc.get_data(\"Options\", \"Custom_PiP_Theme\", \"\")
	if path != \"\":
		performance_node = load(path).instantiate()
	else:
		performance_node = preload(\"res://PiPTheme/WaveCrease.tscn\").instantiate()
	GdScriptFunc.apply_theme_and_styles_to_node(performance_node)
	performance_node.bottomMenu = bottom_menu
	card.add_child(performance_node)
	card.move_child(performance_node, 0)
	Player.song_changed.connect(func(video_info: Dictionary): update(bottom_menu.list_name, null, video_info))


	# 恢复上次保存的窗口位置
	var saved_pos = GdScriptFunc.get_data(\"Card\", \"Position\", null)
	if saved_pos != null and saved_pos is Vector2i:
		position = saved_pos

	# 延迟一帧后设置穿透区域，确保窗口尺寸已就绪
	await get_tree().process_frame
	update_click_through(20.0)

func TopMouseEntered() -> void:
	if mouse_press:
		return
	mouse_in_top = true
	var tween := create_tween().set_parallel()
	drag_strip.position.x=drag_bar.size.x / 2.0
	tween.tween_property(drag_strip, \"position:y\", drag_bar.size.y / 2.0, 0.2)
	tween.tween_property(drag_strip, \"scale\", Vector2.ONE, 0.2)
	tween.tween_property(drag_strip, \"modulate:a\", 1.0, 0.2)


func TopMouseExited() -> void:
	if mouse_press:
		return
	mouse_in_top = false
	var tween := create_tween().set_parallel()
	tween.tween_property(drag_strip, \"position:y\", 0.0, 0.2)
	tween.tween_property(drag_strip, \"scale\", Vector2(0.3, 0.0), 0.2)
	tween.tween_property(drag_strip, \"modulate:a\", 0.0, 0.2)
	PiP_Smooth_Motion_Interpolation=GdScriptFunc.get_data(\"Options\",\"PiP_Smooth_Motion_Interpolation\",15.0)

func update_click_through(reserve: float) -> void:
	var rect := Rect2(Vector2.ZERO, size)
	var poly := PackedVector2Array([
		rect.position - Vector2(reserve, reserve),
		Vector2(rect.end.x + reserve, rect.position.y - reserve),
		rect.end + Vector2(reserve, reserve),
		Vector2(rect.position.x - reserve, rect.end.y + reserve)
	])
	mouse_passthrough_polygon = poly

func _input(event: InputEvent) -> void:
	# 原有按键处理
	if event is InputEventKey:
		if Input.is_action_just_released(\"ShowHideBottomMenu\"):
			bottom_menu.visible = !bottom_menu.visible
		Player._input(event)

	# 拖拽鼠标按键处理
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			if mouse_in_top:
				click_position = Vector2(DisplayServer.mouse_get_position())          # 全局坐标
				drag_position = Vector2(position)                     # 窗口当前全局位置
				move_to_position = drag_position
				mouse_press = true
				move_sleep = false
				TopMouseEntered()   # 保持拖拽条可见
				mouse_passthrough_polygon = PackedVector2Array()      # 拖拽时不允许穿透
		else:
			if mouse_press:
				mouse_press = false
				TopMouseExited()   # 还原拖拽条
				update_click_through(20.0)
var PiP_Smooth_Motion_Interpolation:float=15
func _process(_delta: float) -> void:
	if drag_position == Vector2(-1, -1):
		return
	if mouse_press:
		# 按住时实时跟随鼠标（全局坐标计算）
		move_to_position = Vector2(DisplayServer.mouse_get_position()) - click_position + drag_position
		var current_pos := Vector2(position)
		if current_pos.distance_squared_to(move_to_position) >= 2.0:
			var new_pos := current_pos.lerp(move_to_position, PiP_Smooth_Motion_Interpolation*0.01)
			position = Vector2i(new_pos.round())
	elif not move_sleep:
		var current_pos := Vector2(position)
		if current_pos.distance_squared_to(move_to_position) >= 16.0:   # 4
			var new_pos := current_pos.lerp(move_to_position, PiP_Smooth_Motion_Interpolation*0.01)
			position = Vector2i(new_pos.round())
			update_click_through(20.0)
		else:
			position = Vector2i(move_to_position.round())
			GdScriptFunc.set_data(\"Card\", \"Position\", position)
			move_sleep = true
			update_click_through(20.0)

func update(list_name: String, cover, video_info: Dictionary) -> void:
	bottom_menu.show()
	bottom_menu.play_button.button_pressed = true
	bottom_menu.init_ui()
	bottom_menu.list_name = list_name
	bottom_menu.update_callback(video_info)
	performance_node.update()
	_on_visibility_changed()


func update_performance_node(new_theme_path: String) -> void:
	if performance_node != null:
		if performance_node.has_method(\"Stop\"):
			performance_node.Stop()
		performance_node.queue_free()
		performance_node = null

	if new_theme_path != \"\":
		performance_node = load(new_theme_path).instantiate()
	else:
		performance_node = preload(\"res://PiPTheme/WaveCrease.tscn\").instantiate()
	GdScriptFunc.apply_theme_and_styles_to_node(performance_node)
	performance_node.bottomMenu = bottom_menu
	card.add_child(performance_node)
	card.move_child(performance_node, 0)
	performance_node.update()
	if visible:
		performance_node.call(\"Start\")
		if mode == Window.MODE_MINIMIZED:
			performance_node.call(\"set_ECO_mode\", true)


func _on_close_requested() -> void:
	State.play_ui_mode = 0
	var node: Panel = get_node(\"/root/Main\").bottom_menu
	node.show()
	node.init_ui()
	node.update_callback(Player.get_current_video_info())
	hide()


func _notification(what: int) -> void:
	if performance_node == null:
		return
	performance_node.call(\"set_ECO_mode\", mode == MODE_MINIMIZED)


func _on_visibility_changed() -> void:
	if performance_node != null and visible:
		performance_node.call(\"Start\")
"

