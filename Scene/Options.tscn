[gd_scene format=3 uid="uid://g3lqi52kbx7q"]

[sub_resource type="GDScript" id="GDScript_nmc4f"]
script/source = "extends Panel
@export var page_buttons:Array[Button]
@export var current_page:Control
@export var current_page_name:String
@export var bottom_menu:Panel
@export var ui_sound:AudioStreamPlayer
@export var icon:TextureRect
@export var progress_bar:Panel
@export var search_bar:LineEdit
const PAGE_SCENES := {
	\"Discover\": \"res://Scene/Discover.tscn\",
	\"Results\": \"res://Scene/Results.tscn\",
	\"Favorites\": \"res://Scene/Favorites.tscn\",
	\"Import\": \"res://Scene/Import.tscn\",
	\"Options\": \"res://Scene/Options.tscn\",
}
const EPHEMERAL_PAGES := [\"Import\"]
var _scene_cache := {}

func _apply_startup_settings() -> void:
	var lang_codes = [\"zh\", \"en\", \"ja\"]
	var saved_code: String = GdScriptFunc.get_data(\"Options\", \"Language\", \"\")
	var current_locale: String = TranslationServer.get_locale()
	if saved_code == \"\" or not (saved_code in lang_codes):
		var matched := false
		for code in lang_codes:
			if code == current_locale:
				saved_code = code
				matched = true
				break
		if not matched:
			saved_code = lang_codes[0]
	TranslationServer.set_locale(saved_code)
	var skin_name: String = GdScriptFunc.get_data(\"Options\", \"Skin\", \"\")
	skin_name = skin_name.trim_suffix(\"/\").get_file()
	if skin_name == \"\":
		var skin_dirs: Array[String] = []
		for base in [\"res://Skin/\", \"user://Skin/\"]:
			if DirAccess.dir_exists_absolute(base):
				var dir = DirAccess.open(base)
				if dir:
					dir.list_dir_begin()
					var item = dir.get_next()
					while item != \"\":
						if dir.current_is_dir() and item != \".\" and item != \"..\":
							if not skin_dirs.has(item):
								skin_dirs.append(item)
						item = dir.get_next()
					dir.list_dir_end()
		skin_dirs.sort()
		if skin_dirs.size() > 0:
			skin_name = skin_dirs[0]
	if skin_name != \"\":
		GdScriptFunc.update_skin_theme(skin_name)
	if GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") == null:
		icon.texture = preload(\"res://UI/DefaultprofilePicture.png\")
	else:
		BilibiliApi.fetch_user_avatar(func(tex: ImageTexture):
			if tex != null and is_instance_valid(icon):
				icon.texture = tex
		)
	GdScriptFunc.traverse_iterative_no_text_ui(get_tree().root)

func _ensure_page(page_name: String) -> Control:
	if has_node(page_name):
		return get_node(page_name)
	var scene: PackedScene = _scene_cache.get(page_name)
	if scene == null:
		var path = PAGE_SCENES.get(page_name)
		if path == null:
			push_error(\"未知页面: %s\" % page_name)
			return null
		scene = load(path) as PackedScene
		if scene == null:
			push_error(\"页面场景加载失败: %s\" % path)
			return null
		_scene_cache[page_name] = scene
	var page: Control = scene.instantiate()
	if page == null:
		push_error(\"页面场景实例化失败: %s\" % page_name)
		return null
	page.name = page_name
	page.visible = false
	page.offset_transform_enabled = true
	add_child(page)
	move_child(page, get_node(\"BottomMenu\").get_index())
	return get_node(page_name)

func play(card:BaseVideoCard)->void:
	Player.play_by_video_info(card.video_info)
	var i:=0
	while card.cover == null&&i!=1000:
		await get_tree().process_frame
		i+=1
	match State.play_ui_mode:
		0:
			bottom_menu._show()
			if bottom_menu.play_window!=null:
				bottom_menu.play_window.hide()
			bottom_menu.play_button.button_pressed=true
			bottom_menu.title=card.title
			bottom_menu.progress_bar.value=0
			bottom_menu.author=card.author
			bottom_menu.cover=card.cover
			bottom_menu.list_name=card.list_name
		1:
			bottom_menu._hide()
			bottom_menu.play_window.show()
			bottom_menu.play_window.update(card.list_name,card.cover,card.video_info)

func _init() -> void:
	State.main=self

func _ready() -> void:
	current_page = _ensure_page(\"Discover\")
	if current_page != null:
		current_page.show()
		current_page_name = \"Discover\"
	get_window().size_changed.connect(func():
		var window := get_window()
		if window.mode == Window.MODE_WINDOWED:
			GdScriptFunc.set_data(\"Window\",\"Size\",window.size)
			GdScriptFunc.set_data(\"Window\",\"Position\",window.position,true)
	)
	get_window().close_requested.connect(func():
		var window := get_window()
		if window.mode == Window.MODE_WINDOWED:
			GdScriptFunc.set_data(\"Window\",\"Size\",window.size)
			GdScriptFunc.set_data(\"Window\",\"Position\",window.position,true)
		get_tree().quit()
	)
	get_window().min_size=Vector2i(1285,262)
	for button in page_buttons:
		if button != null and not button.pressed.is_connected(change_page.bind(button.name)):
			button.connect(\"pressed\",change_page.bind(button.name))
	_startup_sequence()

func _startup_sequence() -> void:
	await get_tree().process_frame
	if not is_inside_tree():
		return
	_apply_startup_settings()
	for page_name in PAGE_SCENES:
		if page_name == \"Discover\":
			continue
		if _scene_cache.has(page_name):
			continue
		await get_tree().process_frame
		if not is_inside_tree():
			return
		var path: String = PAGE_SCENES[page_name]
		var scene := load(path) as PackedScene
		if scene != null:
			_scene_cache[page_name] = scene
		else:
			push_error(\"页面场景预加载失败: %s\" % path)

func show_search_bar()->void:
	var tween:=search_bar.create_tween()
	tween.tween_property(search_bar,\"offset_transform_scale:x\",1.0,0.3).set_trans(Tween.TRANS_CUBIC)

func hide_search_bar()->void:
	var tween:=search_bar.create_tween()
	tween.tween_property(search_bar,\"offset_transform_scale:x\",0,0.3).set_trans(Tween.TRANS_CUBIC)

var is_switching := false

func change_page(page_name: String) -> void:
	if page_name == current_page_name:
		return
	if is_switching:
		return
	if not PAGE_SCENES.has(page_name):
		return
	is_switching = true

	var page_numbers := {
		\"Discover\": 0,
		\"Results\": 1,
		\"Favorites\": 2,
		\"Import\": 3,
		\"Options\": 4,
	}
	var last_page_number: int = page_numbers.get(current_page_name, -1)
	var current_page_number: int = page_numbers.get(page_name, -1)
	var long_position := current_page.size.y + 300
	if last_page_number < current_page_number:
		long_position = -long_position
	var last_page_tween = get_tree().create_tween()
	last_page_tween.tween_property(
		current_page, \"offset_transform_position:y\",
		long_position, 0.25
	).set_trans(Tween.TRANS_CUBIC)
	last_page_tween.parallel().tween_property(
		current_page, \"modulate:a\", 0.0, 0.22
	).set_trans(Tween.TRANS_CUBIC)
	var leaving_page := current_page
	last_page_tween.finished.connect(func():
		leaving_page.hide()
		leaving_page.modulate.a = 1.0
		if leaving_page.name in EPHEMERAL_PAGES:
			leaving_page.queue_free()
	, CONNECT_ONE_SHOT)
	var next_page := _ensure_page(page_name)
	if next_page == null:
		is_switching = false
		return
	current_page = next_page
	current_page_name = page_name
	current_page.show()
	current_page.modulate.a = 0.0
	current_page.offset_transform_position = Vector2(0, -long_position)
	var current_page_tween = get_tree().create_tween()
	current_page_tween.tween_property(
		current_page, \"offset_transform_position:y\",
		0.0, 0.25
	).set_trans(Tween.TRANS_CUBIC)
	current_page_tween.parallel().tween_property(
		current_page, \"modulate:a\", 1.0, 0.25
	).set_trans(Tween.TRANS_CUBIC)
	current_page_tween.finished.connect(func(): is_switching = false)

func _on_search_text_submitted(new_text: String) -> void:
	var node:Control=_ensure_page(\"Results\")
	if node == null:
		return
	node.search_bar.text=new_text
	node.update_page(new_text)
	change_page(\"Results\")
"

