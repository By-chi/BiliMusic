[gd_scene format=3 uid="uid://g3lqi52kbx7q"]

[sub_resource type="GDScript" id="GDScript_nmc4f"]
script/source = "extends Control
@export var OptionsTabContainer: TabContainer
@export var ClearCoversCache: Button
@export var ClearLyricsCache: Button
@export var BuiltinThemes: Array[String]
@export var BuiltinPiPThemes: Array[String]
var _setting_controls: Dictionary = {}

func _ready() -> void:
	for scroll in OptionsTabContainer.get_children():
		if not scroll is ScrollContainer:
			continue
		var vbox = scroll.get_child(0)
		if not vbox:
			continue
		for option in vbox.get_children():
			var control: Node = null
			if option is CheckButton:
				control = option
			elif option.get_child_count() > 0:
				control = option.get_child(0)
			else:
				printerr(\"设置项 %s 没有可用的子控件\" % option.name)
				continue

			if option.name == \"Account\":
				_setup_account(option, control)
			elif option.name == \"Skin\":
				_setup_skin(control as OptionButton)
			elif option.name == \"Custom_Big_Window_Theme\":
				_setup_big_window_theme(control as OptionButton)
			elif option.name == \"Custom_PiP_Theme\":  # 新增：PiP主题选项
				_setup_pip_theme(control as OptionButton)
			elif option.name == \"Language\":
				_setup_language(option, control as OptionButton)
			else:
				_setup_generic(option, control)

			_setting_controls[option.name] = control
	GdScriptFunc.traverse_iterative_no_text_ui(get_tree().root)
	_update_cache_size()
	
func _setup_language(option: Control, option_button: OptionButton) -> void:
	# 使用有序数组，确保名称和代码一一对应
	var lang_names = [\"中文\", \"English\", \"日本語\"]
	var lang_codes = [\"zh\", \"en\", \"ja\"]

	option_button.clear()
	var option_popup = option_button.get_popup()
	option_popup.add_theme_font_size_override(\"font_size\", 35)
	for lang_name in lang_names:
		option_button.add_item(lang_name)

	# 读取保存的语言代码，若没有则使用系统语言
	var saved_code = GdScriptFunc.get_data(\"Options\", \"Language\", \"\")
	var current_locale = TranslationServer.get_locale()
	var final_code = saved_code

	# 确定最终语言代码（确保在列表中）
	if final_code == \"\" or not (final_code in lang_codes):
		var matched = false
		for code in lang_codes:
			if code == current_locale:
				final_code = code
				matched = true
				break
		if not matched:
			final_code = lang_codes[0]  # 默认第一个（中文）

	# 计算选中索引
	var idx = lang_codes.find(final_code)
	if idx == -1:
		idx = 0
		final_code = lang_codes[idx]

	option_button.selected = idx
	TranslationServer.set_locale(final_code)

	# 连接切换信号（保存并立即生效）
	option_button.item_selected.connect(func(index: int):
		var selected_code = lang_codes[index]
		GdScriptFunc.set_data(\"Options\", \"Language\", selected_code, true)
		TranslationServer.set_locale(selected_code)
		GdScriptFunc.traverse_iterative_no_text_ui(get_tree().root)
		_update_cache_size()
	)
func _setup_account(option: Control, button: Button) -> void:
	var sessdata = GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\")
	if sessdata == null:
		button.text = tr(\"点击登陆\")
		get_node(\"/root/Main\").icon.texture = preload(\"res://UI/Icon/bilibili.svg\")
	else:
		button.text = tr(\"退出登陆\")
		BilibiliApi.fetch_user_avatar(func(tex: ImageTexture):
			if tex != null:
				get_node(\"/root/Main\").icon.texture = tex
		)
	button.pressed.connect(_log_in_out.bind(option))

func _setup_skin(option_button: OptionButton) -> void:
	# 设置OptionButton字体大小
	var option_popup = option_button.get_popup()
	option_popup.add_theme_font_size_override(\"font_size\", 35)
	
	
	var skin_dict: Dictionary = {}

	var res_path = \"res://Skin/\"
	var res_dirs: Array = []
	if DirAccess.dir_exists_absolute(res_path):
		var dir = DirAccess.open(res_path)
		if dir:
			dir.list_dir_begin()
			var item = dir.get_next()
			while item != \"\":
				if dir.current_is_dir() and item != \".\" and item != \"..\":
					res_dirs.append(item)
				item = dir.get_next()
			dir.list_dir_end()
	res_dirs.sort()
	for d in res_dirs:
		skin_dict[d] = res_path.path_join(d) + \"/\"

	var user_path = \"user://Skin/\"
	if DirAccess.dir_exists_absolute(user_path):
		var dir = DirAccess.open(user_path)
		if dir:
			dir.list_dir_begin()
			var item = dir.get_next()
			while item != \"\":
				if dir.current_is_dir() and item != \".\" and item != \"..\":
					# 外部同名文件夹覆盖内部
					skin_dict[item] = user_path.path_join(item) + \"/\"
				item = dir.get_next()
			dir.list_dir_end()

	# 转换为并行数组
	var skin_names: Array = []
	var skin_paths: Array = []
	for skin_name in skin_dict:
		skin_names.append(skin_name)
		skin_paths.append(skin_dict[skin_name])

	skin_names.sort()
	var sorted_paths: Array = []
	for skin_name in skin_names:
		sorted_paths.append(skin_dict[skin_name])

	for d in skin_names:
		option_button.add_item(d)

	# 恢复上次选中的皮肤
	var saved_path = GdScriptFunc.get_data(\"Options\", \"Skin\", \"\")
	if saved_path == \"\" and skin_names.size() > 0:
		saved_path = sorted_paths[0]
	var idx = sorted_paths.find(saved_path)
	if idx == -1:
		idx = 0
	option_button.selected = idx
	var selected_name = skin_names[idx] if idx < skin_names.size() else \"\"
	var selected_path = sorted_paths[idx] if idx < skin_paths.size() else \"\"
	if selected_path != \"\":
		GdScriptFunc.update_skin_theme(selected_name)  # 如果你需要传递路径，需修改该函数

	option_button.item_selected.connect(func(index: int):
		var chosen_path = sorted_paths[index]
		GdScriptFunc.set_data(\"Options\", \"Skin\", chosen_path, true)
		var chosen_name = skin_names[index]
		GdScriptFunc.update_skin_theme(chosen_name)  # 同样可能需要路径
		GdScriptFunc.update_marks_theme_and_styles()
	)
func _setup_pip_theme(option_button: OptionButton) -> void:
	# 设置OptionButton字体大小
	var option_popup = option_button.get_popup()
	option_popup.add_theme_font_size_override(\"font_size\", 35)
	
	const BUILTIN_DIR = \"res://PiPTheme/\"

	var theme_dict: Dictionary = {}
	for theme_name in BuiltinPiPThemes:  # 使用新导出的数组
		theme_dict[theme_name] = BUILTIN_DIR.path_join(theme_name + \".tscn\")

	var user_dir = \"user://PiPTheme/\"
	if DirAccess.dir_exists_absolute(user_dir):
		var dir = DirAccess.open(user_dir)
		if dir:
			dir.list_dir_begin()
			var file = dir.get_next()
			while file != \"\":
				if not dir.current_is_dir() and file.ends_with(\".tscn\"):
					var theme_name = file.trim_suffix(\".tscn\")
					var theme_path = user_dir.path_join(file)
					theme_dict[theme_name] = theme_path   # 外部覆盖
				file = dir.get_next()
			dir.list_dir_end()

	var theme_names: Array = []
	var theme_paths: Array = []
	for theme_name in theme_dict:
		theme_names.append(theme_name)
		theme_paths.append(theme_dict[theme_name])

	if theme_names.is_empty():
		option_button.add_item(tr(\"暂无可用主题\"))
		option_button.disabled = true
		return

	var sorted = theme_names.duplicate()
	sorted.sort()
	option_button.clear()
	for theme_name in sorted:
		option_button.add_item(theme_name)

	var sorted_paths: Array = []
	for theme_name in sorted:
		sorted_paths.append(theme_dict[theme_name])

	var saved_path = GdScriptFunc.get_data(\"Options\", \"Custom_PiP_Theme\", \"\")
	var idx = sorted_paths.find(saved_path)
	if idx == -1:
		idx = 0
	option_button.selected = idx

	# 选择新主题时同步更新已打开的 PiP 窗口
	option_button.item_selected.connect(func(index: int):
		var selected_path = sorted_paths[index]
		GdScriptFunc.set_data(\"Options\", \"Custom_PiP_Theme\", selected_path, true)
		var main = get_node(\"/root/Main\")
		if main and main.bottom_menu and main.bottom_menu.play_window and main.bottom_menu.play_window_mode==\"PiP\":
			main.bottom_menu.play_window.update_pip_theme(selected_path)
	)
func _setup_big_window_theme(option_button: OptionButton) -> void:
	# 设置OptionButton字体大小
	var option_popup = option_button.get_popup()
	option_popup.add_theme_font_size_override(\"font_size\", 35)
	
	const BUILTIN_DIR = \"res://BigWindowTheme/\"

	var theme_dict: Dictionary = {}
	for theme_name in BuiltinThemes:
		theme_dict[theme_name] = BUILTIN_DIR.path_join(theme_name + \".tscn\")

	var user_dir = \"user://BigWindowTheme/\"
	if DirAccess.dir_exists_absolute(user_dir):
		var dir = DirAccess.open(user_dir)
		if dir:
			dir.list_dir_begin()
			var file = dir.get_next()
			while file != \"\":
				if not dir.current_is_dir() and file.ends_with(\".tscn\"):
					var theme_name = file.trim_suffix(\".tscn\")
					var theme_path = user_dir.path_join(file)
					theme_dict[theme_name] = theme_path   # 外部覆盖
				file = dir.get_next()
			dir.list_dir_end()

	var theme_names: Array = []
	var theme_paths: Array = []
	for theme_name in theme_dict:
		theme_names.append(theme_name)
		theme_paths.append(theme_dict[theme_name])

	if theme_names.is_empty():
		option_button.add_item(tr(\"暂无可用主题\"))
		option_button.disabled = true
		return

	var sorted = theme_names.duplicate()
	sorted.sort()
	option_button.clear()
	for theme_name in sorted:
		option_button.add_item(theme_name)

	var sorted_paths: Array = []
	for theme_name in sorted:
		sorted_paths.append(theme_dict[theme_name])

	var saved_path = GdScriptFunc.get_data(\"Options\", \"Custom_Big_Window_Theme\", \"\")
	var idx = sorted_paths.find(saved_path)
	if idx == -1:
		idx = 0
	option_button.selected = idx

	#选择新主题时同时更新已打开的大窗口
	option_button.item_selected.connect(func(index: int):
		var selected_path = sorted_paths[index]
		GdScriptFunc.set_data(\"Options\", \"Custom_Big_Window_Theme\", selected_path, true)
		#动态刷新已经打开的大窗口主题
		var main = get_node(\"/root/Main\")
		if main and main.bottom_menu and main.bottom_menu.play_window and main.bottom_menu.play_window_mode==\"BigWindow\":
			main.bottom_menu.play_window.update_performance_node(selected_path)
	)

func _setup_generic(option: Control, control: Node) -> void:
	var key = option.name
	match control.get_class():
		\"CheckButton\":
			var check = control as CheckButton
			check.button_pressed = GdScriptFunc.get_data(\"Options\", key, check.button_pressed)
			check.toggled.connect(_on_option_change.bind(option, check))
		\"LineEdit\":
			var line_edit = control as LineEdit
			line_edit.text = GdScriptFunc.get_data(\"Options\", key, line_edit.text)
			line_edit.focus_exited.connect(_on_option_change.bind(option, line_edit))
			line_edit.text_submitted.connect(_on_option_change.bind(option, line_edit))
		\"HSlider\":
			var h_slider = control as HSlider
			h_slider.value = GdScriptFunc.get_data(\"Options\", key, h_slider.value)
			h_slider.drag_ended.connect(
				func(value_changed: bool):
					if value_changed:
						_on_option_change(h_slider.value,option, h_slider)
			)
		_:
			printerr(\"未知控件类型 %s 用于设置项 %s\" % [control.get_class(), key])

func _on_option_change(new_value: Variant, option: Control, control: Node) -> void:
	var key = option.name
	GdScriptFunc.set_data(\"Options\", key, new_value, true)

func _log_in_out(option: Control) -> void:
	var button = option.get_child(0)
	if GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") != null:
		GdScriptFunc.set_data(\"AccountData\", \"SESSDATA\", null, true)
		GdScriptFunc.set_data(\"AccountData\", \"bili_jct\", null, true)
		GdScriptFunc.set_data(\"AccountData\", \"DedeUserID\", null, true)
		GdScriptFunc.set_data(\"AccountData\", \"DedeUserID__ckMd5\", null, true)
		GdScriptFunc.set_data(\"AccountData\", \"sid\", null, true)
		button.text = tr(\"点击登陆\")
		get_node(\"/root/Main\").icon.texture = preload(\"res://UI/Icon/bilibili.svg\")
	else:
		BilibiliApi.start_qr_login(
			func(success: bool):
				if success:
					button.text = tr(\"退出登陆\")
					BilibiliApi.fetch_user_avatar(func(tex: ImageTexture):
						if tex != null:
							get_node(\"/root/Main\").icon.texture = tex
					)
		)

func _on_clear_covers_cache_pressed() -> void:
	delete_directory_contents(\"user://bilibili_cover_cache/\")
	_update_cache_size()

func _on_clear_lyrics_cache_pressed() -> void:
	delete_directory_contents(\"user://lyrics/\")
	_update_cache_size()

func delete_directory_contents(path: String) -> bool:
	var dir = DirAccess.open(path)
	if dir == null:
		printerr(\"无法打开目录: \", path)
		return false
	dir.list_dir_begin()
	var file_name = dir.get_next()
	while file_name != \"\":
		var child_path = path.path_join(file_name)
		if dir.current_is_dir():
			if file_name != \".\" and file_name != \"..\":
				if delete_directory_contents(child_path):
					DirAccess.remove_absolute(child_path)
		else:
			DirAccess.remove_absolute(child_path)
		file_name = dir.get_next()
	dir.list_dir_end()
	return true

func _update_cache_size() -> void:
	if DirAccess.dir_exists_absolute(\"user://bilibili_cover_cache/\"):
		var cache_size = CSharpFunc.GetDirectorySize(ProjectSettings.globalize_path(\"user://bilibili_cover_cache/\"))
		ClearCoversCache.text = tr(\"清理封面缓存(%.2fMB)\") % cache_size
	if DirAccess.dir_exists_absolute(\"user://lyrics/\"):
		var cache_size = CSharpFunc.GetDirectorySize(ProjectSettings.globalize_path(\"user://lyrics/\"))
		ClearLyricsCache.text = tr(\"清理歌词缓存(%.2fMB)\") % cache_size

func _on_visibility_changed() -> void:
	_update_cache_size()
"

