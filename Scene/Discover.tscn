[node name="SubLabel" type="Label" parent="ScrollContainer/VBoxContainer/Label" unique_id=345127570 groups=["color_font_color"]]
layout_mode = 1
offset_top = 78.0
offset_right = 201.0
offset_bottom = 112.0
theme_override_font_sizes/font_size = 24
text = "从众多UP主中推荐"

[node name="CDTimer" type="Timer" parent="ScrollContainer" unique_id=520375900]
wait_time = 0.5
one_shot = true
autostart = true

[node name="PopupMenu" type="PopupMenu" parent="." unique_id=1050700338]

[node name="AddButton" type="Button" parent="." unique_id=149532550 groups=["color_icon_hover_color", "color_icon_normal_color", "color_icon_pressed_color"]]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -95.0
offset_top = -80.0
offset_right = -15.0
grow_horizontal = 0
grow_vertical = 0
tooltip_text = "添加UP视频列表"
icon = ExtResource("1_6vwaf")
expand_icon = true

[connection signal="gui_input" from="ScrollContainer" to="." method="_on_scroll_container_gui_input"]
[connection signal="mouse_entered" from="ScrollContainer" to="." method="_on_scroll_container_mouse_entered"]
[connection signal="mouse_exited" from="ScrollContainer" to="." method="_on_scroll_container_mouse_exited"]
[connection signal="timeout" from="ScrollContainer/CDTimer" to="." method="_on_cd_timer_timeout"]
