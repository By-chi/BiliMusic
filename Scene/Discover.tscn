[ext_resource type="Texture2D" uid="uid://bq8p42egv625x" path="res://UI/Icon/add.svg" id="1_6vwaf"]
[ext_resource type="Texture2D" uid="uid://cukuuxdt3d351" path="res://UI/Icon/Windmill.svg" id="2_w1ald"]
