[gd_scene format=3 uid="uid://h8qr8p6khg63"]

[ext_resource type="Texture2D" uid="uid://bq8p42egv625x" path="res://UI/Icon/add.svg" id="1_6vwaf"]

[sub_resource type="GDScript" id="GDScript_61i7r"]
script/source = "extends Control

@export var list_box: VBoxContainer
@export var scroll_container: ScrollContainer
@export var ups: Array[String] = []
@export var add_button: Button

var up_nodes: Array[Label] = []
var up_preview_visible_id := 0

const DRAG_THRESHOLD := 10.0

var _press_node: Control = null
var _press_pos := Vector2.ZERO
var _dragging := false
var _drag_preview: Control = null
var _suppress_next_click := false
var _hint_label: Label
var _insert_line: ColorRect

@export var time_cd: Timer
var is_vertical_sliding := false:
	set(value):
		if value == is_vertical_sliding:
			return
		is_vertical_sliding = value
		for node in up_nodes:
			var inner_scroll := node.get_node_or_null(\"ScrollContainer\")
			if inner_scroll:
				inner_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE if value else Control.MOUSE_FILTER_STOP
var is_on_vertical_scroll := false


func _ready() -> void:
	var saved: Variant = GdScriptFunc.get_data(\"DiscoverPage\", \"ups\", null)
	if saved is Array and not saved.is_empty():
		var cleaned: Array[String] = []
		for item in saved:
			if item is String and not item.is_empty() and item.is_valid_utf8() if item is PackedByteArray else (item is String and not item.is_empty()):
				cleaned.append(item)
		if not cleaned.is_empty():
			ups = cleaned

	for mid in ups:
		_setup_up_node(mid)

	_build_edit_ui()

	if add_button:
		add_button.pressed.connect(_prompt_up_dialog)

	list_box.transform_changed.connect(on_list_rolling)
	on_list_rolling()
	full_refresh()


func _up_mid(node: Control) -> String:
	if node.has_meta(\"mid\"):
		return String(node.get_meta(\"mid\"))
	return String(node.name)


func _setup_up_node(mid: String) -> Control:
	var node := preload(\"res://Scene/UpPpreview.tscn\").instantiate()
	node.set_meta(\"mid\", mid)
	node.name = \"UpNode\" + str(up_nodes.size())
	node.set_meta(\"name_ready\", false)
	up_nodes.append(node)
	list_box.add_child(node)
	GdScriptFunc.apply_theme_and_styles_to_node(node)

	node.gui_input.connect(_on_up_node_gui_input.bind(node))

	var link_node: Button = node.get_node(\"Link\")
	link_node.gui_input.connect(_on_up_node_gui_input.bind(node))
	link_node.pressed.connect(func():
		if _suppress_next_click:
			_suppress_next_click = false
			return
		if GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") != null:
			get_node(\"/root/Main\")._on_search_text_submitted(\"UID:\" + _up_mid(node))
		else:
			get_node(\"/root/Main\")._on_search_text_submitted(\"UP主:\" + node.text + \":\" + _up_mid(node))
	)
	link_node.mouse_entered.connect(func():
		node.get_node(\"Link/Panel\").hide()
	)
	link_node.mouse_exited.connect(func():
		node.get_node(\"Link/Panel\").show()
	)

	if mid == \"bilibili音乐周榜\":
		node.text = mid
		node.set_meta(\"name_ready\", true)
		return node

	var icon: TextureRect = node.get_node(\"Link/Panel/Icon\")
	BilibiliApi.fetch_user_info_by_mid(mid, _on_user_info_received.bind(node, icon))
	return node


func _on_user_info_received(info, node: Control, icon: TextureRect) -> void:
	if not is_instance_valid(node):
		return
	if not info:
		print(\"获取用户信息失败:\", _up_mid(node))
		GdScriptFunc.show_toast(\"获取用户信息失败: \" + node.text)
		return
	var font: Font = get_theme_font(\"font\", \"Label\")
	node.tooltip_text = GdScriptFunc.format_for_tooltip(info.sign, 1000, font, 30, 30, 8)
	node.text = info.name
	node.set_meta(\"name_ready\", true)
	_try_load_up_videos(node)

	if info.face != \"\":
		_load_avatar(info.face, icon)


func _load_avatar(face_url: String, icon: TextureRect) -> void:
	var img_request := HTTPRequest.new()
	add_child(img_request)
	img_request.request_completed.connect(func(_r, _c, _h, img_body):
		img_request.queue_free()
		if not is_instance_valid(icon):
			return
		var img := Image.new()
		if img.load_jpg_from_buffer(img_body) == OK or img.load_png_from_buffer(img_body) == OK:
			icon.texture = ImageTexture.create_from_image(img)
			icon.modulate.a = 0.0
			var tw = icon.create_tween()
			tw.tween_property(icon, \"modulate:a\", 1.0, 0.3).set_trans(Tween.TRANS_CUBIC)
		else:
			print(\"头像下载失败\")
			GdScriptFunc.show_toast(\"头像下载失败: \" + face_url)
	)
	img_request.request(face_url, BilibiliApi._get_image_headers(), HTTPClient.METHOD_GET)


func full_refresh() -> void:
	if GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	for up_node in up_nodes:
		var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
		if hbox:
			for child in hbox.get_children():
				child.queue_free()
	up_preview_visible_id = 0
	for up_node in up_nodes:
		if up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(up_node)


func on_list_rolling() -> void:
	if !GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	var bottom := -list_box.position.y + scroll_container.size.y
	var target_idx := maxi((bottom - 169) / 350, 0)
	target_idx = mini(target_idx, up_nodes.size() - 1)
	while up_preview_visible_id <= target_idx and up_preview_visible_id < up_nodes.size():
		var current_up_node := up_nodes[up_preview_visible_id]
		if current_up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(current_up_node)
		up_preview_visible_id += 1


func _try_load_up_videos(up_node: Control) -> void:
	var idx = up_nodes.find(up_node)
	if idx == -1:
		return
	var lazy = GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true)
	if not lazy or idx < up_preview_visible_id:
		_load_videos_for_up(up_node)


func _load_videos_for_up(up_node: Control) -> void:
	var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
	if not hbox or hbox.get_child_count() > 0:
		return
	for i in 5:
		var s = preload(\"res://Scene/Skeleton.tscn\").instantiate()
		s.kind = \"thumb\"
		hbox.add_child(s)
	var mid := _up_mid(up_node)
	if mid == \"bilibili音乐周榜\":
		BilibiliApi.search_bilibili(load_cards_callback.bind(hbox), up_node.text, 10, 0, 1, up_node.text)
	elif GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") == null:
		BilibiliApi.fetch_user_videos_medialist(mid, up_node.text, load_cards_callback.bind(hbox))
	else:
		BilibiliApi.fetch_user_videos(mid, load_cards_callback.bind(hbox))


func _dismiss_row_skeletons(list_node: BoxContainer) -> void:
	for child in list_node.get_children():
		if child.has_meta(\"is_skeleton\"):
			child.dismiss()


func load_cards_callback(videos, list_node: BoxContainer) -> void:
	if not is_instance_valid(list_node):
		return
	_dismiss_row_skeletons(list_node)
	if videos == null:
		return
	var video_list = []
	if typeof(videos) == TYPE_DICTIONARY and videos.has(\"list\"):
		video_list = videos.list
	elif videos is Array:
		video_list = videos
	else:
		return
	if video_list.is_empty():
		return
	var spawn_tween := create_tween()
	for i in video_list.size():
		var video = video_list[i]
		spawn_tween.tween_callback(_instantiate_and_setup_card.bind(video, list_node))
		spawn_tween.tween_interval(0.08)


func _instantiate_and_setup_card(video: Dictionary, list_node: BoxContainer) -> void:
	if video.is_empty():
		return
	var video_card := preload(\"res://Scene/VideoCard.tscn\").instantiate()
	list_node.add_child(video_card)
	GdScriptFunc.apply_theme_and_styles_to_node(video_card)
	video_card.video_info = video
	video_card.title = video.get(\"title\", \"\")
	video_card.author = video.get(\"author\", \"\")
	video_card.description = video.get(\"description\", \"\")
	video_card.link = video.get(\"bvid\", video.get(\"link\", video.get(\"BV\", \"\")))
	video_card.reset()
	if video.get(\"is_network\", true):
		BilibiliApi.fetch_cover(video_card.link, set_cover.bind(video_card))
	elif FileAccess.file_exists(video.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video.link.get_basename() + \".jpg\")
		_set_cover(ImageTexture.create_from_image(image), video_card)
	else:
		GdScriptFunc.generate_label_texture(Color.WHITE, video.get(\"title\", tr(\"本地文件\")), _set_cover.bind(video_card), null, 50)
	video_card.gui_input.connect(_on_video_card_gui_input.bind(video_card, video))


func _on_video_card_gui_input(event: InputEvent, video_card: Control, video_data: Dictionary) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed:
		return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	var is_collected = _is_video_collected(link)
	var menu: Array[Dictionary] = []
	if not is_collected:
		menu.append({\"label\": tr(\"收藏\"), \"action\": func(_d): _on_collect(video_data), \"enabled\": true})
	else:
		menu.append({\"label\": tr(\"取消收藏\"), \"action\": func(_d): _on_cancel_collect(link), \"enabled\": true})
	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu)


func _is_video_collected(link: String) -> bool:
	return FavoritesIndex.is_collected(link)


func _on_collect(video_data: Dictionary) -> void:
	await _do_collect(video_data)


func _do_collect(video_data: Dictionary) -> void:
	var selected_favs = await GdScriptFunc.open_select_favorites_window()
	if selected_favs == null or selected_favs.is_empty():
		return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	for dir_name in selected_favs:
		var list = GdScriptFunc.get_data(\"Favorites\", dir_name, [])
		var repeated = false
		for item in list:
			if item.get(\"link\") == link:
				repeated = true
				break
		if repeated:
			continue
		list.append({\"link\": link, \"title\": video_data.get(\"title\", \"\"), \"author\": video_data.get(\"author\", \"\"), \"description\": video_data.get(\"description\", \"\"), \"is_network\": true})
		GdScriptFunc.set_data(\"Favorites\", dir_name, list)
		GdScriptFunc.flush()


func _on_cancel_collect(link: String) -> void:
	GdScriptFunc.cancel_collection(link)


func _set_cover(texture: Texture2D, video_card: Control) -> void:
	set_cover(\"\", texture, video_card)


func set_cover(_bvid: String, texture: Texture2D, video_card: Control) -> void:
	if is_instance_valid(video_card):
		video_card.cover = texture


func _build_edit_ui() -> void:
	_hint_label = Label.new()
	_hint_label.text = tr(\"松手删除该 UP 主\")
	_hint_label.add_theme_font_size_override(\"font_size\", 32)
	_hint_label.add_theme_color_override(\"font_color\", Color(1, 0.35, 0.35))
	_hint_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_hint_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_hint_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_hint_label.z_index = 100
	_hint_label.visible = false
	add_child(_hint_label)
	GdScriptFunc.apply_theme_and_styles_to_node(_hint_label)

	_insert_line = ColorRect.new()
	_insert_line.color = Color(0.3, 0.7, 1.0, 0.9)
	_insert_line.z_index = 100
	_insert_line.visible = false
	add_child(_insert_line)


func _on_up_node_gui_input(event: InputEvent, node: Control) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				_press_node = node
				_press_pos = event.global_position
			else:
				_press_node = null
		elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
			_show_up_menu(node)
	elif event is InputEventMouseMotion:
		if _press_node == node and not _dragging \\
				and event.button_mask & MOUSE_BUTTON_MASK_LEFT \\
				and event.global_position.distance_to(_press_pos) > DRAG_THRESHOLD:
			_start_drag()


func _start_drag() -> void:
	_dragging = true
	_suppress_next_click = true
	_press_node.modulate.a = 0.45
	_drag_preview = _make_drag_preview(_press_node)
	add_child(_drag_preview)


func _make_drag_preview(node: Control) -> Control:
	var preview := Label.new()
	preview.text = node.text if node.text != \"\" else _up_mid(node)
	preview.add_theme_font_size_override(\"font_size\", 28)
	preview.add_theme_color_override(\"font_outline_color\", Color(0, 0, 0, 0.8))
	preview.add_theme_constant_override(\"outline_size\", 8)
	preview.z_index = 101
	return preview


func _input(event: InputEvent) -> void:
	if not _dragging:
		return
	if event is InputEventMouseButton \\
			and (event.button_index == MOUSE_BUTTON_WHEEL_DOWN or event.button_index == MOUSE_BUTTON_WHEEL_UP):
		get_viewport().set_input_as_handled()
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
		_finish_drag()
		get_viewport().set_input_as_handled()
		return
	if event is InputEventMouseMotion:
		scroll_container.scroll_vertical += int(event.relative.y)


func _process(_delta: float) -> void:
	if not _dragging:
		return
	if is_instance_valid(_drag_preview):
		_drag_preview.global_position = get_global_mouse_position() + Vector2(14, 14)
	_update_drag_hint()
	if not Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		_finish_drag()


func _update_drag_hint() -> void:
	var mouse := get_global_mouse_position()
	var in_list := list_box.get_global_rect().has_point(mouse)
	_hint_label.visible = not in_list
	if in_list:
		_insert_line.visible = true
		_position_insert_line(_calc_insert_index(mouse.y))
	else:
		_insert_line.visible = false


func _finish_drag() -> void:
	if not _dragging:
		return
	_dragging = false
	var node := _press_node
	_press_node = null
	if is_instance_valid(_drag_preview):
		_drag_preview.queue_free()
	_drag_preview = null
	_hint_label.visible = false
	_insert_line.visible = false
	if not is_instance_valid(node):
		return
	node.modulate.a = 1.0
	var mouse := get_global_mouse_position()
	if list_box.get_global_rect().has_point(mouse):
		_move_up_node(node, _calc_insert_index(mouse.y))
	else:
		var shown_name: String = node.text if node.text != \"\" else _up_mid(node)
		_remove_up(node)
		GdScriptFunc.show_toast(tr(\"已删除：\") + shown_name)


func _calc_insert_index(global_y: float) -> int:
	for i in up_nodes.size():
		var r := up_nodes[i].get_global_rect()
		if global_y < r.position.y + r.size.y * 0.5:
			return i
	return up_nodes.size()


func _position_insert_line(idx: int) -> void:
	var y: float
	if idx < up_nodes.size():
		y = up_nodes[idx].get_global_rect().position.y
	elif not up_nodes.is_empty():
		y = up_nodes[up_nodes.size() - 1].get_global_rect().end.y
	else:
		y = list_box.get_global_rect().position.y
	_insert_line.global_position = Vector2(list_box.global_position.x, y - 2.0)
	_insert_line.size = Vector2(list_box.size.x, 4.0)


func _apply_order() -> void:
	for i in up_nodes.size():
		list_box.move_child(up_nodes[i], i + 1)


func _move_up_node(node: Control, target_idx: int) -> void:
	var from_idx := up_nodes.find(node)
	if from_idx == -1:
		return
	target_idx = clampi(target_idx, 0, up_nodes.size() - 1)
	if target_idx == from_idx:
		return
	up_nodes.remove_at(from_idx)
	up_nodes.insert(target_idx, node)
	_apply_order()
	_save_ups()
	up_preview_visible_id = 0
	on_list_rolling()


func _remove_up(node: Control) -> void:
	var idx := up_nodes.find(node)
	if idx == -1:
		return
	up_nodes.remove_at(idx)
	if idx < up_preview_visible_id:
		up_preview_visible_id -= 1
	node.queue_free()
	_save_ups()


func _add_up(mid: String) -> void:
	for n in up_nodes:
		if _up_mid(n) == mid:
			GdScriptFunc.show_toast(tr(\"该 UP 主已在列表中\"))
			return
	ups.append(mid)
	_setup_up_node(mid)
	_apply_order()
	_save_ups()


func _replace_up(old_mid: String, new_mid: String) -> void:
	var idx := -1
	for i in up_nodes.size():
		if _up_mid(up_nodes[i]) == old_mid:
			idx = i
			break
	if idx == -1:
		return
	up_nodes[idx].queue_free()
	up_nodes.remove_at(idx)
	ups[idx] = new_mid
	var new_node := _setup_up_node(new_mid)
	up_nodes.remove_at(up_nodes.size() - 1)
	up_nodes.insert(idx, new_node)
	_apply_order()
	_save_ups()


func _prompt_up_dialog(prefill := \"\") -> void:
	var is_new := prefill.is_empty()
	var dialog := AcceptDialog.new()
	dialog.title = tr(\"添加 UP 主\") if is_new else tr(\"编辑 UP 主\")
	var le := LineEdit.new()
	le.text = prefill
	le.placeholder_text = tr(\"输入 UID / MID（如 946974），或 bilibili音乐周榜\")
	le.custom_minimum_size = Vector2(420, 40)
	dialog.add_child(le)
	add_child(dialog)
	GdScriptFunc.apply_theme_and_styles_to_node(dialog)
	dialog.confirmed.connect(func():
		var mid := le.text.strip_edges().trim_prefix(\"UID:\").trim_prefix(\"uid:\").trim_prefix(\"空间:\")
		if mid.is_empty():
			dialog.queue_free()
			return
		if is_new:
			_add_up(mid)
		else:
			_replace_up(prefill, mid)
		dialog.queue_free()
	)
	dialog.popup_centered()


func _show_up_menu(node: Control) -> void:
	var menu: Array[Dictionary] = [
		{\"label\": tr(\"编辑\"), \"action\": func(_d): _prompt_up_dialog(_up_mid(node)), \"enabled\": true},
		{\"label\": tr(\"删除\"), \"action\": func(_d): _remove_up(node), \"enabled\": true},
		{\"label\": tr(\"上移\"), \"action\": func(_d): _move_up_node(node, up_nodes.find(node) - 1), \"enabled\": true},
		{\"label\": tr(\"下移\"), \"action\": func(_d): _move_up_node(node, up_nodes.find(node) + 1), \"enabled\": true},
	]
	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu)


func _save_ups() -> void:
	ups.clear()
	for n in up_nodes:
		ups.append(_up_mid(n))
	GdScriptFunc.set_data(\"DiscoverPage\", \"ups\", Array(ups))
	GdScriptFunc.flush()


func _on_scroll_container_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if (event.button_index == MOUSE_BUTTON_WHEEL_DOWN or event.button_index == MOUSE_BUTTON_WHEEL_UP) and is_on_vertical_scroll:
			is_vertical_sliding = true
			time_cd.start()
	if event is InputEventMouseMotion and time_cd.is_stopped():
		is_vertical_sliding = false
		time_cd.stop()


func _on_cd_timer_timeout() -> void:
	is_vertical_sliding = false


func _on_scroll_container_mouse_entered() -> void:
	is_on_vertical_scroll = true


func _on_scroll_container_mouse_exited() -> void:
	is_on_vertical_scroll = false
"

[sub_resource type="GDScript" id="GDScript_6vwaf"]
script/source = "extends VBoxContainer

signal transform_changed
func _ready() -> void:
	set_notify_transform(true)#用来监听位置信息,从而计算可见的up预览区域,这样就能按需求加载
func _notification(what):
	if what == NOTIFICATION_TRANSFORM_CHANGED:
		transform_changed.emit()
"

