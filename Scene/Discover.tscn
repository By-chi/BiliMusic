[gd_scene format=3 uid="uid://h8qr8p6khg63"]

[sub_resource type="GDScript" id="GDScript_61i7r"]
script/source = "extends Control

@export var list_box: VBoxContainer
@export var scroll_container: ScrollContainer

@export var ups: Array[String] = []

var up_nodes: Array[Label] = []
var up_preview_visible_id := 0


func _ready() -> void:
	for mid in ups:
		var node := preload(\"res://Scene/UpPpreview.tscn\").instantiate()
		node.name = mid
		up_nodes.append(node)
		list_box.add_child(node)
		GdScriptFunc.apply_theme_and_styles_to_node(node)

		var link_node: Button = node.get_node(\"Link\")
		link_node.pressed.connect(func():
			if GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") != null:
				get_node(\"/root/Main\")._on_search_text_submitted(\"UID:\" + node.name)
			else:
				get_node(\"/root/Main\")._on_search_text_submitted(\"UP主:\" + node.name + \":\" + node.text)
		)
		link_node.mouse_entered.connect(func():
			node.get_node(\"Link/Panel\").hide()
		)
		link_node.mouse_exited.connect(func():
			node.get_node(\"Link/Panel\").show()
		)

		if mid != \"bilibili音乐周榜\":
			var icon: TextureRect = node.get_node(\"Link/Panel/Icon\")
			BilibiliApi.fetch_user_info_by_mid(mid, func(info):
				if info:
					var font: Font = get_theme_font(\"font\", \"Label\")
					node.tooltip_text = GdScriptFunc.format_for_tooltip(info.sign, 1000, font, 30, 30, 8)
					node.text = info.name
					node.set_meta(\"name_ready\", true)
					_try_load_up_videos(node)

					if info.face != \"\":
						var img_request = HTTPRequest.new()
						add_child(img_request)
						img_request.request_completed.connect(func(_r, _c, _h, img_body):
							img_request.queue_free()
							var img = Image.new()
							if img.load_jpg_from_buffer(img_body) == OK or img.load_png_from_buffer(img_body) == OK:
								var tex = ImageTexture.create_from_image(img)
								icon.texture = tex
							else:
								print(\"头像下载失败\")
						)
						img_request.request(info.face, BilibiliApi._get_image_headers(), HTTPClient.METHOD_GET)
				else:
					print(\"获取用户信息失败:\", mid)
			)
		else:
			node.text = node.name
			node.set_meta(\"name_ready\", true)

	list_box.transform_changed.connect(on_list_rolling)
	on_list_rolling()
	full_refresh()


func full_refresh() -> void:
	if GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	for up_node in up_nodes:
		var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
		if hbox:
			for child in hbox.get_children():
				child.queue_free()
	up_preview_visible_id = 0
	for up_node in up_nodes:
		if up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(up_node)


func on_list_rolling() -> void:
	if !GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	var bottom := -list_box.position.y + scroll_container.size.y
	var target_idx := maxi((bottom - 169) / 350, 0)
	target_idx = mini(target_idx, up_nodes.size() - 1)

	while up_preview_visible_id <= target_idx and up_preview_visible_id < up_nodes.size():
		var current_up_node := up_nodes[up_preview_visible_id]
		if current_up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(current_up_node)
		up_preview_visible_id += 1


func _try_load_up_videos(up_node: Control) -> void:
	var idx = up_nodes.find(up_node)
	if idx == -1: return
	var lazy = GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true)
	if not lazy or idx < up_preview_visible_id:
		_load_videos_for_up(up_node)


func _load_videos_for_up(up_node: Control) -> void:
	var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
	if not hbox or hbox.get_child_count() > 0:
		return

	if up_node.name == \"bilibili音乐周榜\":
		BilibiliApi.search_bilibili(load_cards_callback.bind(hbox), up_node.text, 10, 0, 1, up_node.text)
	elif GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") == null:
		BilibiliApi.fetch_user_videos_medialist(up_node.name, up_node.text, load_cards_callback.bind(hbox))
	else:
		BilibiliApi.fetch_user_videos(up_node.name, load_cards_callback.bind(hbox))


func load_cards_callback(videos, list_node: BoxContainer) -> void:
	if videos == null or not is_instance_valid(list_node):
		return
	var video_list = []
	if typeof(videos) == TYPE_DICTIONARY and videos.has(\"list\"):
		video_list = videos.list
	elif videos is Array:
		video_list = videos
	else:
		return
	if video_list.is_empty(): return

	var spawn_tween := create_tween()
	for i in video_list.size():
		var video = video_list[i]
		spawn_tween.tween_callback(_instantiate_and_setup_card.bind(video, list_node))
		spawn_tween.tween_interval(0.08)


func _instantiate_and_setup_card(video: Dictionary, list_node: BoxContainer) -> void:
	if video.is_empty(): return
	var video_card := preload(\"res://Scene/VideoCard.tscn\").instantiate()
	list_node.add_child(video_card)
	GdScriptFunc.apply_theme_and_styles_to_node(video_card)
	video_card.video_info = video
	video_card.title = video.get(\"title\", \"\")
	video_card.author = video.get(\"author\", \"\")
	video_card.description = video.get(\"description\", \"\")
	video_card.link = video.get(\"bvid\", video.get(\"link\", video.get(\"BV\", \"\")))
	video_card.reset()
	if video.get(\"is_network\", true):
		BilibiliApi.fetch_cover(video_card.link, set_cover.bind(video_card))
	elif FileAccess.file_exists(video.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video.link.get_basename() + \".jpg\")
		_set_cover(ImageTexture.create_from_image(image), video_card)
	else:
		GdScriptFunc.generate_label_texture(Color.WHITE, video.get(\"title\", tr(\"本地文件\")), _set_cover.bind(video_card), null, 50)
	video_card.gui_input.connect(_on_video_card_gui_input.bind(video_card, video))


func _on_video_card_gui_input(event: InputEvent, video_card: Control, video_data: Dictionary) -> void:
	if not (event is InputEventMouseButton): return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed: return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	var is_collected = _is_video_collected(link)
	var menu: Array[Dictionary] = []
	if not is_collected:
		menu.append({\"label\": tr(\"收藏\"), \"action\": func(_d): _on_collect(video_data), \"enabled\": true})
	else:
		menu.append({\"label\": tr(\"取消收藏\"), \"action\": func(_d): _on_cancel_collect(link), \"enabled\": true})
	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu)


func _is_video_collected(link: String) -> bool:
	var favs = GdScriptFunc.get_keys(\"Favorites\")
	if favs == null: return false
	for dir in favs:
		var list = GdScriptFunc.get_data(\"Favorites\", dir, [])
		for item in list:
			if item.get(\"link\") == link: return true
	return false


func _on_collect(video_data: Dictionary) -> void:
	await _do_collect(video_data)


func _do_collect(video_data: Dictionary) -> void:
	var selected_favs = await GdScriptFunc.open_select_favorites_window()
	if selected_favs == null or selected_favs.is_empty(): return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	for dir_name in selected_favs:
		var list = GdScriptFunc.get_data(\"Favorites\", dir_name, [])
		var repeated = false
		for item in list:
			if item.get(\"link\") == link:
				repeated = true
				break
		if repeated: continue
		list.append({\"link\": link, \"title\": video_data.get(\"title\", \"\"), \"author\": video_data.get(\"author\", \"\"), \"description\": video_data.get(\"description\", \"\"), \"is_network\": true})
		GdScriptFunc.set_data(\"Favorites\", dir_name, list)
	GdScriptFunc.flush()


func _on_cancel_collect(link: String) -> void:
	GdScriptFunc.cancel_collection(link)


func _set_cover(texture: Texture2D, video_card: Control) -> void:
	set_cover(\"\", texture, video_card)


func set_cover(_bvid: String, texture: Texture2D, video_card: Control) -> void:
	if is_instance_valid(video_card): video_card.cover = texture


@export var time_cd: Timer
var is_vertical_sliding := false:
	set(value):
		if value == is_vertical_sliding: return
		is_vertical_sliding = value
		for node in up_nodes:
			var inner_scroll := node.get_node_or_null(\"ScrollContainer\")
			if inner_scroll:
				inner_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE if value else Control.MOUSE_FILTER_STOP

var is_on_vertical_scroll := false

func _on_scroll_container_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if (event.button_index == MOUSE_BUTTON_WHEEL_DOWN or event.button_index == MOUSE_BUTTON_WHEEL_UP) and is_on_vertical_scroll:
			is_vertical_sliding = true
			time_cd.start()
	if event is InputEventMouseMotion and time_cd.is_stopped():
		is_vertical_sliding = false
		time_cd.stop()

func _on_cd_timer_timeout() -> void:
	is_vertical_sliding = false

func _on_scroll_container_mouse_entered() -> void:
	is_on_vertical_scroll = true

func _on_scroll_container_mouse_exited() -> void:
	is_on_vertical_scroll = false
"

[sub_resource type="GDScript" id="GDScript_6vwaf"]
script/source = "extends VBoxContainer

signal transform_changed
func _ready() -> void:
	set_notify_transform(true)#用来监听位置信息,从而计算可见的up预览区域,这样就能按需求加载
func _notification(what):
	if what == NOTIFICATION_TRANSFORM_CHANGED:
		transform_changed.emit()
"

