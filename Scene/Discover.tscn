[sub_resource type="GDScript" id="GDScript_61i7r"]
script/source = "extends Control

@export var list_box: VBoxContainer
@export var scroll_container: ScrollContainer
@export var ups: Array[String] = []
@export var add_button: Button

var up_nodes: Array[Label] = []
var up_preview_visible_id := 0

const DRAG_THRESHOLD := 10.0

var _press_node: Control = null
var _press_pos := Vector2.ZERO
var _dragging := false
var _drag_preview: Control = null
var _suppress_next_click := false
var _hint_label: Label
var _insert_line: ColorRect

@export var time_cd: Timer
@onready var favorites_scroll_container: ScrollContainer = $FavoritesScrollContainer
@onready var favorites_grid_container: GridContainer = $FavoritesScrollContainer/VBoxContainer/GridContainer
@onready var recommendation_status: Label = $FavoritesScrollContainer/VBoxContainer/RecommendationStatus
@onready var ups_mode_button: Button = $Mode/Ups
@onready var favorites_mode_button: Button = $Mode/Favorites
@onready var recommendation_loading: Control = $RecommendationLoading

const MAX_RECOMMENDATION_UPS := 8
const MAX_RECOMMENDATION_CARDS := 20
const RECOMMENDATION_CARD_WIDTH := 582.4
const RECOMMENDATION_MIN_HORIZONTAL_GAP := 20.0
const MAX_RECOMMENDATION_POOL := 400
const INITIAL_RECOMMENDATION_PAGES_PER_UP := 3
const REFILL_RECOMMENDATION_PAGES_PER_UP := 2
const MAX_SEARCH_PAGES_PER_UP := 50
const RECENT_RECOMMENDATION_HISTORY := 40

var _showing_favorite_discovery := false
var _recommendation_generation := 0
var _favorite_recommendations_signature := \"\"
var _recommendation_pool: Array = []
var _recent_recommendation_links: Array[String] = []
var _recommendation_authors: Array[String] = []
var _recommendation_seen_links: Dictionary = {}
var _recommendation_seen_pages: Dictionary = {}
var _recommendation_jobs: Array[Dictionary] = []
var _recommendation_job_index := 0
var _recommendation_author_count := 0
var _recommendation_fetching := false
var _mode_tween: Tween
var _recommendation_loading_tween: Tween
var is_vertical_sliding := false:
	set(value):
		if value == is_vertical_sliding:
			return
		is_vertical_sliding = value
		for node in up_nodes:
			var inner_scroll := node.get_node_or_null(\"ScrollContainer\")
			if inner_scroll:
				inner_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE if value else Control.MOUSE_FILTER_STOP
var is_on_vertical_scroll := false


func _ready() -> void:
	var saved: Variant = GdScriptFunc.get_data(\"DiscoverPage\", \"ups\", null)
	if saved is Array and not saved.is_empty():
		var cleaned: Array[String] = []
		for item in saved:
			if item is String and not item.is_empty() and item.is_valid_utf8() if item is PackedByteArray else (item is String and not item.is_empty()):
				cleaned.append(item)
		if not cleaned.is_empty():
			ups = cleaned

	for mid in ups:
		_setup_up_node(mid)

	_build_edit_ui()

	if add_button:
		add_button.pressed.connect(_prompt_up_dialog)
	favorites_scroll_container.resized.connect(_update_recommendation_columns)
	_update_recommendation_columns()

	list_box.transform_changed.connect(on_list_rolling)
	on_list_rolling()
	full_refresh()


func _up_mid(node: Control) -> String:
	if node.has_meta(\"mid\"):
		return String(node.get_meta(\"mid\"))
	return String(node.name)


func _setup_up_node(mid: String) -> Control:
	var node := preload(\"res://Scene/UpPpreview.tscn\").instantiate()
	node.set_meta(\"mid\", mid)
	node.name = \"UpNode\" + str(up_nodes.size())
	node.set_meta(\"name_ready\", false)
	up_nodes.append(node)
	list_box.add_child(node)
	GdScriptFunc.apply_theme_and_styles_to_node(node)

	node.gui_input.connect(_on_up_node_gui_input.bind(node))

	var link_node: Button = node.get_node(\"Link\")
	link_node.gui_input.connect(_on_up_node_gui_input.bind(node))
	link_node.pressed.connect(func():
		if _suppress_next_click:
			_suppress_next_click = false
			return
		if GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") != null:
			get_node(\"/root/Main\")._on_search_text_submitted(\"UID:\" + _up_mid(node))
		else:
			get_node(\"/root/Main\")._on_search_text_submitted(\"UP主:\" + node.text + \":\" + _up_mid(node))
	)
	link_node.mouse_entered.connect(func():
		node.get_node(\"Link/Panel\").hide()
	)
	link_node.mouse_exited.connect(func():
		node.get_node(\"Link/Panel\").show()
	)

	if mid == \"bilibili音乐周榜\":
		node.text = mid
		node.set_meta(\"name_ready\", true)
		return node

	var icon: TextureRect = node.get_node(\"Link/Panel/Icon\")
	BilibiliApi.fetch_user_info_by_mid(mid, _on_user_info_received.bind(node, icon))
	return node


func _on_user_info_received(info, node: Control, icon: TextureRect) -> void:
	if not is_instance_valid(node):
		return
	if not info:
		print(\"获取用户信息失败:\", _up_mid(node))
		GdScriptFunc.show_toast(\"获取用户信息失败: \" + node.text)
		return
	var font: Font = get_theme_font(\"font\", \"Label\")
	node.tooltip_text = GdScriptFunc.format_for_tooltip(info.sign, 1000, font, 30, 30, 8)
	node.text = info.name
	node.set_meta(\"name_ready\", true)
	_try_load_up_videos(node)

	if info.face != \"\":
		_load_avatar(info.face, icon)


func _load_avatar(face_url: String, icon: TextureRect) -> void:
	var img_request := HTTPRequest.new()
	add_child(img_request)
	img_request.request_completed.connect(func(_r, _c, _h, img_body):
		img_request.queue_free()
		if not is_instance_valid(icon):
			return
		var img := Image.new()
		if img.load_jpg_from_buffer(img_body) == OK or img.load_png_from_buffer(img_body) == OK:
			icon.texture = ImageTexture.create_from_image(img)
			icon.modulate.a = 0.0
			var tw = icon.create_tween()
			tw.tween_property(icon, \"modulate:a\", 1.0, 0.3).set_trans(Tween.TRANS_CUBIC)
		else:
			print(\"头像下载失败\")
			GdScriptFunc.show_toast(\"头像下载失败: \" + face_url)
	)
	img_request.request(face_url, BilibiliApi._get_image_headers(), HTTPClient.METHOD_GET)


func full_refresh() -> void:
	if GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	for up_node in up_nodes:
		var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
		if hbox:
			for child in hbox.get_children():
				child.queue_free()
	up_preview_visible_id = 0
	for up_node in up_nodes:
		if up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(up_node)


func on_list_rolling() -> void:
	if !GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true):
		return
	var bottom := -list_box.position.y + scroll_container.size.y
	var target_idx := maxi((bottom - 169) / 350, 0)
	target_idx = mini(target_idx, up_nodes.size() - 1)
	while up_preview_visible_id <= target_idx and up_preview_visible_id < up_nodes.size():
		var current_up_node := up_nodes[up_preview_visible_id]
		if current_up_node.get_meta(\"name_ready\", false):
			_load_videos_for_up(current_up_node)
		up_preview_visible_id += 1


func _try_load_up_videos(up_node: Control) -> void:
	var idx = up_nodes.find(up_node)
	if idx == -1:
		return
	var lazy = GdScriptFunc.get_data(\"Options\", \"DiscoverPageLazyUpdate\", true)
	if not lazy or idx < up_preview_visible_id:
		_load_videos_for_up(up_node)


func _load_videos_for_up(up_node: Control) -> void:
	var hbox = up_node.get_node_or_null(\"ScrollContainer/HBoxContainer\")
	if not hbox or hbox.get_child_count() > 0:
		return
	for i in 5:
		var s = preload(\"res://Scene/Skeleton.tscn\").instantiate()
		s.kind = \"thumb\"
		hbox.add_child(s)
	var mid := _up_mid(up_node)
	if mid == \"bilibili音乐周榜\":
		BilibiliApi.search_bilibili(load_cards_callback.bind(hbox), up_node.text, 10, 0, 1, up_node.text)
	elif GdScriptFunc.get_data(\"AccountData\", \"SESSDATA\") == null:
		BilibiliApi.fetch_user_videos_medialist(mid, up_node.text, load_cards_callback.bind(hbox))
	else:
		BilibiliApi.fetch_user_videos(mid, load_cards_callback.bind(hbox))


func _dismiss_row_skeletons(list_node: BoxContainer) -> void:
	for child in list_node.get_children():
		if child.has_meta(\"is_skeleton\"):
			child.dismiss()


func load_cards_callback(videos, list_node: BoxContainer) -> void:
	if not is_instance_valid(list_node):
		return
	_dismiss_row_skeletons(list_node)
	if videos == null:
		return
	var video_list = []
	if typeof(videos) == TYPE_DICTIONARY and videos.has(\"list\"):
		video_list = videos.list
	elif videos is Array:
		video_list = videos
	else:
		return
	if video_list.is_empty():
		return
	var spawn_tween := create_tween()
	for i in video_list.size():
		var video = video_list[i]
		spawn_tween.tween_callback(_instantiate_and_setup_card.bind(video, list_node))
		spawn_tween.tween_interval(0.08)


func _instantiate_and_setup_card(video: Dictionary, list_node: BoxContainer) -> void:
	if video.is_empty():
		return
	var video_card := preload(\"res://Scene/VideoCard.tscn\").instantiate()
	list_node.add_child(video_card)
	GdScriptFunc.apply_theme_and_styles_to_node(video_card)
	video_card.video_info = video
	video_card.title = video.get(\"title\", \"\")
	video_card.author = video.get(\"author\", \"\")
	video_card.description = video.get(\"description\", \"\")
	video_card.link = video.get(\"bvid\", video.get(\"link\", video.get(\"BV\", \"\")))
	video_card.reset()
	if video.get(\"is_network\", true):
		BilibiliApi.fetch_cover(video_card.link, set_cover.bind(video_card))
	elif FileAccess.file_exists(video.link.get_basename() + \".jpg\"):
		var image = Image.load_from_file(video.link.get_basename() + \".jpg\")
		_set_cover(ImageTexture.create_from_image(image), video_card)
	else:
		GdScriptFunc.generate_label_texture(Color.WHITE, video.get(\"title\", tr(\"本地文件\")), _set_cover.bind(video_card), null, 50)
	video_card.gui_input.connect(_on_video_card_gui_input.bind(video_card, video))


func _on_video_card_gui_input(event: InputEvent, video_card: Control, video_data: Dictionary) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed:
		return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	var is_collected = _is_video_collected(link)
	var menu: Array[Dictionary] = []
	if not is_collected:
		menu.append({\"label\": tr(\"收藏\"), \"action\": func(_d): _on_collect(video_data), \"enabled\": true})
	else:
		menu.append({\"label\": tr(\"取消收藏\"), \"action\": func(_d): _on_cancel_collect(link), \"enabled\": true})
	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu)


func _is_video_collected(link: String) -> bool:
	return FavoritesIndex.is_collected(link)


func _on_collect(video_data: Dictionary) -> void:
	await _do_collect(video_data)


func _do_collect(video_data: Dictionary) -> void:
	var selected_favs = await GdScriptFunc.open_select_favorites_window()
	if selected_favs == null or selected_favs.is_empty():
		return
	var link = video_data.get(\"link\", video_data.get(\"bvid\", video_data.get(\"BV\", \"\")))
	for dir_name in selected_favs:
		var list = GdScriptFunc.get_data(\"Favorites\", dir_name, [])
		var repeated = false
		for item in list:
			if item.get(\"link\") == link:
				repeated = true
				break
		if repeated:
			continue
		list.append({\"link\": link, \"title\": video_data.get(\"title\", \"\"), \"author\": video_data.get(\"author\", \"\"), \"description\": video_data.get(\"description\", \"\"), \"is_network\": true})
		GdScriptFunc.set_data(\"Favorites\", dir_name, list)
		GdScriptFunc.flush()
	_favorite_recommendations_signature = \"\"
	if _showing_favorite_discovery:
		_refresh_favorite_recommendations()


func _on_cancel_collect(link: String) -> void:
	GdScriptFunc.cancel_collection(link)
	_favorite_recommendations_signature = \"\"
	if _showing_favorite_discovery:
		_refresh_favorite_recommendations()


func _show_up_discovery() -> void:
	_switch_discovery_mode(false)


func _show_favorite_discovery() -> void:
	_switch_discovery_mode(true)


func _switch_discovery_mode(show_favorites: bool) -> void:
	if show_favorites == _showing_favorite_discovery:
		ups_mode_button.set_pressed_no_signal(not show_favorites)
		favorites_mode_button.set_pressed_no_signal(show_favorites)
		if show_favorites:
			_shuffle_favorite_recommendations()
		return
	if _mode_tween and _mode_tween.is_running():
		ups_mode_button.set_pressed_no_signal(not _showing_favorite_discovery)
		favorites_mode_button.set_pressed_no_signal(_showing_favorite_discovery)
		return

	var outgoing: Control = favorites_scroll_container if _showing_favorite_discovery else $UpsScrollContainer
	var incoming: Control = favorites_scroll_container if show_favorites else $UpsScrollContainer
	var direction := 1.0 if show_favorites else -1.0
	var slide_distance := maxf(size.x, 1.0)

	_showing_favorite_discovery = show_favorites
	ups_mode_button.set_pressed_no_signal(not show_favorites)
	favorites_mode_button.set_pressed_no_signal(show_favorites)
	incoming.show()
	incoming.modulate.a = 0.0
	incoming.set(\"offset_transform_position\", Vector2(direction * slide_distance, 0))

	_mode_tween = create_tween()
	_mode_tween.tween_property(outgoing, \"offset_transform_position:x\", -direction * slide_distance, 0.25).set_trans(Tween.TRANS_CUBIC)
	_mode_tween.parallel().tween_property(outgoing, \"modulate:a\", 0.0, 0.22).set_trans(Tween.TRANS_CUBIC)
	var incoming_tween := create_tween()
	incoming_tween.tween_property(incoming, \"offset_transform_position:x\", 0.0, 0.25).set_trans(Tween.TRANS_CUBIC)
	incoming_tween.parallel().tween_property(incoming, \"modulate:a\", 1.0, 0.25).set_trans(Tween.TRANS_CUBIC)
	_mode_tween.finished.connect(func():
		outgoing.hide()
		outgoing.modulate.a = 1.0
		outgoing.set(\"offset_transform_position\", Vector2.ZERO)
		incoming.set(\"offset_transform_position\", Vector2.ZERO)
		_mode_tween = null
	)
	if show_favorites:
		_refresh_favorite_recommendations()


func _update_recommendation_columns() -> void:
	if not is_instance_valid(favorites_grid_container) or not is_instance_valid(favorites_scroll_container):
		return
	var available_width := favorites_grid_container.size.x
	if available_width <= 0.0:
		available_width = favorites_scroll_container.size.x
	var columns := maxi(
		1,
		int((available_width + RECOMMENDATION_MIN_HORIZONTAL_GAP) / (RECOMMENDATION_CARD_WIDTH + RECOMMENDATION_MIN_HORIZONTAL_GAP))
	)
	favorites_grid_container.columns = columns
	var horizontal_gap := RECOMMENDATION_MIN_HORIZONTAL_GAP
	if columns > 1:
		horizontal_gap = maxf(
			RECOMMENDATION_MIN_HORIZONTAL_GAP,
			(available_width - columns * RECOMMENDATION_CARD_WIDTH) / (columns - 1)
		)
	favorites_grid_container.add_theme_constant_override(\"h_separation\", int(round(horizontal_gap)))


func _refresh_favorite_recommendations() -> void:
	_recommendation_generation += 1
	var generation := _recommendation_generation
	var favorite_links: Dictionary = {}
	var authors: Array[String] = []
	var signature_parts: Array[String] = []

	for dir_name in GdScriptFunc.get_keys(\"Favorites\"):
		var saved_videos: Variant = GdScriptFunc.get_data(\"Favorites\", dir_name, [])
		if not saved_videos is Array:
			continue
		for video in saved_videos:
			if not video is Dictionary or not video.get(\"is_network\", true):
				continue
			var link := str(video.get(\"link\", video.get(\"bvid\", video.get(\"BV\", \"\")))).strip_edges()
			var author := str(video.get(\"author\", \"\")).strip_edges()
			if not link.is_empty():
				favorite_links[link] = true
				signature_parts.append(link + \":\" + author)
			if not author.is_empty() and not authors.has(author):
				authors.append(author)

	signature_parts.sort()
	var signature := \"|\".join(signature_parts)
	if signature == _favorite_recommendations_signature:
		_recommendation_generation -= 1
		return
	_favorite_recommendations_signature = signature
	_clear_recommendation_cards()
	_recommendation_pool.clear()
	_recent_recommendation_links.clear()
	_recommendation_seen_pages.clear()
	_recommendation_fetching = false

	if authors.is_empty():
		_recommendation_authors.clear()
		_recommendation_seen_links.clear()
		_hide_recommendation_loading()
		recommendation_status.text = tr(\"收藏夹中没有可用于推荐的 UP 主\")
		return

	authors.shuffle()
	if authors.size() > MAX_RECOMMENDATION_UPS:
		authors.resize(MAX_RECOMMENDATION_UPS)
	_recommendation_authors = authors
	_recommendation_seen_links = favorite_links
	_recommendation_author_count = authors.size()
	recommendation_status.text = tr(\"正在从收藏的 UP 主中寻找视频…\")
	_queue_recommendation_search_jobs(true, generation)


func _shuffle_favorite_recommendations(allow_refill := true) -> void:
	if _recommendation_pool.is_empty():
		if not _recommendation_fetching and not _recommendation_authors.is_empty():
			_queue_recommendation_search_jobs(false, _recommendation_generation)
		return

	var current_links: Dictionary = {}
	for child in favorites_grid_container.get_children():
		if is_instance_valid(child) and \"link\" in child:
			current_links[str(child.link)] = true

	var target_count := mini(_recommendation_pool.size(), MAX_RECOMMENDATION_CARDS)
	var candidates := _get_unseen_recommendations(current_links)
	if candidates.size() < target_count and allow_refill and _recommendation_pool.size() < MAX_RECOMMENDATION_POOL:
		if _queue_recommendation_search_jobs(false, _recommendation_generation):
			return
	while candidates.size() < target_count and not _recent_recommendation_links.is_empty():
		_recent_recommendation_links.pop_front()
		candidates = _get_unseen_recommendations(current_links)

	candidates.shuffle()
	var selected: Array = []
	var selected_count := mini(candidates.size(), target_count)
	for index in selected_count:
		selected.append(candidates[index])
	_clear_recommendation_cards()
	for video in selected:
		_create_recommended_video_card(video)
		var link := str(video.get(\"link\", video.get(\"bvid\", video.get(\"BV\", \"\"))))
		if not link.is_empty():
			_recent_recommendation_links.append(link)
	while _recent_recommendation_links.size() > RECENT_RECOMMENDATION_HISTORY:
		_recent_recommendation_links.pop_front()
	var count := selected.size()
	if count == 0:
		recommendation_status.text = tr(\"没有更多未展示的视频，请收藏更多 UP 主或稍后重试\")
	else:
		recommendation_status.text = tr(\"从 %d 位收藏 UP 主中随机推荐 %d 个视频\") % [_recommendation_author_count, count]


func _get_unseen_recommendations(current_links: Dictionary) -> Array:
	var recent_links: Dictionary = {}
	for link in _recent_recommendation_links:
		recent_links[link] = true
	var candidates: Array = []
	for video in _recommendation_pool:
		var link := str(video.get(\"link\", video.get(\"bvid\", video.get(\"BV\", \"\"))))
		if link.is_empty() or current_links.has(link) or recent_links.has(link):
			continue
		candidates.append(video)
	return candidates


func _clear_recommendation_cards() -> void:
	for child in favorites_grid_container.get_children():
		child.queue_free()


func _queue_recommendation_search_jobs(initial_load: bool, generation: int) -> bool:
	if _recommendation_fetching or _recommendation_pool.size() >= MAX_RECOMMENDATION_POOL:
		return false

	_recommendation_jobs.clear()
	_recommendation_job_index = 0
	for author in _recommendation_authors:
		var pages: Array[int] = []
		if initial_load:
			for page in range(1, INITIAL_RECOMMENDATION_PAGES_PER_UP + 1):
				pages.append(page)
		else:
			var available_pages: Array[int] = []
			var used_pages: Dictionary = _recommendation_seen_pages.get(author, {})
			for page in range(1, MAX_SEARCH_PAGES_PER_UP + 1):
				if not used_pages.has(page):
					available_pages.append(page)
			available_pages.shuffle()
			for index in mini(REFILL_RECOMMENDATION_PAGES_PER_UP, available_pages.size()):
				pages.append(available_pages[index])

		for page in pages:
			var used_pages: Dictionary = _recommendation_seen_pages.get(author, {})
			used_pages[page] = true
			_recommendation_seen_pages[author] = used_pages
			_recommendation_jobs.append({\"author\": author, \"page\": page})

	if _recommendation_jobs.is_empty():
		return false

	_recommendation_fetching = true
	recommendation_status.text = tr(\"正在从收藏的 UP 主中寻找视频…\")
	_show_recommendation_loading()
	_run_recommendation_search_job(generation)
	return true


func _run_recommendation_search_job(generation: int) -> void:
	if generation != _recommendation_generation or not is_inside_tree():
		return
	if _recommendation_job_index >= _recommendation_jobs.size() or _recommendation_pool.size() >= MAX_RECOMMENDATION_POOL:
		_finish_recommendation_search(generation)
		return

	var job: Dictionary = _recommendation_jobs[_recommendation_job_index]
	BilibiliApi.search_bilibili(
		_on_recommendation_search_completed.bind(generation),
		job.author,
		20,
		0,
		job.page,
		job.author
	)


func _on_recommendation_search_completed(videos: Variant, generation: int) -> void:
	if generation != _recommendation_generation or not is_inside_tree():
		return
	if videos is Array:
		for video in videos:
			if not video is Dictionary:
				continue
			var link := str(video.get(\"link\", video.get(\"bvid\", video.get(\"BV\", \"\")))).strip_edges()
			if link.is_empty() or _recommendation_seen_links.has(link):
				continue
			_recommendation_seen_links[link] = true
			video[\"is_network\"] = true
			_recommendation_pool.append(video)
			if _recommendation_pool.size() >= MAX_RECOMMENDATION_POOL:
				break
	_recommendation_job_index += 1
	_run_recommendation_search_job(generation)


func _finish_recommendation_search(generation: int) -> void:
	if generation != _recommendation_generation or not is_inside_tree():
		return
	_recommendation_fetching = false
	_hide_recommendation_loading()
	if _recommendation_pool.is_empty():
		recommendation_status.text = tr(\"暂时没有找到这些 UP 主的相关视频\")
		return
	_shuffle_favorite_recommendations(false)


func _show_recommendation_loading() -> void:
	if _recommendation_loading_tween and _recommendation_loading_tween.is_running():
		_recommendation_loading_tween.kill()
	recommendation_loading.show()
	recommendation_loading.modulate.a = 0.0
	var sprite: AnimatedSprite2D = recommendation_loading.get_node(\"AnimatedSprite2D\")
	sprite.play(\"gif\")
	_recommendation_loading_tween = create_tween()
	_recommendation_loading_tween.tween_property(recommendation_loading, \"modulate:a\", 1.0, 0.2)


func _hide_recommendation_loading() -> void:
	if _recommendation_loading_tween and _recommendation_loading_tween.is_running():
		_recommendation_loading_tween.kill()
	_recommendation_loading_tween = create_tween()
	_recommendation_loading_tween.tween_property(recommendation_loading, \"modulate:a\", 0.0, 0.2)
	_recommendation_loading_tween.tween_callback(func():
		recommendation_loading.hide()
		_recommendation_loading_tween = null
	)


func _create_recommended_video_card(video: Dictionary) -> void:
	var video_card: Control = preload(\"res://Scene/VideoCard.tscn\").instantiate()
	favorites_grid_container.add_child(video_card)
	GdScriptFunc.apply_theme_and_styles_to_node(video_card)
	video_card.video_info = video
	video_card.title = video.get(\"title\", \"\")
	video_card.author = video.get(\"author\", \"\")
	video_card.description = video.get(\"description\", \"\")
	video_card.link = str(video.get(\"link\", video.get(\"bvid\", video.get(\"BV\", \"\"))))
	video_card.custom_minimum_size = Vector2(RECOMMENDATION_CARD_WIDTH, 364.0)
	video_card.reset()
	BilibiliApi.fetch_cover(video_card.link, set_cover.bind(video_card), 583, 364)
	video_card.gui_input.connect(_on_video_card_gui_input.bind(video_card, video))


func _set_cover(texture: Texture2D, video_card: Control) -> void:
	set_cover(\"\", texture, video_card)


func set_cover(_bvid: String, texture: Texture2D, video_card: Control) -> void:
	if is_instance_valid(video_card):
		video_card.cover = texture


func _build_edit_ui() -> void:
	_hint_label = Label.new()
	_hint_label.text = tr(\"松手删除该 UP 主\")
	_hint_label.add_theme_font_size_override(\"font_size\", 32)
	_hint_label.add_theme_color_override(\"font_color\", Color(1, 0.35, 0.35))
	_hint_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_hint_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_hint_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	_hint_label.z_index = 100
	_hint_label.visible = false
	add_child(_hint_label)
	GdScriptFunc.apply_theme_and_styles_to_node(_hint_label)

	_insert_line = ColorRect.new()
	_insert_line.color = Color(0.3, 0.7, 1.0, 0.9)
	_insert_line.z_index = 100
	_insert_line.visible = false
	add_child(_insert_line)


func _on_up_node_gui_input(event: InputEvent, node: Control) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				_press_node = node
				_press_pos = event.global_position
			else:
				_press_node = null
		elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
			_show_up_menu(node)
	elif event is InputEventMouseMotion:
		if (
			_press_node == node
			and not _dragging
			and event.button_mask & MOUSE_BUTTON_MASK_LEFT
			and event.global_position.distance_to(_press_pos) > DRAG_THRESHOLD
		):
			_start_drag()


func _start_drag() -> void:
	_dragging = true
	_suppress_next_click = true
	_press_node.modulate.a = 0.45
	_drag_preview = _make_drag_preview(_press_node)
	add_child(_drag_preview)


func _make_drag_preview(node: Control) -> Control:
	var preview := Label.new()
	preview.text = node.text if node.text != \"\" else _up_mid(node)
	preview.add_theme_font_size_override(\"font_size\", 28)
	preview.add_theme_color_override(\"font_outline_color\", Color(0, 0, 0, 0.8))
	preview.add_theme_constant_override(\"outline_size\", 8)
	preview.z_index = 101
	return preview


func _input(event: InputEvent) -> void:
	if not _dragging:
		return
	if (
		event is InputEventMouseButton
		and (event.button_index == MOUSE_BUTTON_WHEEL_DOWN or event.button_index == MOUSE_BUTTON_WHEEL_UP)
	):
		get_viewport().set_input_as_handled()
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
		_finish_drag()
		get_viewport().set_input_as_handled()
		return
	if event is InputEventMouseMotion:
		scroll_container.scroll_vertical += int(event.relative.y)


func _process(_delta: float) -> void:
	if not _dragging:
		return
	if is_instance_valid(_drag_preview):
		_drag_preview.global_position = get_global_mouse_position() + Vector2(14, 14)
	_update_drag_hint()
	if not Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		_finish_drag()


func _update_drag_hint() -> void:
	var mouse := get_global_mouse_position()
	var in_list := list_box.get_global_rect().has_point(mouse)
	_hint_label.visible = not in_list
	if in_list:
		_insert_line.visible = true
		_position_insert_line(_calc_insert_index(mouse.y))
	else:
		_insert_line.visible = false


func _finish_drag() -> void:
	if not _dragging:
		return
	_dragging = false
	var node := _press_node
	_press_node = null
	if is_instance_valid(_drag_preview):
		_drag_preview.queue_free()
	_drag_preview = null
	_hint_label.visible = false
	_insert_line.visible = false
	if not is_instance_valid(node):
		return
	node.modulate.a = 1.0
	var mouse := get_global_mouse_position()
	if list_box.get_global_rect().has_point(mouse):
		_move_up_node(node, _calc_insert_index(mouse.y))
	else:
		var shown_name: String = node.text if node.text != \"\" else _up_mid(node)
		_remove_up(node)
		GdScriptFunc.show_toast(tr(\"已删除：\") + shown_name)


func _calc_insert_index(global_y: float) -> int:
	for i in up_nodes.size():
		var rect := up_nodes[i].get_global_rect()
		if global_y < rect.position.y + rect.size.y * 0.5:
			return i
	return up_nodes.size()


func _position_insert_line(idx: int) -> void:
	var y: float
	if idx < up_nodes.size():
		y = up_nodes[idx].get_global_rect().position.y
	elif not up_nodes.is_empty():
		y = up_nodes[up_nodes.size() - 1].get_global_rect().end.y
	else:
		y = list_box.get_global_rect().position.y
	_insert_line.global_position = Vector2(list_box.global_position.x, y - 2.0)
	_insert_line.size = Vector2(list_box.size.x, 4.0)


func _apply_order() -> void:
	for i in up_nodes.size():
		list_box.move_child(up_nodes[i], i + 1)


func _move_up_node(node: Control, target_idx: int) -> void:
	var from_idx := up_nodes.find(node)
	if from_idx == -1:
		return
	target_idx = clampi(target_idx, 0, up_nodes.size() - 1)
	if target_idx == from_idx:
		return
	up_nodes.remove_at(from_idx)
	up_nodes.insert(target_idx, node)
	_apply_order()
	_save_ups()
	up_preview_visible_id = 0
	on_list_rolling()


func _remove_up(node: Control) -> void:
	var idx := up_nodes.find(node)
	if idx == -1:
		return
	up_nodes.remove_at(idx)
	if idx < up_preview_visible_id:
		up_preview_visible_id -= 1
	node.queue_free()
	_save_ups()


func _add_up(mid: String) -> void:
	for node in up_nodes:
		if _up_mid(node) == mid:
			GdScriptFunc.show_toast(tr(\"该 UP 主已在列表中\"))
			return
	ups.append(mid)
	_setup_up_node(mid)
	_apply_order()
	_save_ups()


func _replace_up(old_mid: String, new_mid: String) -> void:
	var idx := -1
	for i in up_nodes.size():
		if _up_mid(up_nodes[i]) == old_mid:
			idx = i
			break
	if idx == -1:
		return
	up_nodes[idx].queue_free()
	up_nodes.remove_at(idx)
	ups[idx] = new_mid
	var new_node := _setup_up_node(new_mid)
	up_nodes.remove_at(up_nodes.size() - 1)
	up_nodes.insert(idx, new_node)
	_apply_order()
	_save_ups()


func _prompt_up_dialog(prefill := \"\") -> void:
	var is_new := prefill.is_empty()
	var dialog := AcceptDialog.new()
	dialog.title = tr(\"添加 UP 主\") if is_new else tr(\"编辑 UP 主\")
	var line_edit := LineEdit.new()
	line_edit.text = prefill
	line_edit.placeholder_text = tr(\"输入 UID / MID（如 946974），或 bilibili音乐周榜\")
	line_edit.custom_minimum_size = Vector2(420, 40)
	dialog.add_child(line_edit)
	add_child(dialog)
	GdScriptFunc.apply_theme_and_styles_to_node(dialog)
	dialog.confirmed.connect(func():
		var mid := line_edit.text.strip_edges().trim_prefix(\"UID:\").trim_prefix(\"uid:\").trim_prefix(\"空间:\")
		if mid.is_empty():
			dialog.queue_free()
			return
		if is_new:
			_add_up(mid)
		else:
			_replace_up(prefill, mid)
		dialog.queue_free()
	)
	dialog.popup_centered()


func _show_up_menu(node: Control) -> void:
	var menu: Array[Dictionary] = [
		{\"label\": tr(\"编辑\"), \"action\": func(_d): _prompt_up_dialog(_up_mid(node)), \"enabled\": true},
		{\"label\": tr(\"删除\"), \"action\": func(_d): _remove_up(node), \"enabled\": true},
		{\"label\": tr(\"上移\"), \"action\": func(_d): _move_up_node(node, up_nodes.find(node) - 1), \"enabled\": true},
		{\"label\": tr(\"下移\"), \"action\": func(_d): _move_up_node(node, up_nodes.find(node) + 1), \"enabled\": true},
	]
	GdScriptFunc.open_right_click_menu_window(DisplayServer.mouse_get_position(), menu)


func _save_ups() -> void:
	ups.clear()
	for node in up_nodes:
		ups.append(_up_mid(node))
	GdScriptFunc.set_data(\"DiscoverPage\", \"ups\", Array(ups))
	GdScriptFunc.flush()


func _on_scroll_container_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if (event.button_index == MOUSE_BUTTON_WHEEL_DOWN or event.button_index == MOUSE_BUTTON_WHEEL_UP) and is_on_vertical_scroll:
			is_vertical_sliding = true
			time_cd.start()
	if event is InputEventMouseMotion and time_cd.is_stopped():
		is_vertical_sliding = false
		time_cd.stop()


func _on_cd_timer_timeout() -> void:
	is_vertical_sliding = false


func _on_scroll_container_mouse_entered() -> void:
	is_on_vertical_scroll = true


func _on_scroll_container_mouse_exited() -> void:
	is_on_vertical_scroll = false
"

[sub_resource type="GDScript" id="GDScript_6vwaf"]
script/source = "extends VBoxContainer

signal transform_changed
func _ready() -> void:
	set_notify_transform(true)#用来监听位置信息,从而计算可见的up预览区域,这样就能按需求加载
func _notification(what):
	if what == NOTIFICATION_TRANSFORM_CHANGED:
		transform_changed.emit()
"

