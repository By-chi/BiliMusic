[sub_resource type="GDScript" id="GDScript_00ea4"]
script/source = "## 管理音乐元数据:编辑标题/上传者/描述,封面与 BV 管理
## issue#功能完善:补齐缺失处理器/自定义封面/复制/打开目录/未保存提醒

extends Window
@export var cover_texture_rect: TextureRect
@export var title_line_edit: LineEdit
@export var author_line_edit: LineEdit
@export var link_line_edit: LineEdit
@export var description_line_edit: TextEdit
@export var bv_label: Label
@export var bv_row: HBoxContainer
@export var type_label: Label
@export var cover_download_button: Button
@export var cover_pick_button: Button
@export var cover_reset_button: Button
@export var audio_download_button: Button
@export var description_download_button: Button
@export var copy_link_button: Button
@export var copy_bv_button: Button
@export var open_folder_button: Button
@export var confirm_dialog: ConfirmationDialog

var bv := \"\"                     # 用户无法修改，单项下载时要用到
var directory_name := \"\"
var is_network := true
var previous_link := \"\"
var _dirty := false

func update(_directory_name: String, link: String) -> void:
	var deck: Array = GdScriptFunc.get_data(\"Favorites\", _directory_name, [])
	for i in deck:
		if str(i.get(\"link\", \"\")) == link:
			bv = str(i.get(\"BV\", \"\"))
			is_network = bool(i.get(\"is_network\", true))
			directory_name = _directory_name
			previous_link = link
			title_line_edit.text = str(i.get(\"title\", \"\"))
			author_line_edit.text = str(i.get(\"author\", \"\"))
			description_line_edit.text = str(i.get(\"description\", \"\"))
			link_line_edit.text = link
			bv_label.text = bv
			_dirty = false
			_refresh_field_states()
			_load_cover_for_link(link)
			return
	push_error(\"[MetadataWindow] 未找到条目: \" + link)
	queue_free()

## 根据当前数据刷新按钮可用性与只读状态
func _refresh_field_states() -> void:
	type_label.text = tr(\"网络音频\") if is_network else tr(\"本地音频\")
	var has_bv := not bv.is_empty()
	bv_row.visible = has_bv
	var link := link_line_edit.text
	var local_file_exists := not link.is_empty() and FileAccess.file_exists(link)
	# 网络条目无本地文件:封面走 BilibiliCoverCache,sidecar 无意义
	var cover_sidecar_ok := (not is_network) and local_file_exists
	cover_pick_button.disabled = not cover_sidecar_ok
	cover_reset_button.disabled = not cover_sidecar_ok
	# B站封面下载需要 BV,且保存到音频文件旁(须已下载)
	cover_download_button.disabled = not (has_bv and local_file_exists)
	audio_download_button.disabled = not has_bv
	description_download_button.disabled = not has_bv
	copy_link_button.disabled = link.is_empty()
	copy_bv_button.disabled = not has_bv
	open_folder_button.visible = local_file_exists

func _cover_path_for(link: String) -> String:
	if link.is_empty():
		return \"\"
	return link.get_basename() + \".jpg\"

func _load_cover_for_link(link: String) -> void:
	var cover_path := _cover_path_for(link)
	if not cover_path.is_empty() and FileAccess.file_exists(cover_path):
		var img := Image.new()
		if img.load(cover_path) == OK:
			cover_texture_rect.texture = ImageTexture.create_from_image(img)
			return
	cover_texture_rect.texture = null

func _set_dirty() -> void:
	_dirty = true

# ---------- 编辑框信号 ----------

func _on_title_text_submitted(_new_text: String) -> void:
	title_line_edit.release_focus()

func _on_author_text_submitted(_new_text: String) -> void:
	author_line_edit.release_focus()

func _on_link_text_submitted(_new_text: String) -> void:
	link_line_edit.release_focus()
	_refresh_field_states()

func _on_description_text_changed() -> void:
	_set_dirty()

# ---------- 复制/打开目录 ----------

func _on_copy_link_pressed() -> void:
	DisplayServer.clipboard_set(link_line_edit.text)

func _on_copy_bv_pressed() -> void:
	DisplayServer.clipboard_set(bv)

func _on_open_folder_pressed() -> void:
	var link := link_line_edit.text
	if link.is_empty():
		return
	OS.shell_show_in_file_manager(ProjectSettings.globalize_path(link))

# ---------- 封面 ----------

func _on_cover_pick_pressed() -> void:
	var dialog := FileDialog.new()
	dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	dialog.access = FileDialog.ACCESS_FILESYSTEM
	dialog.filters = PackedStringArray([\"*.png ; PNG 图像\", \"*.jpg ; JPEG 图像\", \"*.jpeg ; JPEG 图像\", \"*.webp ; WebP 图像\"])
	dialog.use_native_dialog = true
	add_child(dialog)
	dialog.canceled.connect(dialog.queue_free)
	dialog.file_selected.connect(func(path: String):
		dialog.queue_free()
		var img := Image.load_from_file(path)
		if img == null:
			GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"无法读取所选图片\"))
			return
		var cover_path := _cover_path_for(link_line_edit.text)
		if cover_path.is_empty():
			return
		var err := img.save_jpg(cover_path)
		if err == OK:
			_load_cover_for_link(link_line_edit.text)
			GdScriptFunc.set_progress_bar_value(100, tr(\"完成\"), tr(\"封面已更新\"))
		else:
			GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"封面保存失败\"))
	)
	dialog.popup_centered(Vector2i(900, 600))

func _on_cover_reset_pressed() -> void:
	var cover_path := _cover_path_for(link_line_edit.text)
	if cover_path.is_empty() or not FileAccess.file_exists(cover_path):
		return
	DirAccess.remove_absolute(ProjectSettings.globalize_path(cover_path))
	_load_cover_for_link(link_line_edit.text)

func _on_cover_download_pressed() -> void:
	if bv.is_empty():
		return
	var link := link_line_edit.text
	if link.is_empty() or not FileAccess.file_exists(link):
		GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"请先下载音频再下载封面\"))
		return
	var cover_path := _cover_path_for(link)
	GdScriptFunc.set_progress_bar_value(10, tr(\"封面下载\"), tr(\"正在获取封面...\"))
	BilibiliApi.fetch_cover(bv, func(_bvid, texture: Texture2D):
		if texture:
			var img = texture.get_image()
			GdScriptFunc.set_progress_bar_value(50, tr(\"封面下载\"), tr(\"正在保存封面...\"))
			var err = img.save_jpg(cover_path)
			if err == OK:
				cover_texture_rect.texture = texture
				GdScriptFunc.set_progress_bar_value(100, tr(\"完成\"), tr(\"封面已更新\"))
			else:
				GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"封面保存失败\"))
		else:
			GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"封面获取失败\"))
	, 1280, 720)

# ---------- 下载功能 ----------

func _on_link_download_pressed() -> void:
	if bv.is_empty():
		return
	var old_link := link_line_edit.text
	var old_cover_path := _cover_path_for(old_link)
	var old_lrc_path := old_link.get_basename() + \".lrc\" if not old_link.is_empty() else \"\"

	GdScriptFunc.set_progress_bar_value(10, tr(\"音频下载\"), tr(\"正在获取音频信息...\"))
	_download_audio_async(bv, func(audio_result: Dictionary):
		if audio_result.is_empty():
			GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"音频下载失败\"))
			return

		var new_link: String = audio_result[\"local_path\"]
		link_line_edit.text = new_link
		previous_link = new_link
		is_network = false
		_refresh_field_states()

		var deck: Array = GdScriptFunc.get_data(\"Favorites\", directory_name, [])
		for item in deck:
			if str(item.get(\"BV\", \"\")) == bv or str(item.get(\"link\", \"\")) == old_link:
				item[\"link\"] = new_link
				item[\"is_network\"] = false
				GdScriptFunc.set_data(\"Favorites\", directory_name, deck)
				break

		if not old_cover_path.is_empty() and FileAccess.file_exists(old_cover_path):
			GdScriptFunc.set_progress_bar_value(60, tr(\"音频下载\"), tr(\"正在迁移封面...\"))
			DirAccess.copy_absolute(old_cover_path, _cover_path_for(new_link))
			_load_cover_for_link(new_link)

		if not old_lrc_path.is_empty() and FileAccess.file_exists(old_lrc_path):
			GdScriptFunc.set_progress_bar_value(80, tr(\"音频下载\"), tr(\"正在迁移字幕...\"))
			var new_lrc_path: String = new_link.get_basename() + \".lrc\"
			DirAccess.copy_absolute(old_lrc_path, new_lrc_path)
			for item in deck:
				if str(item.get(\"link\", \"\")) == new_link and item.has(\"subtitles\"):
					item[\"subtitles\"][\"path\"] = new_lrc_path
					GdScriptFunc.set_data(\"Favorites\", directory_name, deck)
					break

		GdScriptFunc.set_progress_bar_value(100, tr(\"完成\"), tr(\"音频已更新\"))
		# 链接下载已即时写入配置,不需要再经过确定保存
		_dirty = false
	)

func _on_description_download_pressed() -> void:
	if bv.is_empty():
		return
	GdScriptFunc.set_progress_bar_value(10, tr(\"获取信息\"), tr(\"正在获取描述...\"))
	BilibiliApi.fetch_video_info(bv, func(info: Dictionary):
		if info.is_empty():
			GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"获取信息失败\"))
			return
		description_line_edit.text = str(info.get(\"desc\", \"\"))
		_set_dirty()
		GdScriptFunc.set_progress_bar_value(100, tr(\"完成\"), tr(\"描述已更新\"))
	)

# ---------- 异步音频下载（局部实现，与主界面一致）----------
const TARGET_DIR := \"user://local_music/\"

func _download_audio_async(bvid: String, callback: Callable) -> void:
	GdScriptFunc.set_progress_bar_value(30, tr(\"音频下载\"), tr(\"正在下载音频文件...\"))

	var thread := Thread.new()
	var result := {
		\"success\": false,
		\"local_path\": \"\",
		\"hash\": \"\"
	}

	thread.start(func():
		var info_dict = DownloadAudio.GetAudioInfoByBvSync(bvid)
		if info_dict == null or info_dict.get(\"audioUrl\", \"\").is_empty():
			return result

		var audio_url = info_dict[\"audioUrl\"]
		var referer = info_dict[\"referer\"]

		var temp_path = DownloadAudio.DownloadAudioSync(audio_url, referer)
		if temp_path == \"\" or not FileAccess.file_exists(temp_path):
			return result

		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(TARGET_DIR))

		var src := FileAccess.open(temp_path, FileAccess.READ)
		if src == null:
			return result

		var ctx := HashingContext.new()
		ctx.start(HashingContext.HASH_SHA256)
		while src.get_position() < src.get_length():
			ctx.update(src.get_buffer(4096))
		var file_hash := ctx.finish().hex_encode()
		src.close()

		var ext = temp_path.get_extension()
		var dst_filename = file_hash + \".\" + ext if not ext.is_empty() else file_hash
		var dst_path := TARGET_DIR.path_join(dst_filename)

		if not FileAccess.file_exists(dst_path):
			var err := DirAccess.copy_absolute(temp_path, dst_path)
			if err != OK:
				DirAccess.remove_absolute(temp_path)
				return result

		DirAccess.remove_absolute(temp_path)

		result[\"success\"] = true
		result[\"local_path\"] = dst_path
		result[\"hash\"] = file_hash
		return result
	)

	var check_timer := Timer.new()
	check_timer.wait_time = 0.05
	check_timer.one_shot = false
	add_child(check_timer)
	check_timer.timeout.connect(func():
		if not thread.is_alive():
			var res = thread.wait_to_finish()
			check_timer.queue_free()
			GdScriptFunc.set_progress_bar_value(50, tr(\"音频下载\"), tr(\"音频文件处理完成\"))
			callback.call(res)
	)
	check_timer.start()

# ---------- 保存/关闭 ----------

func _save_changes() -> bool:
	var deck: Array = GdScriptFunc.get_data(\"Favorites\", directory_name, [])
	for i in deck:
		if str(i.get(\"link\", \"\")) == previous_link:
			i[\"title\"] = title_line_edit.text
			i[\"author\"] = author_line_edit.text
			i[\"link\"] = link_line_edit.text
			i[\"description\"] = description_line_edit.text
			GdScriptFunc.set_data(\"Favorites\", directory_name, deck)
			return true
	GdScriptFunc.set_progress_bar_value(100, tr(\"失败\"), tr(\"未找到对应收藏条目，无法保存\"))
	return false

func _on_ok_pressed() -> void:
	if not _save_changes():
		return
	queue_free()

func _on_cancel_pressed() -> void:
	queue_free()

func _on_close_requested() -> void:
	if _dirty:
		confirm_dialog.popup_centered()
	else:
		queue_free()

func _on_confirm_dialog_confirmed() -> void:
	if _save_changes():
		queue_free()

func _on_confirm_dialog_canceled() -> void:
	queue_free()
"

