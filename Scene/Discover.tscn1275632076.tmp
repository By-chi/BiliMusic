[gd_scene format=3 uid="uid://h8qr8p6khg63"]

[sub_resource type="GDScript" id="GDScript_61i7r"]
script/source = "extends Control
@export var list:VBoxContainer
@export var scroll_container:ScrollContainer
var up_nodes:Array[Label]
@export var ups: Array[Dictionary] = []
var up_preview_visible_id:=0
func on_list_rolling()->void:
	var bottom:=-list.position.y+scroll_container.size.y
	if bottom>=169+up_preview_visible_id*350:
		if up_preview_visible_id<up_nodes.size():
			BilibiliIc.search_bilibili(
					load_cards_callback.bind(up_nodes[up_preview_visible_id].get_node(\"ScrollContainer/HBoxContainer\")),
					up_nodes[up_preview_visible_id].text, 10, 0, 1, up_nodes[up_preview_visible_id].text
				)
		up_preview_visible_id+=1
func _ready() -> void:
	for item in ups:
		var key: String = item[\"key\"]
		var color: Color = item[\"value\"]
		var node := preload(\"res://Scene/UpPpreview.tscn\").instantiate()
		node.name = key
		node.text = key
		node.self_modulate = color
		up_nodes.append(node)
		list.add_child(node)
	list.transform_changed.connect(on_list_rolling)
	on_list_rolling()
func load_cards_callback(videos:Array,list_node:BoxContainer)->void:
	for video in videos:
		await get_tree().create_timer(0.12).timeout
		var video_card:BaseVideoCard=preload(\"res://Scene/VideoCard.tscn\").instantiate()
		list_node.add_child(video_card)
		video_card.title=video.title
		video_card.author=video.author
		video_card.description=video.description
		video_card.link=video.bvid
		if video.has(\"cover_url\"):
			BilibiliIc._download_cover(video.cover_url,video.bvid,set_cover.bind(video_card))
		else:
			BilibiliIc.fetch_cover(video.bvid,set_cover.bind(video_card))
func set_cover(_bvid:String, texture:Texture2D,video_card:Control)->void:
	video_card.cover=texture
@export var time_cd:Timer
var is_vertical_sliding:=false:
	set(value):
		if value==is_vertical_sliding:
			return
		is_vertical_sliding=value
		for node in up_nodes:
			if value:
				node.get_child(0).mouse_filter=MouseFilter.MOUSE_FILTER_IGNORE
			else:
				node.get_child(0).mouse_filter=MouseFilter.MOUSE_FILTER_STOP
func _on_scroll_container_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if (event.button_index==MOUSE_BUTTON_WHEEL_DOWN||event.button_index==MOUSE_BUTTON_WHEEL_UP) \\
		&&is_on_vertical_scroll:
			is_vertical_sliding=true
			time_cd.start()
	if event is InputEventMouseMotion&&time_cd.is_stopped():
		is_vertical_sliding=false
		time_cd.stop()

func _on_cd_timer_timeout() -> void:
	is_vertical_sliding=false

var is_on_vertical_scroll:=false
func _on_scroll_container_mouse_entered() -> void:
	is_on_vertical_scroll=true
func _on_scroll_container_mouse_exited() -> void:
	is_on_vertical_scroll=false
"

[sub_resource type="GDScript" id="GDScript_6vwaf"]
script/source = "extends VBoxContainer

signal transform_changed
func _ready() -> void:
	set_notify_transform(true)#用来监听位置信息,从而计算可见的up预览区域,这样就能按需求加载
func _notification(what):
	if what == NOTIFICATION_TRANSFORM_CHANGED:
		transform_changed.emit()
"

